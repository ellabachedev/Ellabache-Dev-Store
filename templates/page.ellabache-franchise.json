    "franchise-cta1": {
      "type": "franchise-cta1",
      "settings": {
        "block_switch": true,
        "block_bg_color": "#ffffff",
        "block_tag": "Own Your Own Salon: Confidence in Your Own Skin",
        "block_title_font-size": 34,
        "block_title": "When you join our family, you’re joining a premium network with products and services available in over 120 salons and 39 David Jones stores Australia-wide.",
        "block_desc": "<p>Staying <strong>competitive</strong> and at the <strong>cutting edge</strong> in the beauty industry requires dedicated individuals who drive innovation. You don’t need to be a <strong>qualified beauty therapist</strong> to own your own salon. All you need is a <strong>passion for skincare</strong> and the desire to help others understand and feel confident in their own skin.</p>\n<p>Are you ready to <strong>create your vibrant new lifestyle</strong> while reducing your ongoing costs? Join our family and take advantage of <strong>our unique royalty-free model</strong>, designed to help you save and grow your business. This option allows you to focus on what truly matters—building your dream while maintaining financial flexibility.</p>\n<p>Take the first step towards a successful and <strong>affordable business model</strong> with our support and expertise. Let’s build something amazing together!</p>",
        "block_video_switch": false,
        "block_video": "",
        "block_image_switch": true,
        "block_image": "shopify://shop_images/101270471_590930288227607_6031268448990248075_n.jpg",
        "block_image_caption": "Ella Baché Wollongong",
        "block_image_link": "#franchiseEnquiry"
      }
    },
    "franchise-grid-col-content": {
      "type": "franchise-grid-col-content",
      "blocks": {
        "c7c7dfd1-b9dd-43ca-8ad5-68441b5f1777": {
          "type": "Article",
          "settings": {
            "item_title": "Expert Training and Ongoing Support",
            "item_desc": "<p>When you partner with <strong>Ella Baché</strong>, you and your team will receive <strong>ongoing training</strong> and <strong>personalized support</strong> from a dedicated trainer. This ensures your salon stays at the forefront of <strong>service, technology</strong>, and <strong>innovation</strong> in the beauty industry.</p>\n<p>In addition to tailored support, you'll also attend <strong>annual workshops, product schools</strong>, and exclusive <strong>product launches</strong> to stay updated with the latest advancements in skincare and beauty treatments. With Ella Baché by your side, you'll be equipped with the knowledge and tools needed to offer exceptional services to your clients.</p>",
            "btn_text": "MAKE AN EQUIRY",
            "btn_url": "#franchiseEnquiry"
          }
        },
        "db65f856-a4e2-4ace-ba01-498b7f66b034": {
          "type": "Article",
          "settings": {
            "item_title": "Education: Access Graduates from Ella Baché College of Skin and Beauty",
            "item_desc": "<p>When it comes to staffing your salon, you’ll have exclusive access to <strong>graduates</strong> from the <strong>Ella Baché College of Skin and Beauty</strong>, one of the most highly respected <strong>education providers</strong> in Australia. This gives you the opportunity to hire highly trained professionals with the expertise to provide exceptional skincare and beauty services.</p>\n<p>By partnering with Ella Baché, you gain access to a pool of talented graduates who are well-versed in the latest industry techniques and trends, ensuring your salon maintains its competitive edge.</p>",
            "btn_text": "Ella Baché Careers",
            "btn_url": "shopify://pages/careers"
          }
        },
        "a92e9e84-4b3d-4c29-a539-6e96c494d07c": {
          "type": "Article",
          "settings": {
            "item_title": "Business Manager: Personalised Support for Salon Success",
            "item_desc": "<p>From day one, a dedicated <strong>Business Manager</strong> will be by your side, providing expert <strong>planning support</strong> and guidance to drive the success of your <strong>salon</strong> in your local area. With tailored advice and strategies, your Business Manager will help you navigate challenges, maximize growth, and ensure your salon thrives in a competitive market.</p>\n<p>Partnering with <strong>Ella Baché </strong>means having the support you need to grow and succeed at every step of your journey.</p>",
            "btn_text": "Make it Happen",
            "btn_url": "#franchiseEnquiry"
          }
        },
        "f75c20e9-e281-4765-8acc-a7c6e5ab259c": {
          "type": "Article",
          "settings": {
            "item_title": "Virtual Salon Website: Enhance Your Online Presence",
            "item_desc": "<p>Your salon will receive a dedicated <strong>virtual salon website</strong>, fully supported by our <strong>Head Office team</strong>, where clients can easily browse your <strong>menu of services</strong>, view <strong>special offers</strong>, and book <strong>treatments online</strong>. This personalized micro-site ensures your salon has a strong <strong>online presence</strong>, making it convenient for clients to explore and schedule services at any time.</p>\n<p>\nWith a virtual salon website, you can streamline bookings and elevate the customer experience, all while increasing visibility and accessibility for your salon.</p>",
            "btn_text": "View Bondi Junction",
            "btn_url": "https://www.ellabache.com.au/pages/bondijunction"
          }
        },
        "42905e0f-89fa-49f0-88b1-f43e05a7d3e2": {
          "type": "Article",
          "settings": {
            "item_title": "National Marketing Support: Boost Your Salon's Visibility",
            "item_desc": "<p>When you partner with <strong>Ella Baché</strong>, you’ll receive comprehensive <strong>marketing support</strong> before and after your salon opening. Our team provides both <strong>national</strong> and <strong>local marketing initiatives</strong> to help increase your salon's visibility and attract clients.\n</p>\n<p>Additionally, you’ll have <strong>24-hour</strong> access to our online <strong>marketing portal</strong>, where you can easily access all your marketing assets whenever you need them. With our expert tools and resources, you’ll be equipped to drive success and grow your salon’s brand presence.</p>",
            "btn_text": "Request Prospectus",
            "btn_url": "#franchiseEnquiry"
          }
        },
        "b2b336e9-5138-4170-914e-fb1603155743": {
          "type": "Article",
          "settings": {
            "item_title": "Proudly 100% Australian Owned",
            "item_desc": "<p>Ella Baché has been proudly <strong>100% Australian owned </strong>for over 70 years. Since launching in Australia, we’ve grown to become the largest market for <strong>Ella Baché products</strong>, and we remain committed to supporting local communities and the Australian economy.</p>\n<p>Our dedication to excellence and innovation ensures that our products continue to meet the highest standards, offering skincare solutions trusted by Australians for generations.</p>",
            "btn_text": "Salons for Sale",
            "btn_url": "https://www.ellabache.com.au/pages/salons-for-sale"
          }
        }
      },
