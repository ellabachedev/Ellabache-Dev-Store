    "franchise-cta2": {
      "type": "franchise-cta2",
      "blocks": {
        "152df31d-cb7d-481a-96f0-dc4535439a12": {
          "type": "Article",
          "settings": {
            "item_thumb": "shopify://shop_images/IN_MY_OWN_SKIN.png",
            "item_title": "Our Philosophy: Empowering Confidence with Expert Skincare Solutions",
            "item_desc": "<p>At <strong>Ella Baché</strong>, we are committed to helping women feel confident in their skin. Our mission is to empower individuals to step out in confidence, providing expert <strong>personalized skincare solutions</strong> that deliver <strong>maximum results</strong>—without causing harm.</p>\n<p>With over <strong>70 years of experience</strong> in the skincare industry, we are dedicated to offering <strong>safe and effective products</strong> tailored to meet each person’s unique skin needs. Whether you're looking to brighten, hydrate, or rejuvenate, our products are designed to give you the healthy, glowing skin you deserve.</p>",
            "item_btn_text": "Learn More",
            "item_btn_url": "shopify://pages/franchise-our-story"
          }
        }
      },
