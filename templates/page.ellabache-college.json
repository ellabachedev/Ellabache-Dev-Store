    "college-cta4": {
      "type": "college-cta4",
      "blocks": {
        "e503dd6e-3204-40d2-9484-5291f5b236c0": {
          "type": "accordion_content",
          "settings": {
            "accordion_item_switch": false,
            "accordion_item_Header": "Learn More about your study options",
            "accordion_item_content": "<!-- Table Content -->\n    <table width=\"100%\" border=\"none\" class=\"shogun-table custom\">\n      <thead class='shogun-table-column-container\"\"'>\n        <tr>\n          <td class=\"shogun-table-column\">Program<\/td>\n          <td class=\"shogun-table-column\">EdFlex™ Campus (Sydney)<\/td>\n          <td class=\"shogun-table-column\">EdFlex™ Blended<\/td>\n        <\/tr>\n      <\/thead>\n      <tbody>\n        <tr class=\"shogun-table-row-container\">\n          <td class=\"shogun-table-row\"><p><strong>Course length<\/strong><\/p><\/td>\n          <td class=\"text-center\"><p>12 months <small>(3 x 15 week terms plus breaks)<\/small><\/p><\/td>\n          <td class=\"text-center\"><p>15 months <small>(3 x 18 week terms plus breaks)<\/small><\/p><\/td>\n        <\/tr>\n        <tr class=\"shogun-table-row-container\">\n          <td class=\"shogun-table-row\"><p><strong>Flexible monthly start dates<\/strong><\/p><\/td>\n          <td class=\"text-center shogun-table-row\"><p>February - June - September<\/p><\/td>\n          <td class=\"text-center shogun-table-row\">\n            <div class=\"icon-holder\">\n              <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0119\/6028\/7313\/files\/foursquare-check-in.svg?v=1590110078\" alt=\"tick\">\n            <\/div>\n          <\/td>\n        <\/tr>\n        <tr class=\"shogun-table-row-container\">\n          <td class=\"shogun-table-row\"><p><strong>Dedicated Trainer support<\/strong><\/p><\/td>\n          <td class=\"text-center shogun-table-row\">\n            <div class=\"icon-holder\">\n              <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0119\/6028\/7313\/files\/foursquare-check-in.svg?v=1590110078\" alt=\"tick\">\n            <\/div>\n          <\/td>\n          <td class=\"text-center shogun-table-row\">\n            <div class=\"icon-holder\">\n              <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0119\/6028\/7313\/files\/foursquare-check-in.svg?v=1590110078\" alt=\"tick\">\n            <\/div>\n          <\/td>\n        <\/tr>\n        <tr class=\"shogun-table-row-container\">\n          <td class=\"shogun-table-row\"><p><strong>Study theory online<\/strong><\/p><\/td>\n          <td class=\"text-center shogun-table-row\">\n            <div class=\"icon-holder\">\n              <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0119\/6028\/7313\/files\/foursquare-check-in.svg?v=1590110078\" alt=\"tick\">\n            <\/div>\n          <\/td>\n          <td class=\"text-center shogun-table-row\">\n            <div class=\"icon-holder\">\n              <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0119\/6028\/7313\/files\/foursquare-check-in.svg?v=1590110078\" alt=\"tick\">\n            <\/div>\n          <\/td>\n        <\/tr>\n        <tr class=\"shogun-table-row-container\">\n          <td class=\"shogun-table-row\"><p><strong>Attend on-campus<\/strong><\/p><\/td>\n          <td class=\"text-center shogun-table-row\"><p>2.5 days per week \/ per term<\/p><\/td>\n          <td class=\"text-center shogun-table-row\"><p>10 days per term minimum<small>(Minimum of 8 days practical and 2 days assessment per term. 30 days total for the course.)<\/small><\/p><\/td>\n        <\/tr>\n        <tr class=\"shogun-table-row-container\">\n          <td class=\"shogun-table-row\"><p><strong>Practical training & assessment<\/strong><\/p><\/td>\n          <td class=\"text-center shogun-table-row\"><p>On-campus <small>(During 2.5 days per week \/ per term)<\/small><\/p><\/td>\n          <td class=\"text-center shogun-table-row\"> \n              <p>- Supervised on-campus practical sessions (24 days minimum in course); and​<\/p>\n              <p>- Supervised on-campus assessment sessions (6 days minimum in course); and​<\/p>\n              <p>- Supervised training in student’s workplace if employed in a Beauty Salon; or​<\/p>\n              <p>- Unsupervised practice on family and friends; or​<\/p>\n              <p>- Supervised training during work placement\/experience.​<\/p>\n            <p>\n              <small>Note: Students are required to complete other assessments on top of the 2 days per term\/6 days total for course, on campus. These other assessments can be completed remotely or on campus. ​<\/small>\n            <\/p>\n            <p>\n              <small>Students completing assessments remotely will be required to have appropriate equipment, product and video conference hardware (PC with camera and microphone).​<\/small>\n            <\/p>\n            <p>\n              <small>The days are given as guidelines, some students will take more or less time​.<\/small>\n            <\/p>\n            <p><\/p>\n          <\/td>\n        <\/tr>\n        <tr class=\"shogun-table-row-container\">\n          <td class=\"shogun-table-row\"><p><strong>Campus training location(s)<\/strong><\/p><\/td>\n          <td class=\"text-center\"><p>Sydney<br><a href=\"https:\/\/www.ellabache.com.au\/pages\/locations\" target=\"_blank\">Learn more<\/a><\/p><\/td>\n          <td class=\"text-center\"><p>Sydney, Melbourne, Brisbane<br><a href=\"https:\/\/www.ellabache.com.au\/pages\/locations\" target=\"_blank\">Learn more<\/a><\/p><\/td>\n        <\/tr>\n        <tr class=\"shogun-table-row-container\">\n          <td class=\"shogun-table-row\"><p><strong>Ella Baché external work experience (150 hours)<\/strong><\/p><\/td>\n          <td class=\"text-center\">\n            <div class=\"icon-holder\">\n              <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0119\/6028\/7313\/files\/foursquare-check-in.svg?v=1590110078\" alt=\"tick\">\n            <\/div>\n          <\/td>\n          <td class=\"text-center shogun-table-row\">\n            <div class=\"icon-holder\">\n              <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0119\/6028\/7313\/files\/foursquare-check-in.svg?v=1590110078\" alt=\"tick\">\n            <\/div>\n          <\/td>\n        <\/tr>\n        <tr class=\"shogun-table-row-container\">\n          <td class=\"shogun-table-row\"><p><strong>Suitable for international students<\/strong><\/p><\/td>\n          <td class=\"text-center shogun-table-row\">\n            <div class=\"icon-holder\">\n              <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0119\/6028\/7313\/files\/foursquare-check-in.svg?v=1590110078\" alt=\"tick\">\n            <\/div>\n          <\/td>\n          <td class=\"text-center shogun-table-row\"> <\/td>\n        <\/tr>\n      <\/tbody>\n    <\/table>\n    <!-- Table Content -->"
          }
        }
      },
      "block_order": [
        "e503dd6e-3204-40d2-9484-5291f5b236c0"
      ],
      "settings": {
        "block_switch": true,
        "block_bg_color": "#ffffff",
        "block_title": "Your Study Options",
        "block_description": "<p>At Ella Baché College, we champion the individual by offering different study options to allow you to design the best learning experience for you. No matter which option you choose, you’ll learn both theory and practical knowledge as part of your SHB50121 Diploma of Beauty Therapy. You can access the My Ella Baché student learning portal to find your online theory components and learning materials while also attending practical training sessions in our student salon environment. You’ll be a part of a learning community of students and supported by our team of experienced trainers who will mentor you through part of your studies.<\/p>",
        "block_shogun_content": "<div class=\"shogun-2-col-grid\">\n      <div class=\"flex-container\">\n        <div class=\"col-item\">\n          <h3>EdFlex™ Campus (Sydney)<\/h3>\n          <p><strong>EdFlex™ Campus is for you if:<\/strong><\/p>\n          <div class=\"lists\">\n            <div class=\"item\">\n              <div class=\"icon-holder\">\n                <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0119\/6028\/7313\/files\/tick.svg?v=1590109719\" alt=\"tick\">\n              <\/div>\n              <p><strong>You prefer a structured learning environment<\/strong><\/p>\n              <p>A timetable of practical classes and tutorials over 2.5 days each week at our training rooms are supplemented with online theory studies.<\/p>\n            <\/div>\n            <div class=\"item\">\n              <div class=\"icon-holder\">\n                <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0119\/6028\/7313\/files\/tick.svg?v=1590109719\" alt=\"tick\">\n              <\/div>\n              <p><strong>You want an on-campus experience<\/strong><\/p>\n              <p>Conveniently located, our College training rooms are just a train ride from the city center and are easily accessible by car or bus.<\/p>\n            <\/div>\n          <\/div>\n        <\/div>\n        <div class=\"col-item\">\n          <h3>EdFlex™ Blended<\/h3>\n          <p><strong>EdFlex™ Blended is available Australia wide with practical training undertaken in Sydney, Melbourne or Brisbane:<\/strong><\/p>\n          <div class=\"lists\">\n            <div class=\"item\">\n              <div class=\"icon-holder\">\n                 <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0119\/6028\/7313\/files\/tick.svg?v=1590109719\" alt=\"tick\">\n              <\/div>\n              <p><strong>You prefer to do most of your study online and at your own pace<\/strong><\/p>\n            <\/div>\n            <div class=\"item\">\n              <div class=\"icon-holder\">\n                 <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0119\/6028\/7313\/files\/tick.svg?v=1590109719\" alt=\"tick\">\n              <\/div>\n              <p><strong>You want a custom blend of on-campus and online learning for your beauty therapy course<\/strong><\/p>\n            <\/div>\n            <div class=\"item\">\n              <div class=\"icon-holder\">\n                 <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0119\/6028\/7313\/files\/tick.svg?v=1590109719\" alt=\"tick\">\n              <\/div>\n              <p><strong>You have work or family commitments so need to design your own timetable that works for you<\/strong><\/p>\n            <\/div>\n            <div class=\"item\">\n              <div class=\"icon-holder\">\n                 <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0119\/6028\/7313\/files\/tick.svg?v=1590109719\" alt=\"tick\">\n              <\/div>\n              <p><strong>You want to supplement your learning with additional electives including practical training sessions<\/strong><\/p>\n            <\/div>\n            <div class=\"item\">\n              <div class=\"icon-holder\">\n                 <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0119\/6028\/7313\/files\/tick.svg?v=1590109719\" alt=\"tick\">\n              <\/div>\n              <p><strong>You need to fast-track your education<\/strong><\/p>\n              <p>With EdFlex™ Blended learning you can not only work at your own pace but also accelerate your learning and graduate sooner.<\/p>\n            <\/div>\n          <\/div>\n        <\/div>\n      <\/div>\n    <\/div>",
        "block_shogun_content_2": ""
      }
    },
