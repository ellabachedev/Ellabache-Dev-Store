          }
        },
        "043217b2-be3a-4ed6-abc9-66519d2761da": {
          "type": "Reviews",
          "settings": {
            "review": "I wouldn't want to learn anywhere else. I learnt so much from the Ella Baché Trainers who had a lot of knowledge to share. They really cared about your progress and wanted you to be the best you could be.",
            "author": "LAURA ADAMSON, ELLA BACHÉ COLLEGE ALUMNI"
          }
        },
        "eafbc6b9-cc58-46c1-a26d-b81651d5a601": {
          "type": "Reviews",
          "settings": {
            "review": "Once you step foot in the College you become a part of the Ella Baché brand and family. We work extremely hard behind the scenes for real outcomes, which means jobs and career opportunities for our students.",
            "author": "MEREDITH SCHAERF, ELLA BACHÉ COLLEGE EDUCATION MANAGER"
          }
        }
      },
