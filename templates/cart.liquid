  jQuery(document).ready(function($){
    $('#btnOpenMinicart').on('click', function(e){
      e.preventDefault();
      $('.cart-opener').trigger('click');
      console.log('MINI CART OPEN TRIGGERED');

      $('#cart-mini .mini-cart-footer .checkout-view input').each(function(){
      if( !$(this).is(":hidden") ){
        console.log($(this));
        console.log("Shown");
        $(this).trigger('click');
      }
      //console.log($(this));
      //console.log($(this).is(":hidden"));
    });
    });

  });
  
</script>
