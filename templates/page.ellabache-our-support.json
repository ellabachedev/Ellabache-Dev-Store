    "franchise-our-support-cta2": {
      "type": "franchise-our-support-cta2",
      "blocks": {
        "06f0e626-c708-4a45-a3e0-2e5510024a64": {
          "type": "Article",
          "settings": {
            "image_thumb_max-height": 350,
            "item_thumb": "shopify://shop_images/help-always-at-hand_ca1536b7-6360-4dd3-80d3-6675f1ec019e.jpg",
            "item_thumb_2": "shopify://shop_images/your-study-option-thumb_85b9dd6f-e3e6-4536-a25f-3359384a6dd7.jpg",
            "item_title": "Help always at hand",
            "item_desc": "<p>Your specially assigned Business Manager will:</p>\n<ul>\n<li>Provide in-salon business coaching prior to the salon opening and during the crucial first few weeks</li>\n<li>Help you with business planning by visiting you frequently during the first three months, and then provide continual support through monthly visits (or as needed)</li>\n<li>Work with you to undertake a comprehensive annual review to help you set your goals for the future</li>\n<li>Help you create and implement marketing plans for your opening along with our on-going monthly promotional calendar</li>\n<li>Detail and debrief salon staff on campaign strategies</li>\n<li>Organise in-salon sales training and promotional activities as needed</li>\n<li>Keep you informed of your stock transactions and progress</li>\n<li>Deal quickly and efficiently with your queries</li>\n<li>Assist in motivating and focusing the salon team to help them achieve retail/treatment targets each week/month</li>\n<li>Assist you to ensure your salon aligns with best practice within the network</li>\n<li>Help you to maintain high standards in customer service, presentation and practise standards with independent benchmarking</li>\n</ul>",
            "item_btn_text": "",
            "item_btn_url": ""
          }
        }
      },
