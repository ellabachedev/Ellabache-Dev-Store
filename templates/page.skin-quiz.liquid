                                          <div id="Serum_PM_under" data-handle="{{ page.metafields.accentuate.answer1_under40_serum_pm[index] }}" data-quantity class="product-meta answer_1_{{index}} noShow">{{ page.metafields.accentuate.answer1_under40_serum_pm[index] }}</div>
                                          <div id="Moisture_AM_under" data-handle="{{ page.metafields.accentuate.answer1_under40_moisture_am[index] }}" data-quantity class="product-meta answer_1_{{index}} noShow">{{ page.metafields.accentuate.answer1_under40_moisture_am[index] }}</div>
                                          <div id="Moisture_PM_under" data-handle="{{ page.metafields.accentuate.answer1_under40_moisture_pm[index] }}" data-quantity class="product-meta answer_1_{{index}} noShow">{{ page.metafields.accentuate.answer1_under40_moisture_pm[index] }}</div>
                                          <div id="Serum_AM_over" data-handle="{{ page.metafields.accentuate.answer1_over40_serum_am[index] }}" data-quantity class="product-meta answer_1_{{index}} noShow">{{ page.metafields.accentuate.answer1_over40_serum_am[index] }}</div>
                                          <div id="Serum_PM_over" data-handle="{{ page.metafields.accentuate.answer1_over40_serum_pm[index] }}" data-quantity class="product-meta answer_1_{{index}} noShow">{{ page.metafields.accentuate.answer1_over40_serum_pm[index] }}</div>
                                          <div id="Moisture_AM_over" data-handle="{{ page.metafields.accentuate.answer1_over40_moisture_am[index] }}" data-quantity class="product-meta answer_1_{{index}} noShow">{{ page.metafields.accentuate.answer1_over40_moisture_am[index] }}</div>
                                          <div id="Moisture_PM_over" data-handle="{{ page.metafields.accentuate.answer1_over40_moisture_pm[index] }}" data-quantity class="product-meta answer_1_{{index}} noShow">{{ page.metafields.accentuate.answer1_over40_moisture_pm[index] }}</div>
                                          {%- assign index = index | plus: 1 -%}
                                      </div>
