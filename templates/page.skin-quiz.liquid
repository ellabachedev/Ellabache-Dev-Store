<style>
  /* Overlay */
  .modal-overlay {
    display: none; /* Hidden by default */
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background:rgba(0, 30, 55, 0.9);
    z-index: 99;
    justify-content: center;
    align-items: center;
  }
  @media screen and (max-width: 768px){
    .modal-overlay{
      height:100%;
    }
  }
  /* Modal Box */
  .modal-content {
    display: block;
    max-width:1024px;
    width: 100%;
    background: #fff;
    overflow: hidden;
    position: relative;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
    margin:50px;
  }
  @media screen and (max-width: 768px){
    .modal-content {
      height:100%;
      margin:0;
    }
  }
  /* Close Button */
  .modal-close {
    position: absolute;
    top: 0;
    right: 0;
    font-size: 24px;
    background: none;
    border: none;
    cursor: pointer;
    z-index: 2;
    padding: 20px;
    transition: transform 0.3s;
  }
  .modal-close svg{
    width:21px;
    height:21px;
    transition: transform 0.3s;
  }
  .modal-close:hover svg {
      transform: scale(1.2);
  }
  /* Left Image */
  .modal-left {
    width: 50%;
  }
  .modal-left img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Right Content */
  .modal-right {
    width: 50%;
    padding: 40px 30px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    text-align: left;
  }
  .modal-right h2 {
    font-size: 22px;
    margin-bottom: 10px;
  }
  .modal-right em {
    font-style: italic;
  }
  .modal-right p {
    margin-bottom: 20px;
  }
  .modal-input {
    padding: 10px;
    border: none;
    border-radius: 6px;
    width: 100%;
    margin-bottom: 20px;
    font-size: 16px;
  }
  .modal-button {
    background: #000;
    color: #fff;
    padding: 12px;
    border: none;
    cursor: pointer;
    font-size: 16px;
    transition: background 0.3s ease;
  }
  .modal-button:hover {
    background: #333;
  }
  /* Responsive */
  @media (max-width: 768px) {
    .modal-content {
      flex-direction: column;
    }
    .modal-left, .modal-right {
      width: 100%;
    }
    .modal-right {
      padding: 30px 20px;
    }
  }
  .shopify-section--2-col-layout{
    padding:50px 0;
  }
  @media screen and (max-width: 768px){
    .shopify-section--2-col-layout{
      padding:0;
    }
  }
  @media only screen and (min-width: 740px) {
    .shopify-section--2-col-layout .page-width {
      grid-template-columns: repeat(2, 1fr);
      gap:50px;
      align-items:center;
      display: grid;
    }
  }
  .flex-container-col{
    flex-direction: column;
  }
  .shopify-section--2-col-layout .blocks--image img{width:auto; height:auto;}
  .quiz-item .flex-container .col{
    width:50%;
    height:650px;
    overflow-y:auto;
  }
  @media screen and (max-width: 768px){
    .quiz-item .flex-container .col{
      width:100%;
      height:auto;
    }
    .quiz-item .flex-container .col.col-image{
      height:325px;
    }
  }
  .quiz-item .flex-container .col .slide-content{
    width:100%;
  }
  .quiz-item .flex-container .col .form-wrap{
    width:100%;
  }
  .quiz-item.slide_1 .flex-container .col .form-wrap .form-inputs{
    max-height:inherit;
    overflow:inherit;
  }
  .quiz-item .flex-container .col.col-padding{
    padding:50px;
  }
  @media screen and (max-width: 768px){
    .quiz-item .flex-container .col.col-padding{
      padding:25px;
    }
  }
  .quiz-item .flex-container .col picture{
    height:100%;
  }
  .quiz-item .flex-container .col picture img{
    height:100%;
    width:100%;
    object-fit:cover;
  }
  .quiz-item .header{
    margin-bottom:15px;
    width:100%;
  }
  .quiz-item .header span{
    display:block;
  }
  .flex-direction--column{
    flex-direction: column;
  }
  .justify-content--center{
    justify-content: center;
  }
</style>
<section class="shopify-section--2-col-layout">
  <div class="page-width">
    <div class="blocks--image">
      <img src="{{ 'quiz1.jpg' | asset_url }}" alt=">Find you Skin Routine">
    </div>
    <div class="blocks--content">
      <h1>Discover Your Personalised Skin Routine</h1>
      <p>Experience expert skincare, tailored just for you. In under 60 seconds, our complimentary Skin Quiz reveals your personalised morning and evening routine, curated by Ella Baché skin experts for instant, visible results.</p>
      <p>Build your routine with confidence, ensuring your skin is nourished, hydrated, and protected every day.</p>
      <button style="margin-top:25px; max-width:300px;" class="btn btn-small btn-primary" id="block-button_quiz">Start your Quiz</button>
    </div>
  </div>
  <!-- Modal -->
  <div id="go-to-modal" class="modal-overlay">
    <div class="modal-content">
      <button class="modal-close" aria-label="Close modal">
        <svg focusable="false" width="18" height="18" class="icon icon--close   " viewBox="0 0 14 14">
          <path d="M13 13L1 1M13 1L1 13" stroke="currentColor" stroke-width="1.1" fill="none"></path>
        </svg>
      </button>
       <button id="prev" class="next-btn" style="display:none;border: none;
    background: none;
    appearance: none;
    -webkit-appearance: none;
    position: absolute;
    left: 0;
    top: 0;
    padding: 20px; z-index:9;background:none;">
         <svg xmlns="http://www.w3.org/2000/svg" width="21" height="21" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="butt" stroke-linejoin="miter">
          <line x1="19" y1="12" x2="5" y2="12" />
          <polyline points="12 19 5 12 12 5" />
        </svg>
       </button>
      <div class="modal__content-inner">
        <div class="quiz">
          <div class="quiz-slider">
