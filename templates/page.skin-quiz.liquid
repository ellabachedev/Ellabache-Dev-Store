                              </div>
                          </div>
                        </div>
                      <div class="col col-right col-image">
                            <picture>
                                <source media="(max-width:768px)" srcset="{{ 'quiz2.jpg' | asset_url }}" />
                                <img src="{{ 'quiz2.jpg' | asset_url }}" alt="Therapist" />
