                                          <div id="Cleanser_Weekly2_under" data-handle="{{ page.metafields.accentuate.answer2_under40_cleanser_weekly2[index] }}" data-quantity class="product-meta answer_2_{{index}} noShow">{{ page.metafields.accentuate.answer2_under40_cleanser_weekly2[index] }}</div>
                                          <div id="Cleanser_Weekly1_over" data-handle="{{ page.metafields.accentuate.answer2_over40_cleanser_weekly1[index] }}" data-quantity class="product-meta answer_2_{{index}} noShow">{{ page.metafields.accentuate.answer2_over40_cleanser_weekly1[index] }}</div>
                                          <div id="Cleanser_Weekly2_over" data-handle="{{ page.metafields.accentuate.answer2_over40_cleanser_weekly2[index] }}" data-quantity class="product-meta answer_2_{{index}} noShow">{{ page.metafields.accentuate.answer2_over40_cleanser_weekly2[index] }}</div>
