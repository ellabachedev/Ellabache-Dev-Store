                            </picture>
                        </div>
                        <div class="col col-right col-padding flex-container flex-center">
                          <div class="header">
                              <h2><span style="font-size:16px; margin-bottom:5px;">Begin Your </span>Ella Baché Skincare Experience</h2>
                              <p>With over 90 years of Ella Baché expertise, our quiz creates a personalised skincare routine tailored to your skin’s needs and lifestyle. Complete the quiz and receive 20% off your first order*.</p>
                          </div>
                          <div class="form-wrap">
                              <div class="box-wrapper">
                                  <div class="form-inputs grid">
                                    <div class="flex-container">
                                      <div class="item">
                                          <label class="hidden">name</label>
                                          <input type="text" class="form__input" name="answer_name" id="answer_name" autocomplete="off" placeholder="name" />
                                          <p class="form-field-error">This is a required field.</p>
                                      </div>
                                      <div class="item">
                                          <label class="hidden">email</label>
                                          <input type="email" required class="form__input" name="answer_email" id="answer_email" autocomplete="off" placeholder="email" />
                                          <p class="form-field-error">This is a required field.</p>
                                      </div>
                                      <div class="item">
                                          <label class="hidden">Date of Birth</label>
                                          <input id="answer_3_0" type="text" class="form__input" name="answer_dob" autocomplete="off" placeholder="date of birth" />
                                          <p class="form-field-error">This is a required field.</p>
                                      </div>
                                    </div>
                                  </div>
                                <div class="button-holder">
                                  <button id="next-1" class="btn btn-primary next-btn">Discover Your Routine</button>
                                </div>
                              </div>
                          </div>
                        </div>
                    </div>
                </div>
              <div class="quiz-item slide_2">
