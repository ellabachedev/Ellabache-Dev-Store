    "college-cta4": {
      "type": "college-cta4",
      "settings": {
        "block_switch": true,
        "block_bg_color": "#ffffff",
        "block_title": "How to Apply",
        "block_description": "",
        "block_image": "shopify:\/\/shop_images\/HeaderThree_copy.jpg",
        "block_shogun_content": "<div class=\"shogun-2-col-grid\">\n      <div class=\"flex-container\">\n        <div class=\"col-item\">\n          <h3>Find an education agent<\/h3>\n          <p><strong>If you are thinking of studying in Australia, an Education Agent can give you advice about Ella Baché College and courses. They can also provide you with VISA information and help you complete your application to study in Australia.<\/strong><\/p>\n          <div class=\"lists\">\n            <ul>\n              <li><p><a href=\"https:\/\/www.gostudy.com.au\/\" target=\"_blank\">GO STUDY Australia<\/a><\/p><\/li>\n              <li><p><a href=\"http:\/\/www.johokan.jp\/company_profile.php\" target=\"_blank\">International Communications Network Japan<\/a><\/p><\/li>\n              <li><p><a href=\"http:\/\/www.brightannica.com\/\" target=\"_blank\">Brightannica<\/a><\/p><\/li> \n              <li><p><a href=\"http:\/\/www.australiaonline.agency\/\" target=\"_blank\">Australia Online<\/a><\/p><\/li>\n              <li><p><a href=\"https:\/\/www.chiceducation.com\/\" target=\"_blank\">Chic Education<\/a><\/p><\/li>\n              <li><p><a href=\"https:\/\/www.aussie-study.com\/\" target=\"_blank\">Aussie Study<\/a><\/p><\/li>\n              <li><p><a href=\"https:\/\/deow.jp\/\" target=\"_blank\">Deow<\/a><\/p><\/li>\n              <!-- <li><p><a href=\"https:\/\/pathwaytoaus.com\/\" target=\"_blank\">Pathway to Aus<\/a><\/p><\/li>\n              <li><p><a href=\"https:\/\/www.letsgoplanet.com\/\" target=\"_blank\">Lets Go Planet<\/a><\/p><\/li> -->\n              <li><p><a href=\"http:\/\/easyoz.com.au\" target=\"_blank\">Easy Oz<\/a><\/p><\/li>\n              <li><p><a href=\"http:\/\/www.study-au.com\" target=\"_blank\">Homestay & Education Australia Pty Ltd<\/a><\/p><\/li>\n              <li><p><a href=\"https:\/\/www.iibit.edu.au\/agents\/t-n-sydney-international-education-consultancy-pty-ltd-2\/\" target=\"_blank\">T&N<\/a><\/p><\/li>\n            <\/ul>\n          <\/div>\n          <p><strong>Interested in becoming an Ella Bache Education Agent?<\/strong><\/p>\n          <p><strong>Please contact Balthazar at: bboutry@thestudyconsult.com<\/strong><\/p>\n        <\/div>\n        <div class=\"col-item\">\n          <h3>Apply directly to Ella Baché College<\/h3>\n          <p><strong>Step 1: Apply using the <a href=\"https:\/\/www.ellabache.com.au\/pages\/college-enrolment-form-and-agreement\" target=\"_blank\">International Student Application Form<\/a><\/strong><\/p>\n          <p><strong>Step 2: Prepare you supporting documents:<\/strong><\/p>\n          <div class=\"lists\">\n            <ul>\n              <li><p>Proof of age (all applicants must be 18 years of age or older)<\/p><\/li>\n              <li><p>IELST 5.5 or equivalent English test result<\/p><\/li>\n              <li><p>Copy of passport<\/p><\/li>\n              <li><p>Overseas Student Health Cover (OSHC)<\/p><\/li>\n            <\/ul>\n          <\/div>\n          <p><strong>Step 3: Accept your Written Agreement. Your Course and Careers Advisor will issue a Written Agreement outlining all fees you are required to pay, current and accurate information about the course, entry requirements and mode of study.<\/strong><\/p>\n          <p><strong>Step 4: Pay a course deposit of $1000 and OSHC or supply OSHC certificate<\/strong><\/p>\n          <p><strong>Step 5: Apply for your student VISA<\/strong><\/p>\n        <\/div>\n      <\/div>\n    <\/div>",
        "block_shogun_content_2": ""
      }
    },
