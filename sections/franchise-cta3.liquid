{{ 'section-franchise-cta3.css' | asset_url | stylesheet_tag }}
{%- capture franchiseCTA3 -%}
{%- if section.settings.block_switch != blank -%}
<section class="franchise-cta3" style="background-color:{{ section.settings.block_bg_color }};">
  <div class="page-width">
    <div class="lists">
      {%- for block in section.blocks -%}
      <div class="item">
          <div class="flex-container">
            {%- if block.settings.item_thumb != blank -%}
            <figure class="thumb desktop offscreen_img_wrapper">
              <img width="667" height="388" src="{{ block.settings.item_thumb | img_url:'649x' }}" loading="lazy" alt="">
            </figure>
            {%- endif -%}
            <div class="content">
              {%- if block.settings.item_title != blank -%}
              <h2 class="title">{{ block.settings.item_title }}</h2>
              {%- endif -%}
              {%- if block.settings.item_desc != blank -%}
              {{ block.settings.item_desc }}
              {%- endif -%}
                {%- if block.settings.item_btn_url != blank -%}
                <a href="{{ block.settings.item_btn_url }}" class="link-wrapper">
                {%- endif -%}
                  {%- if block.settings.item_btn_text != blank -%}
                  <div class="button-holder">
                    <span class="button">{{ block.settings.item_btn_text }}</span>
                  </div>
                  {%- endif -%}
                {%- if block.settings.item_btn_url != blank -%}
                </a>
                {%- endif -%}
            </div>
        </div>
    </div>
    {%- endfor -%}
  </div>
</section>
{%- endif -%}
{%- endcapture -%}
{{ franchiseCTA3 | strip_newlines }}
{% schema %}
  {
    "name": "Franchise CTA 3",
    "settings": [
    {
      "id" : "block_switch",
      "type" : "checkbox",
      "label" : "Enable",
      "default" : true
    },
    {
      "id" : "block_bg_color",
      "type" : "color",
      "label" : "Block Background Color",
      "default": "#ffffff"
    }
    ],
    "blocks": [
    {
      "type": "Article",
      "name": "Item",
      "settings": [
        {
          "id": "item_thumb",
          "type": "image_picker",
          "label": "Image"
        },
        {
          "id": "item_title",
          "type": "text",
          "label": "Title"
        },
        {
          "id": "item_desc",
          "type": "textarea",
          "label": "Description"
        },
        {
          "id": "item_btn_text",
          "type": "text",
          "label": "Button text"
        },
        {
          "type": "url",
          "id": "item_btn_url",
          "label": "Link"
        }
      ]
    }
  ]
  }
{% endschema %}

{% stylesheet %}


{% endstylesheet %}

{% javascript %}
{% endjavascript %}