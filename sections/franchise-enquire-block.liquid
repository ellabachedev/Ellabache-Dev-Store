</script>
<script>
  var urlParms = getUrlVars();
    // Cookie Variables -----------------------------
    var cookieValGclid = getCookie("gclid"),
      cookieValUtm_source = getCookie("utm_source"),
      cookieValUtm_medium = getCookie("utm_medium"),
      cookieValUtm_campaign = getCookie("utm_campaign"),
      cookieValUtm_term = getCookie("utm_term");
    var typeform_source = '{{ page.metafields.accentuate.typeform_source }}';
    if (typeform_source == undefined || typeform_source == '') {
      var typeform_sourceNew = '';
    }
    else {
      var typeform_sourceNew = '&source=' + typeform_source;
    }
    var utm_source = urlParms["utm_source"];
    if (utm_source == undefined) {
      var utm_sourceNew = '';
      if (cookieValUtm_source != "") {
        var utm_sourceNew = '&utm_source=' + cookieValUtm_source;
      }
    }
    else {
      var utm_sourceNew = '&utm_source=' + utm_source;
      //set the utm_source query string parameter on the cookie --
      setCookie("utm_source", utm_source, 365);
    }
    var utm_medium = urlParms["utm_medium"];
    if (utm_medium == undefined) {
      var utm_mediumNew = '';
      if (cookieValUtm_medium != "") {
        var utm_mediumNew = '&utm_medium=' + cookieValUtm_medium;
      }
    }
    else {
      var utm_mediumNew = '&utm_medium=' + utm_medium;
      //set the utm_medium query string parameter on the cookie --
      setCookie("utm_medium", utm_medium, 365);
    }
    var utm_campaign = urlParms["utm_campaign"];
    if (utm_campaign == undefined) {
      var utm_campaignNew = '';
      if (cookieValUtm_campaign != "") {
        var utm_campaignNew = '&utm_campaign=' + cookieValUtm_campaign;
      }
    }
    else {
      var utm_campaignNew = '&utm_campaign=' + utm_campaign;
      //set the utm_campaign query string parameter on the cookie --
      setCookie("utm_campaign", utm_campaign, 365);
    }
    var utm_term = urlParms["utm_term"];
    if (utm_term == undefined) {
      var utm_termNew = '';
      if (cookieValUtm_term != "") {
        var utm_termNew = '&utm_term=' + cookieValUtm_term;
      }
    }
    else {
      var utm_termNew = '&utm_term=' + utm_term;
      //set the utm_campaign query string parameter on the cookie --
      setCookie("utm_term", utm_term, 365);
    }
    var service = urlParms["service"];
    if (service == undefined) {
      var serviceNew = '';
    }
    else {
      var serviceNew = '&service=' + service;
    }
    var gclid = urlParms["gclid"];
    if (gclid == undefined) {
      var gclidNew = '';
      if (cookieValGclid != "") {
        var gclidNew = '&gclid=' + cookieValGclid;
      }
    }
    else {
      var gclidNew = '&gclid=' + gclid;
      //set the GCLID query string parameter on the cookie --
      setCookie("gclid", gclid, 365);
    }

    // Read a page's GET URL variables and return them as an associative array.
    function getUrlVars(){
      var vars = [], hash;
      var hashes = window.location.href.slice(window.location.href.indexOf('?') + 1).split('&');
      for(var i = 0; i < hashes.length; i++)
      {
          hash = hashes[i].split('=');
          vars.push(hash[0]);
          vars[hash[0]] = hash[1];
      }
      return vars;
    }
    function check(type) {
      return $('body').find(type).length;
    }
    function setCookie(cname, cvalue, exdays) {
      var d = new Date();
      d.setTime(d.getTime() + (exdays * 24 * 60 * 60 * 1000));
      var expires = "expires=" + d.toUTCString();
      document.cookie = cname + "=" + cvalue + ";" + expires + ";path=/";
    }
    function getCookie(cname) {
      var name = cname + "=";
      var decodedCookie = decodeURIComponent(document.cookie);
      var ca = decodedCookie.split(';');
      for (var i = 0; i < ca.length; i++) {
        var c = ca[i];
        while (c.charAt(0) == ' ') {
          c = c.substring(1);
        }
        if (c.indexOf(name) == 0) {
          return c.substring(name.length, c.length);
        }
      }
      return "";
    }  
</script>
<script>
  var typeform_source = '{{ page.metafields.accentuate.typeform_source }}';
  if (typeform_source == undefined || typeform_source == '') {
      var typeform_sourceNew = '';
    }
    else {
      var typeform_sourceNew = '&source=' + typeform_source;
    }
  jQuery(window).on('load', function () {
    // check typeform widget ------------------------
    var typeFormWidget = check('div.typeform-widget');
    if (typeFormWidget > 0) {
      var typeFormDataUrl = jQuery("div.typeform-widget").attr('data-url'),
        typeFormDataUrlParts = typeFormDataUrl.split("/"),
        typeFormDataUrlLastPart = typeFormDataUrlParts[typeFormDataUrlParts.length - 1];
      setTimeout(function () {
        jQuery('div.typeform-widget').each(function () {
          jQuery(this).find(" iframe[data-qa='iframe']").attr('src', 'https://ellabache.typeform.com/to/' + typeFormDataUrlLastPart + '?typeform-embed=embed-widget' + typeform_sourceNew + utm_sourceNew + utm_mediumNew + utm_campaignNew + utm_termNew + serviceNew + gclidNew);
        });
      }, 1000);
    }
  });
</script>
