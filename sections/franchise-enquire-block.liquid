{{ 'section-enquire-block.css' | asset_url | stylesheet_tag }}
{%- capture franchiseEnquireBlock -%}
{%- if section.settings.block_switch != blank -%}
<section id="franchiseEnquiry" class="enquire-block franchise-enquire-block" style="background-color:{{ section.settings.block_bg_color }};">
  <div class="page-width">
    <div class="zoho-form" style="max-width:800px; margin:0 auto;">
      {%- if section.settings.block_title != blank -%}
        <h2 class="block-title">{{ section.settings.block_title }}</h2>
      {%- endif -%}
      {%- if section.settings.block_desc != blank -%}
        {{ section.settings.block_desc }}
      {%- endif -%}
      <div class="typeform-widget" data-url="{{ section.settings.typeform_data-url }}" style="width: 100%; height: 500px; margin-top:15px;"></div>
      {% comment %}{% render 'zoho-franchise--enquire-form' %}{% endcomment %}
    </div>
    <div class="blog-grid">
      {%- if section.settings.sidebar_title != blank -%}
      <h2 class="block-title">{{ section.settings.sidebar_title }}</h2>
      {%- endif -%}
      <div class="lists">
        {%- for block in section.blocks -%}
        {%- if block.type == "iconContent" -%}
          {%- if block.settings.block_iconContent_switch != blank -%}
          <div class="item iconContent">
            {%- if block.settings.item_iconContent_icon != blank -%}
            <div class="icon">
              <img width="170" height="120" src="{{ block.settings.item_iconContent_icon | img_url:'400x' }}" loading="lazy" alt="icon">
            </div>
            {%- endif -%}
            <div class="content">
              {%- if block.settings.item_iconContent_title != blank -%}
              <span class="tag">{{ block.settings.item_iconContent_title }}</span>
              {%- endif -%}
              {%- if block.settings.item_iconContent_desc != blank -%}
              <p>{{ block.settings.item_iconContent_desc }}</p>
              {%- endif -%}
            </div>
          </div>
          {%- endif -%}
        {%- elsif block.type == "Article" -%}
          {%- if block.settings.block_article_switch != blank -%}
          {%- if block.settings.item_article_btn_url != blank -%}
          <a class="link-wrapper" title="{{ block.settings.item_article_title }}" href="{{ block.settings.item_article_btn_url }}">
          {%- endif -%}
            <div class="item article">
                {%- if block.settings.item_article_image != blank -%}
                <div class="icon" >
                  <img width="170" height="120" src="{{ block.settings.item_article_image | img_url:'400x' }}" loading="lazy" alt="icon">
                </div>
                {%- endif -%}
                <div class="content">
                  {%- if block.settings.item_article_title != blank -%}
                  <h3>{{ block.settings.item_article_title }}</h3>
                  {%- endif -%}
                  {%- if block.settings.item_article_desc != blank -%}
                  <p>{{ block.settings.item_article_desc }}</p>
                  {%- endif -%}
                </div>
            </div>
            {%- if block.settings.item_article_btn_url -%}
          </a>
          {%- endif -%}
          {%- endif -%}
        {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>
{%- endif -%}
{%- endcapture -%}
{{ franchiseEnquireBlock | strip_newlines }}
