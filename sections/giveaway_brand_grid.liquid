<style>
.giveaway-brand-grid {
  margin-bottom:40px;
}
@media screen and (max-width: 767px) {
  .giveaway-brand-grid {
    margin-bottom:15px;
    margin-top:15px;
  }
}
.giveaway-brand-grid .page-width{
  max-width:1720px;
}
.giveaway-brand-grid .brand-grid {
  display:grid;
  grid-template-columns:repeat(auto-fit, minmax(300px, 1fr));
  grid-column-gap:40px;
  grid-row-gap:40px;
}
@media screen and (max-width: 767px) {
  .giveaway-brand-grid .brand-grid{
    grid-row-gap:15px;
  }
}
.brand-tile {
  position: relative;
  overflow: hidden;
  height: 400px;
}

.brand-image {
  width: 100%;
  height: 100%;
  overflow: hidden;
}
/* Overlay background */
.brand-image::after {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  height: 100%;
  width: 100%;
  background: rgba(0, 0, 0, 0.25); /* light black overlay */
  z-index: 1;
  transition: background 0.4s ease;
}

.brand-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s ease;
}

.brand-overlay {
  position: absolute;
  top: 50%;
  left: 50%;
  color: white;
  transform:translate(-50%, -50%);
  text-shadow: 0 0 5px rgba(0, 0, 0, 0.7);
  z-index: 2;
  transition: opacity 0.4s ease, transform 0.4s ease;
  text-align:center;
  width: 100%;
  padding: 20px;
  max-width: 425px;
}

.brand-tile:hover .brand-image img {
  transform: scale(1.05);
}

.brand-tile:hover .brand-overlay {
  opacity: 1;
}

.brand-overlay h2 {
  font-size: 24px;
  margin-bottom: 10px;
}

.brand-overlay p {
  margin-bottom: 10px;
  font-size: 16px;
}

.brand-overlay .btn {
  background-color: transparent;
  color: #fff;
  padding: 10px 20px;
  text-decoration: none;
  display: inline-block;
  border: 2px solid #ffffff;
  transition: background-color 0.3s ease;
}

.brand-overlay .btn:hover {
  background-color: #001f38;
  border: 2px solid #001f38;
}
</style>
<section class="giveaway-brand-grid">
  <div class="page-width">
    <div class="brand-grid">
      {% for block in section.blocks %}
        <div class="brand-tile">
          <div class="brand-image">
            <img src="{{ block.settings.brand_image | img_url: '800x' }}" alt="{{ block.settings.brand_title }}" loading="lazy">
          </div>
          <div class="brand-overlay">
            {% if block.settings.brand_title != blank %}
              <h2>{{ block.settings.brand_title }}</h2>
            {% endif %}
            {% if block.settings.brand_subtext != blank %}
              <p>{{ block.settings.brand_subtext }}</p>
            {% endif %}
            {% if block.settings.button_text != blank %}
              <a href="{{ block.settings.button_url }}" class="btn btn-secondary">
                {{ block.settings.button_text }}
              </a>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Giveaway Brand Grid",
  "settings": [],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand Tile",
      "settings": [
        {
          "type": "image_picker",
          "id": "brand_image",
          "label": "Brand Image"
        },
        {
          "type": "text",
          "id": "brand_title",
          "label": "Brand Title"
        },
        {
          "type": "textarea",
          "id": "brand_subtext",
          "label": "Subtext"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button URL"
        }
      ]
    }
  ],
  "max_blocks": 2,
  "presets": [
    {
      "name": "Giveaway Brand Grid",
      "category": "Giveaway"
    }
  ]
}
{% endschema %}
