              {
                "value": "1",
                "label": "Full Border"
              }, {
                "value": "2",
                "label": "Bottom Border"
              }, {
                "value": "3",
                "label": "No Border"
              }
            ],
            "default": "2"
          }, {
            "type": "header",
            "content": {
              "en": "Slider Styles"
            }
          }, {
            "type": "color",
            "id": "slider-bg-color",
            "label": "Slider Background Color",
            "default": "#001E37"
          }, {
            "type": "color",
            "id": "slider-title-color",
            "label": "Title Font Color",
            "default": "#001E37"
          }, {
            "type": "color",
            "id": "slider-title-bgcolor",
            "label": "Title Background Color",
            "default": "#ffffff"
          }, {
            "type": "color",
            "id": "slider-desc-color",
            "label": "Description Color",
            "default": "#ffffff"
          }, {
            "type": "color",
            "id": "slider-btn-font-color",
            "label": "Button Font Color",
            "default": "#ffffff"
          }, {
            "type": "color",
            "id": "slider-btn-border-color",
            "label": "Button Border Color",
            "default": "#ffffff"
          }, {
            "type": "color",
            "id": "slider-btn-bg-color",
            "label": "Button Background Color",
            "default": "#001E37"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Hero Slider",
        "category": "Slider"
      }
    ]
  }
{% endschema %}