          {
            "type": "select",
            "id": "banner_layout",
            "label": "Banner Layout",
            "options": [
              {
                "value": "1",
                "label": "Full Width Image/Video"
              }, {
                "value": "2",
                "label": "Half Width Image/Video"
              }, {
                "value": "3",
                "label": "No Image/Video"
              }
            ],
            "default": "2"
          },
          {
            "type": "url",
            "id": "full-slider-link",
            "label": "Banner Image URL"
          },
          {
            "type": "image_picker",
            "id": "slider-image-desktop",
            "label": "Slider Image Desktop"
          }, {
            "type": "image_picker",
            "id": "slider-image-mobile",
            "label": "Slider Image Mobile"
          }, {
            "type": "text",
            "id": "slider-video-url",
            "label": "Video URL (Overwrites Image)"
          }, {
            "type": "header",
            "content": {
              "en": "Slider Content Block"
            }
          }, {
            "id": "slider_content_switch",
            "type": "checkbox",
            "label": "Enable",
            "default": true
          }, {
            "type": "select",
            "id": "slider_content_layout",
            "label": "Content Layout",
            "options": [
              {
                "value": "1",
                "label": "Primary Interace"
              }, {
                "value": "2",
                "label": "Secondary Interface"
              }
            ],
            "default": "1"
          }, {
            "type": "select",
            "id": "slider_column_reverse",
            "label": "Slider Column Reverse",
            "options": [
              {
                "value": "1",
                "label": "Left"
              }, {
                "value": "2",
                "label": "Right"
              }
            ],
            "default": "1"
          }, {
            "id": "slider_content_bg_color",
            "type": "color",
            "label": "Enable",
            "default": "#001E37"
          }, {
            "type": "textarea",
            "id": "slider-main-title",
            "label": "Title"
          }, {
            "type": "range",
            "id": "slider-main-title-mb",
            "min": 0,
            "max": 60,
            "step": 1,
            "unit": "px",
            "label": "Title Margin Bottom Value (Mobile)",
            "default": 0
          }, {
            "id": "slider-main-title-animate",
            "type": "checkbox",
            "label": "Enable Title Animation",
            "default": false
          }, {
            "type": "textarea",
            "id": "slider-description",
            "label": "Description (Desktop)"
          }, {
            "type": "range",
            "id": "slider-desc-max-width",
            "min": 100,
            "max": 1000,
            "step": 100,
            "label": "Slider Description Max Width",
            "default": 600
          }, {
            "type": "textarea",
            "id": "slider-description-mobile",
            "label": "Description (Mobile)"
          }, {
            "type": "text",
            "id": "slider-secondary-text",
            "label": "Secondary Text"
          }, {
            "type": "color",
            "id": "slider-desc-bgcolor-mob",
            "label": "Background Color",
            "default": "#DDDDDD"
          }, {
            "type": "text",
            "id": "slider-button-text",
            "label": "Button",
            "default": "Shop Now"
          }, {
            "type": "url",
            "id": "slider-button-url",
            "label": "Button URL"
          }, {
            "type": "select",
            "id": "button-style",
            "label": "Button Style",
