{{ 'magnific-popup.css' | asset_url | stylesheet_tag }}
{{ 'search-page.css' | asset_url | stylesheet_tag }}
{% if search.types contains 'product' %}
{% assign paginationLimit = 20 %}
{% else %}
{% assign paginationLimit = 12 %}
{% endif %}
<section class="search-results">
  {% paginate search.results by paginationLimit %}
  <header class="search-header {% if search.performed %}{% else %}margin-bottom-120{% endif %}">
    <div class="page-width">
      {% if search.performed %}
      <div class="rte">
        {% if search.results_count == 0 %}
        {{ 'general.search.no_results_html' | t: terms: search.terms }}
        {% else %}
        {{ 'general.search.results_for_html' | t: terms: search.terms }}
        {% endif %}
      </div>
      {% endif %}
    </div>
  </header>
  {% assign searchTypes = search.types | join: "|" %}
  <div id="hiddenResults" data-search-terms="{{ search.terms }}" data-search-types="{{ searchTypes }}"
    data-shop-secureurl="{{ shop.secure_url }}" data-pagination-limit="{{ paginationLimit }}"
    data-product-count="{{ search.results_count }}" data-article-count="{{ search.results_count }}"
    style="display:none;">
    {% assign tempProd = product %}
    {% if search.performed %}
    {% for item in search.results %}
    {% if item.object_type == 'product' %}
    {% assign product = item %}
    {% assign isTreatment = 0 %}
    {% if product.template_suffix == 'treatment' or product.template_suffix == 'treatment-dawn' %}
    {% assign isTreatment = 1 %}
    {% endif %}
    {% assign productCollectionHandles = '' %}
    {% for prodColl in product.collections %}
    {% if forloop.first == true %}
    {% assign productCollectionHandles = prodColl.handle %}
    {% else %}
    {% assign productCollectionHandles = productCollectionHandles | append: ',' | append: prodColl.handle %}
    {% endif %}
    {% endfor %}

    {%- assign isEligiable = 0 -%}
    {%- assign isFreeSample = 0 -%}
    {%- if settings.enable_buyX_getY -%}
    {% assign isEligiable = 0 %}
    {%- for prodCollection in product.collections -%}
    {%- if prodCollection.handle == settings.X_collection -%}
    {%- assign isEligiable = 1 -%}
    {%- endif -%}
    {%- endfor -%}
    {%- assign isFreeSample = 0 -%}
    {%- if product.handle == settings.free_product_1 -%}
    {%- assign isFreeSample = 1 -%}
    {%- elsif product.handle == settings.free_product_2 -%}
    {%- assign isFreeSample = 1 -%}
    {%- elsif product.handle == settings.free_product_3 -%}
    {%- assign isFreeSample = 1 -%}
    {%- elsif product.handle == settings.free_product_4 -%}
    {%- assign isFreeSample = 1 -%}
    {%- elsif product.handle == settings.free_product_5 -%}
    {%- assign isFreeSample = 1 -%}
    {%- else -%}
    {%- assign isFreeSample = 0 -%}
    {%- endif -%}
    {%- endif -%}
    {% if product.available %}
    {% assign productAvailable = 1 %}
    {% else %}
    {% assign productAvailable = 0 %}
    {% endif %}
    {% assign productVariants = product.variants %}
    {% assign variantsStr = "" %}
    {% for variant in productVariants %}
    {% assign variantId = variant.id %}
    {% assign variantTitle = variant.title %}
    {% assign variantPrice = variant.price | money %}
    {% assign variantCompareAtPrice = variant.compare_at_price | money %}
    {% assign addToCartTextDefault = 'products.product.add_to_cart' | t %}
    {% assign addToCartText = 'products.product.add_to_cart' | t %}
    {% assign hasCompareAtPriceDefault = 0 %}
    {% assign hasCompareAtPrice = 0 %}
    {% assign variantImageSrc = variant.image.src %}
    {% assign variantImageUrl = variant.image.src | img_url: '720x720' %}
    {% assign variantImageUrlThumb = variant.image.src | img_url: '115x115' %}
    {% if variant.compare_at_price > variant.price %}
    {% assign hasCompareAtPrice = 1 %}
    {% else %}
    {% assign hasCompareAtPrice = 0 %}
    {% endif %}
    {%- if variant.available -%}
    {%- if variant.inventory_policy == 'continue' and variant.inventory_quantity == 0 -%}
    {% assign addToCartText = 'products.product.preorder' | t %}
    {%- else -%}
    {% assign addToCartText = 'products.product.add_to_cart' | t %}
    {%- endif -%}
    {%- else -%}
    {% assign addToCartText = 'products.product.sold_out' | t %}
    {%- endif -%}
    {% if variant.available %}
    {% assign variantAvailable = 1 %}
    {% else %}
    {% assign variantAvailable = 0 %}
    {% endif %}
    {% if variant.id == product.selected_or_first_available_variant.id %}
    {% assign variantSelected = 1 %}
    {% assign addToCartTextDefault = addToCartText %}
    {% assign hasCompareAtPriceDefault = hasCompareAtPrice %}
    {% else %}
    {% assign variantSelected = 0 %}
    {% endif %}

    {% if forloop.first %}
    {% assign variantsStr = variantsStr | append: variantId | append: "|" | append: variantTitle | append: "|" | append:
    variantPrice | append: "|" | append: variantImageSrc | append: "|" | append: variantImageUrl | append: "|" | append:
    variantImageUrlThumb | append: "|" | append: variantAvailable | append: "|" | append: variantSelected | append: "|"
    | append: addToCartText | append: "|" | append: variantCompareAtPrice | append: "|" | append: hasCompareAtPrice %}
    {% else %}
    {% assign variantsStr = variantsStr | append: "|#|" | append: variantId | append: "|" | append: variantTitle |
    append: "|" | append: variantPrice | append: "|" | append: variantImageSrc | append: "|" | append: variantImageUrl |
    append: "|" | append: variantImageUrlThumb | append: "|" | append: variantAvailable | append: "|" | append:
    variantSelected | append: "|" | append: addToCartText | append: "|" | append: variantCompareAtPrice | append: "|" |
    append: hasCompareAtPrice %}
    {% endif %}
    {% endfor %}
    {% assign imagesStr = "" %}
    {% for image in product.images %}
    {% assign imgUrl = image.src | img_url: '500x' %}
    {% assign imgUrlThumb = image.src | img_url: '115x115' %}
    {% if forloop.first %}
    {% assign imagesStr = imagesStr | append: image.src | append: "|" | append: imgUrl | append: "|" | append:
    imgUrlThumb %}
    {% else %}
    {% assign imagesStr = imagesStr | append: "|#|" | append: image.src | append: "|" | append: imgUrl | append: "|" |
    append: imgUrlThumb %}
    {% endif %}
    {% endfor %}
    <div class="hidden-item" data-template="{{ product.template_suffix }}"
      data-item-object-type="{{ item.object_type }}" data-is-treatment="{{ isTreatment }}"
      data-item-url="{{ item.url | within: collection }}" data-product-title="{{ product.title }}"
      data-variant-quantity="{{ product.variants[0].inventory_quantity }}"
      data-variant-sku="{{ product.variants[0].sku }}" data-variant-title="{{ product.variants[0].title }}"
      data-product-handle="{{ product.handle }}" data-product-quantity="1"
      data-product-image="{{ product.featured_image.src | img_url: '500x' }}" data-product-images="{{ imagesStr }}"
      data-product-price="{{ product.variants[0].price | money }}"
      data-product-compareatprice="{{ product.variants[0].compare_at_price | money }}"
      data-product-hascompareatprice="{{ hasCompareAtPriceDefault }}"
      data-w-product-price="{{ product.variants[0].price | money | remove: '.00' }}"
      data-variant-id="{{ product.variants[0].id }}" data-product-id="{{ product.id }}"
      data-product-globalsize="{{ product.metafields.global.prod_size }}"
      data-product-desc="{{ product.description | strip_html | truncatewords: 45, " ..." }}"
      data-product-descshort="{{ product.description | strip_html | truncate: 80, " <span class='dotdotdot'>...</span>"
      }}" data-collection-handles="{{ productCollectionHandles }}" data-eligiable="{{ isEligiable }}"
      data-freesample="{{ isFreeSample }}" data-product-available="{{ productAvailable }}" data-variants-count="{{
      productVariants.size }}" data-defaultvariantid="{{ product.selected_or_first_available_variant.id }}"
      data-variants="{{ variantsStr }}" data-addtocart-text="{{ addToCartTextDefault }}" data-unique-collection="{{
      collection.handle }}">
      <div class="json">{{ item | json }}</div>
      <div class="item-badges">
        <div id="productInfos-{{ collection.handle }}-{{ product.id }}" style="display:none;">
          <div id="productReviewBadge-{{ collection.handle }}-{{ product.id }}">
            <span class="stamped-product-reviews-badge stamped-main-badge" data-id="{{ product.id }}"
              data-product-sku="{{ product.handle }}" style="display: inline-block;">{{ product.metafields.stamped.badge
              }}</span>
          </div>
          <div id="afterpayBadge-{{ collection.handle }}-{{ product.id }}">
            {%- if settings.afterpay_enabled -%}{% include 'afterpay' %}{%- endif -%}
          </div>
        </div>
      </div>
    </div>
    {% else %}
    {% assign featured_image = "https://cdn.shopify.com/s/files/1/0119/6028/7313/files/no-image.png" %}
    {%- if item.image != blank -%}
    {% assign featured_image = item.image | img_url: '300x' %}
    {%- endif -%}
    <div class="hidden-item" data-item-object-type="{{ item.object_type }}" data-item-image="{{ featured_image }}"
      data-item-title="{{ item.title }}" data-item-url="{{ item.url }}">
    </div>
    {% endif %}
    {% endfor %}
    {% endif %}
    {% assign product = tempProd %}
  </div>
  <div class="search-results-content">
    <div class="page-width">
      <div class="flex-container search-results-content-inner">
        {% if search.performed %}
        <div id="collection-dynamic-content" class="search-results-dynamic-content">
          <div id="noProductsTreatmentsWrap">
            <h2 class="block-title">Products and Book Treatments</h2>
            <div class="product-grid-block">
              <div class="product-listing">
                <div class="flex-container product-grid" style="border-top:2px solid #f0f0f0; border-left:2px solid #f0f0f0;">

                </div>
              </div>
            </div>
          </div>
          <div class="results">
            <div id="productsWrap" class="result-col" style="display:none;">
              <h2 class="block-title">Products</h2>
              <div class="product-grid-block">
                <div class="product-listing non-treatment-list">
                  <div class="flex-container" style="border-top:2px solid #f0f0f0; border-left:2px solid #f0f0f0;">

                  </div>
                </div>
              </div>
            </div>
            <div id="treatmentsWrap" class="result-col" style="display:none;">
              <h2 class="block-title">Book Treatments</h2>
              <div class="product-grid-block">
                <div class="product-listing treatment-list">
                  <div class="flex-container" style="border-top:2px solid #f0f0f0; border-left:2px solid #f0f0f0;">

                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        {% endif %}
        <div class="search-blogs">
          <h2 class="block-title">Welcome to bold blog</h2>
          <div class="lists flex-container">

          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="button-holder">
    <button id="show-more" class="btn button">Show More</button>
  </div>
  <div class="inline-loader"></div>
  {% endpaginate %}

