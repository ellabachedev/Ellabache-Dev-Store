            if (parseFloat(jQuery(this).find('.stamped-badge').attr('data-rating')) == 0.0) {
              jQuery(this).find('.stamped-product-reviews-badge').removeClass('stamped-main-badge');
              searchReviewsFinalized = true;
            } else {
              if (!jQuery(this).find('.stamped-product-reviews-badge').hasClass('stamped-main-badge')) {
                jQuery(this).find('.stamped-product-reviews-badge').addClass('stamped-main-badge');
                searchReviewsFinalized = true;
              }
            }
          });
        } else {
          searchReviewsFinalized = true;
        }
        if (jQuery('#recommendedProducts .product-grid-block .product-listing .slider .item').length > 0) {
          jQuery('#recommendedProducts .product-grid-block .product-listing .slider .item').each(function (index) {
            if (parseFloat(jQuery(this).find('.stamped-badge').attr('data-rating')) == 0.0) {
              jQuery(this).find('.stamped-product-reviews-badge').removeClass('stamped-main-badge');
              recommendedReviewsFinalized = true;
            } else {
              if (!jQuery(this).find('.stamped-product-reviews-badge').hasClass('stamped-main-badge')) {
                jQuery(this).find('.stamped-product-reviews-badge').addClass('stamped-main-badge');
                recommendedReviewsFinalized = true;
              }
            }
          });
        } else {
          recommendedReviewsFinalized = true;
        }
        if (searchReviewsFinalized && recommendedReviewsFinalized) {
          reviewsFinalized = true;
          clearInterval();
        }
      }
    }, 1000);
  });
</script>
