{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}
{% style %}
  .image-text-overlay {
    display: block;
    width: 100%;
    position: relative;
    overflow: hidden;
  }

  .image-text-overlay__box{
    position: relative;
    width: 100%;
    min-height: {{ section.settings.section_height }}px;
    background-color: {{ section.settings.background_color }};
  }

  .image-text-overlay__image-wrapper {
    /* position: absolute;
    top: 0;
    left: 0; */
    width: 100%;
    height: 100%;
  }

  .image-text-overlay__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .image-text-overlay__image-placeholder {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .image-text-overlay__image-placeholder svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .image-text-overlay__mobile-image {
    display: none;
  }

  .image-text-overlay__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, {{ section.settings.overlay_opacity }});
  }

  .image-text-overlay__content-wrapper {
    position: absolute;
    left:0;
    top:0;
    z-index: 2;
    display: flex;
    align-items: center;
    min-height: {{ section.settings.section_height }}px;
    padding: 20px 40px;
    width:100%;
    height:100%;
  }

  .image-text-overlay__content-wrapper--left {
    justify-content: flex-start;
  }

  .image-text-overlay__content-wrapper--center {
    justify-content: center;
  }

  .image-text-overlay__content-wrapper--right {
    justify-content: flex-end;
  }

  .image-text-overlay__content {
    max-width:700px;
    width: 100%;
  }

  .image-text-overlay__content--align-left {
    text-align: left;
  }

  .image-text-overlay__content--align-center {
    text-align: center;
  }

  .image-text-overlay__content--align-right {
    text-align: right;
  }

  .image-text-overlay__eyebrow {
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 12px;
    color: {{ section.settings.text_color }};
  }

  .image-text-overlay__heading {
    margin: 0 0 16px;
  }

  .image-text-overlay__copy {
    font-size: 16px;
    line-height: 1.6;
    margin-bottom: 24px;
    color: {{ section.settings.text_color }};
  }

  .image-text-overlay__buttons {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top:30px;
  }

  .image-text-overlay__buttons--align-left {
    justify-content: flex-start;
  }

  .image-text-overlay__buttons--align-center {
    justify-content: center;
  }

  .image-text-overlay__buttons--align-right {
    justify-content: flex-end;
  }


  .image-text-overlay__button--primary {
    background-color: {{ section.settings.button_primary_bg }};
    color: {{ section.settings.button_primary_text }};
  }


  .image-text-overlay__button--secondary {
    background-color: {{ section.settings.button_secondary_bg }};
    color: {{ section.settings.button_secondary_text }};
  }

@media screen and (max-width: 800px) {
.image-text-overlay__desktop-image {
      display: none;
    }

    .image-text-overlay__mobile-image {
      display: block;
    }
    .image-text-overlay__copy p{
      margin-top:0;
      font-size:16px !important;
    }
    .image-text-overlay__content{
      height:100%;
      display: flex;
      flex-direction: column;
      align-items: end;
    }
    .image-text-overlay__content .bottom__content{
      max-width: min-content;
      float:right;
      margin-top:50px;
    }
    .image-text-overlay__heading {
      font-size: 22px;
    }
    .image-text-overlay__buttons .button{
      font-size:14px;
    }
}

  @media screen and (max-width: 749px) {
    .image-text-overlay__container {
      min-height: {{ section.settings.mobile_section_height }}px;
    }

    .image-text-overlay__content-wrapper {
      padding: 30px 20px;
      min-height: {{ section.settings.mobile_section_height }}px;
    }

    .image-text-overlay__buttons {
      flex-direction: column;
    }

    .image-text-overlay__button {
      width: 100%;
    }
  }
{% endstyle %}

<div class="image-text-overlay section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="image-text-overlay__box">
        <div class="image-text-overlay__image-wrapper">
        {% if section.settings.image %}
            <img
            src="{{ section.settings.image | image_url: width: 1240 }}"
            alt="{{ section.settings.image.alt | escape }}"
            loading="lazy"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
            class="image-text-overlay__image image-text-overlay__desktop-image"
            >
        {% else %}
            <div class="image-text-overlay__image-placeholder image-text-overlay__desktop-image">
            {{ 'image' | placeholder_svg_tag }}
            </div>
        {% endif %}

        {% if section.settings.mobile_image %}
            <img
            src="{{ section.settings.mobile_image | image_url: width: 800 }}"
            alt="{{ section.settings.mobile_image.alt | escape }}"
            loading="lazy"
            width="{{ section.settings.mobile_image.width }}"
            height="{{ section.settings.mobile_image.height }}"
            class="image-text-overlay__image image-text-overlay__mobile-image"
            >
        {% elsif section.settings.image %}
            <img
            src="{{ section.settings.image | image_url: width: 800 }}"
            alt="{{ section.settings.image.alt | escape }}"
            loading="lazy"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
            class="image-text-overlay__image image-text-overlay__mobile-image"
            >
        {% else %}
            <div class="image-text-overlay__image-placeholder image-text-overlay__mobile-image">
            {{ 'image' | placeholder_svg_tag }}
            </div>
        {% endif %}
        </div>

        <div class="image-text-overlay__overlay"></div>

        <div class="image-text-overlay__content-wrapper image-text-overlay__content-wrapper--{{ section.settings.content_position }}">
        <div class="image-text-overlay__content image-text-overlay__content--align-{{ section.settings.text_alignment }}">
            {% if section.settings.copy_text != blank %}
            <div class="image-text-overlay__copy">
                {{ section.settings.copy_text }}
            </div>
            {% endif %}
            <div class="bottom__content">
              {% if section.settings.heading != blank %}
              <h2 class="image-text-overlay__heading">
                  {{ section.settings.heading }}
              </h2>
              {% endif %}
              <div class="image-text-overlay__buttons image-text-overlay__buttons--align-{{ section.settings.text_alignment }}">
              {% if section.settings.button_1_label != blank %}
                  <a style="width:auto;"
                  href="{{ section.settings.button_1_link }}"
                  class="button image-text-overlay__button image-text-overlay__button--primary"
                  >
                  {{ section.settings.button_1_label }}
                  </a>
              {% endif %}
              {% if section.settings.button_2_label != blank %}
                  <a style="width:auto;"
                  href="{{ section.settings.button_2_link }}"
                  class="button image-text-overlay__button image-text-overlay__button--secondary"
                  >
                  {{ section.settings.button_2_label }}
                  </a>
              {% endif %}
              </div>
            </div>
        </div>
        </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Image with text overlay",
  "tag": "section",
  "class": "section-image-text-overlay",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "section_height",
      "label": "Desktop height",
      "min": 300,
      "max": 800,
      "step": 50,
      "unit": "px",
      "default": 450
    },
    {
      "type": "range",
      "id": "mobile_section_height",
      "label": "Mobile height",
      "min": 300,
      "max": 600,
      "step": 50,
      "unit": "px",
      "default": 400
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Image overlay opacity",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "default": 0.3
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image (optional)"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "richtext",
      "id": "copy_text",
      "label": "Copy text",
      "default": "<p>Understanding Breakouts Starts with Understanding Skin</p>"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Book your complimentary Skin Diagnosis"
    },
    {
      "type": "header",
      "content": "Button 1"
    },
    {
      "type": "text",
      "id": "button_1_label",
      "label": "Label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Button 2"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Label",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_primary_bg",
      "label": "Primary button background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_primary_text",
      "label": "Primary button text",
      "default": "#001E37"
    },
    {
      "type": "color",
      "id": "button_secondary_bg",
      "label": "Secondary button background",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "color",
      "id": "button_secondary_text",
      "label": "Secondary button text",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Image with text overlay"
    }
  ]
}
{% endschema %}
