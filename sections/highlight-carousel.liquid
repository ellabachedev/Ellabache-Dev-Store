<style>
  .highlight-carousel {
    padding: 2rem 0;
    overflow:hidden;
  }
  .highlight-carousel__wrapper.swiper-wrapper {
    gap: 2rem;
  }
  .highlight-carousel__container.page-width{
    max-width:112.5rem;
  }
  .highlight-carousel__header {
    text-align: center;
    max-width:850px;
    margin:0 auto;
    margin-bottom: 2rem;
  }
  .highlight-carousel__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
  }
  .highlight-carousel__link {
    display: block;
    text-decoration: none;
    position:relative;
  }
  .highlight-carousel__slide{
    width:30%;
  }
  .highlight-carousel__image-wrapper {
    position: relative;
    width: 100%;
    padding-top: 72%; /* Aspect ratio: 413x558 ≈ 0.74 */
    overflow: hidden;
  }
  .highlight-carousel__image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .highlight-carousel__heading {
    position: absolute;
    top:50%;
    left:50%;
    color: white;
    font-size: 2.5rem;
    z-index: 2;
    transform: translate(-50%, -50%);
    padding: 2rem;
    text-align: center;
    width: 100%;
  }
  .highlight-carousel__link:hover .highlight-carousel__image{
    transform: scale(1.05);
  }
  @media only screen and (max-width: 768px) {
    .highlight-carousel__heading{
      font-size:1.5rem;
    }
    .highlight-carousel__grid {
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
}
  }
</style>
<section class="highlight-carousel">
  <div class="highlight-carousel__container page-width">
    {% if section.settings.show_header %}
    <header class="highlight-carousel__header">
      {% if section.settings.section_title != blank %}
      <h2>{{ section.settings.section_title }}</h2>
      {% endif %}
      {% if section.settings.section_subtitle != blank %}
      <p>{{ section.settings.section_subtitle }}</p>
      {% endif %}
    </header>
    {% endif %}
    <div class="{% if section.settings.enable_carousel %}highlight-carousel__grid swiper-wrapper {% else %}highlight-carousel__grid {% endif %}">
        {% for block in section.blocks %}
          <div class="highlight-carousel__item {% if section.settings.enable_carousel %}swiper-slide{% endif %}">
            <a href="{{ block.settings.link }}" class="highlight-carousel__link">
              <div class="highlight-carousel__image-wrapper">
                <img src="{{ block.settings.image | image_url }}" alt="{{ block.settings.heading }}" class="highlight-carousel__image" loading="lazy">
              </div>
              <div class="highlight-carousel__heading">{{ block.settings.heading }}</div>
            </a>
          </div>
        {% endfor %}
      </div>
  </div>
</section>
{% if section.settings.enable_carousel %}
<script>
  document.addEventListener('DOMContentLoaded', function () {
    const swiper = new Swiper('.highlight-carousel__grid', {
      slidesPerView: 3,
      spaceBetween: 24,
      loop: true,
      navigation: {
        nextEl: '.swiper-button-next',
        prevEl: '.swiper-button-prev'
      }
    });
  });
</script>
{% endif %}
<script>
  document.addEventListener("DOMContentLoaded", function () {
    gsap.registerPlugin(ScrollTrigger);

    gsap.utils.toArray(".highlight-carousel__item").forEach((card, index) => {
      gsap.from(card, {
        scrollTrigger: {
          trigger: card,
          start: "top 85%",
        },
        opacity: 0,
        y: 50,
        duration: 0.6,
        delay: index * 0.1,
        ease: "power2.out"
      });
    });
  });
</script>
{% schema %}
{
  "name": "Highlight Carousel",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_carousel",
      "label": "Enable carousel",
      "default": false
    },
    {
      "type": "text",
      "id": "section_title",
      "label": "Section heading",
      "default": "We believe every Mum deserves to feel confident in her skin."
    },
    {
      "type": "textarea",
      "id": "section_subtitle",
      "label": "Section description",
      "default": "From personalised skincare to indulgent spa experiences, our treatments and limited-edition gift sets are designed to nourish, empower, and celebrate every kind of Mum"
    },
    {
      "type": "checkbox",
      "id": "show_header",
      "label": "Show header and description",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Slide heading"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Highlight Carousel",
      "category": "Custom"
    }
  ]
}
{% endschema %}