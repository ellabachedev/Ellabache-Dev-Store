{%- comment -%}
Collection Products Grid - Displays products grouped by product type/category
Uses product.type (built-in Shopify category) instead of tags
Matches Ella Baché website layout with Navy #001e37 theme
{%- endcomment -%}

<link rel="stylesheet" href="{{ 'collection-products-grid.css' | asset_url }}">

<main class="collection-products-grid" id="main" data-section-id="{{ section.id }}">
  <div class="collection-wrapper page-width">

    {%- if section.settings.show_breadcrumbs -%}
      <div class="collection-breadcrumbs crumbs">
        <a href="/">Home</a>
        <span class="breadcrumb-separator">/</span>
        <span class="breadcrumb-current">Products</span>
      </div>
    {%- endif -%}

    {%- if section.settings.show_header -%}
      <div class="collection-header">
        <h1>{{ page_title }}</h1>
        {%- if collection.description != blank -%}
          <div class="collection-description">
            {{ collection.description }}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.show_filters -%}
      <div class="collection-filter-bar fbar">
        <div class="filter-group pop">
          <button class="filter-chip fchip" aria-expanded="false" data-filter-toggle>
            <svg class="ic" viewBox="0 0 24 24" width="16" height="16">
              <path fill="currentColor" d="M3 6h18v2H3V6zm0 5h18v2H3v-2zm0 5h18v2H3v-2z"/>
            </svg>
            <span class="filter-label">Filters</span>
            <span class="filter-count car">({{ collection.products_count }})</span>
          </button>
          <div class="filter-panel panel" hidden>
            <button class="filter-opt opt">All Products</button>
            <button class="filter-opt opt">Cleansers</button>
            <button class="filter-opt opt">Serums</button>
            <button class="filter-opt opt">Moisturisers</button>
            <button class="filter-opt opt">Eye & Neck</button>
            <button class="filter-opt opt">Masks</button>
            <button class="filter-opt opt">Exfoliants</button>
            <div class="filter-progress pbar"></div>
          </div>
        </div>

        <div class="filter-spacer sp"></div>

        <span class="product-count count">
          <b>{{ collection.products_count }}</b> Products
        </span>

        <div class="filter-group pop">
          <button class="filter-chip fchip sort-btn" aria-expanded="false" data-sort-toggle>
            <svg class="ic" viewBox="0 0 24 24" width="16" height="16">
              <path fill="currentColor" d="M3 13h8v-2H3v2zm0 4h8v-2H3v2zm0-8h8V7H3v2zm13 0V7h-2v2h2zm-2 4h2v-2h-2v2zm2 4h2v-2h-2v2z"/>
            </svg>
            <span>Sort</span>
            <span class="car"></span>
          </button>
          <div class="filter-panel panel sort-panel" hidden>
            <button class="filter-opt opt on">Featured</button>
            <button class="filter-opt opt">Best Selling</button>
            <button class="filter-opt opt">Newest</button>
            <button class="filter-opt opt">Price: Low to High</button>
            <button class="filter-opt opt">Price: High to Low</button>
          </div>
        </div>
      </div>
    {%- endif -%}

    {%- if collection.products_count > 0 -%}
      {%- comment -%}
        Group products by product type (category)
        Product types should match: Cleansers, Serums, Moisturisers, Eye & Neck, Masks, Exfoliants, Suncare, Tanning, Bodycare, Treatment Products
      {%- endcomment -%}

      {%- assign category_order = "Cleansers,Serums,Moisturisers,Eye & Neck,Masks,Exfoliants,Suncare,Tanning,Bodycare,Treatment Products" | split: "," -%}
      {%- assign all_types = "" | split: "" -%}
      {%- assign any_categorized = false -%}

      {%- for product in collection.products -%}
        {%- if product.type != blank and product.type != "" -%}
          {%- assign any_categorized = true -%}
          {%- unless all_types contains product.type -%}
            {%- assign all_types = all_types | push: product.type -%}
          {%- endunless -%}
        {%- endif -%}
      {%- endfor -%}

      {%- if any_categorized -%}
        {%- comment -%}
          Display products grouped by product type in predefined order
        {%- endcomment -%}
        {%- assign section_count = 0 -%}
        {%- for category in category_order -%}
          {%- assign category_products = collection.products | where: "type", category -%}

          {%- if category_products.size > 0 -%}
            {%- assign section_count = section_count | plus: 1 -%}
            {%- assign alternate_bg = section_count | modulo: 2 -%}

            <section class="category-section sec tgroup {% if alternate_bg == 1 %}category-section--alternate sand{% endif %}" id="{{ category | handleize }}">
              <div class="category-wrap wrap">
                <h2 class="category-heading">
                  <a href="{{ collection.url }}">{{ category }}</a>
                </h2>

                <div class="products-grid grid pgrid">
                  {%- for product in category_products limit: 8 -%}
                    <a href="{{ product.url }}" class="product-card tc">
                      <div class="product-card-image media">
                        {%- if product.featured_image -%}
                          <img
                            src="{{ product.featured_image | image_url: width: 500 }}"
                            alt="{{ product.featured_image.alt | escape }}"
                            loading="lazy"
                            width="500"
                            height="500">
                        {%- else -%}
                          <div class="placeholder-image">No Image</div>
                        {%- endif -%}
                      </div>
                      <div class="product-card-content bd">
                        <h3 class="product-card-title t">{{ product.title }}</h3>
                        {%- if product.metafields.global.prod_size -%}
                          <div class="product-card-meta m">{{ product.metafields.global.prod_size }}</div>
                        {%- endif -%}
                        <div class="product-card-price cs">
                          <span class="price">{{ product.price | money }}</span>
                          {%- if product.compare_at_price > product.price -%}
                            <span class="compare-price">{{ product.compare_at_price | money }}</span>
                          {%- endif -%}
                        </div>
                      </div>
                    </a>
                  {%- endfor -%}
                </div>

                {%- if category_products.size > 8 -%}
                  <div class="category-footer">
                    <a href="{{ collection.url }}" class="view-all-link bk ghost">
                      View all {{ category }}
                    </a>
                  </div>
                {%- endif -%}
              </div>
            </section>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {%- comment -%}
          No product types set - display all products in a single grid
          NOTE: Set product types in Shopify admin for proper categorization
        {%- endcomment -%}
        <div class="no-categories-notice">
          <p>Note: Products are not categorized. Please set product types in Shopify admin.</p>
        </div>

        <section class="category-section sec">
          <div class="category-wrap wrap">
            <h2 class="category-heading">All Products</h2>
            <div class="products-grid grid pgrid">
              {%- for product in collection.products -%}
                <a href="{{ product.url }}" class="product-card tc">
                  <div class="product-card-image media">
                    {%- if product.featured_image -%}
                      <img
                        src="{{ product.featured_image | image_url: width: 500 }}"
                        alt="{{ product.featured_image.alt | escape }}"
                        loading="lazy"
                        width="500"
                        height="500">
                    {%- else -%}
                      <div class="placeholder-image">No Image</div>
                    {%- endif -%}
                  </div>
                  <div class="product-card-content bd">
                    <h3 class="product-card-title t">{{ product.title }}</h3>
                    {%- if product.metafields.global.prod_size -%}
                      <div class="product-card-meta m">{{ product.metafields.global.prod_size }}</div>
                    {%- endif -%}
                    <div class="product-card-price cs">
                      <span class="price">{{ product.price | money }}</span>
                      {%- if product.compare_at_price > product.price -%}
                        <span class="compare-price">{{ product.compare_at_price | money }}</span>
                      {%- endif -%}
                    </div>
                  </div>
                </a>
              {%- endfor -%}
            </div>
          </div>
        </section>
      {%- endif -%}

    {%- else -%}
      <div class="collection-empty">
        <p>No products found in this collection.</p>
      </div>
    {%- endif -%}

  </div>
</main>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const filterChips = document.querySelectorAll('[data-filter-toggle], [data-sort-toggle]');

    filterChips.forEach(chip => {
      chip.addEventListener('click', function(e) {
        e.preventDefault();
        const panel = this.nextElementSibling;
        const isExpanded = this.getAttribute('aria-expanded') === 'true';

        // Close other panels
        filterChips.forEach(otherChip => {
          if (otherChip !== this) {
            otherChip.setAttribute('aria-expanded', 'false');
            const otherPanel = otherChip.nextElementSibling;
            if (otherPanel) {
              otherPanel.hidden = true;
            }
          }
        });

        // Toggle this panel
        this.setAttribute('aria-expanded', !isExpanded);
        if (panel) {
          panel.hidden = isExpanded;
        }
      });
    });

    // Close panels when clicking outside
    document.addEventListener('click', function(e) {
      if (!e.target.closest('.filter-group') && !e.target.closest('[data-filter-toggle]') && !e.target.closest('[data-sort-toggle]')) {
        filterChips.forEach(chip => {
          chip.setAttribute('aria-expanded', 'false');
          const panel = chip.nextElementSibling;
          if (panel) {
            panel.hidden = true;
          }
        });
      }
    });
  });
</script>

{% schema %}
{
  "name": "Collection Products Grid",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "Show breadcrumbs",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_header",
      "label": "Show collection heading and description",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_filters",
      "label": "Show filter bar",
      "default": true
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "unit": "col",
      "label": "Grid columns (desktop)",
      "default": 4
    }
  ]
}
{% endschema %}
