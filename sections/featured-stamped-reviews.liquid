<style>
  .stamped-reviews #stamped-reviews-widget{
    font-family:Helvetica Neue;
    max-width:112.5rem !important;
    padding:0 30px;
  }
  @media screen and (max-width:767px) {
    .stamped-reviews #stamped-reviews-widget{
      padding:0 15px;
    }
  }
  .stamped-reviews{
    margin-bottom: 3.5rem;
    margin-top: 3.5rem;
  }
  .stamped-reviews #stamped-reviews-widget[data-widget-type=carousel]{
    max-width:112.5rem !important;
  }
  .stamped-reviews #stamped-reviews-widget[data-widget-type=carousel] .stamped-carousel-scroll{
    position:relative;
    overflow:hidden;
  }
  .stamped-reviews #stamped-reviews-widget[data-widget-type=carousel] .stamped-carousel-scroll .block{
    padding-bottom:0;
    position:relative;
    padding-right:2.188rem;
  }
  @media screen and (max-width: 690px) {
    .stamped-reviews #stamped-reviews-widget[data-widget-type=carousel] .stamped-carousel-scroll .block{
      padding-right:0;
    }
  }
  .stamped-reviews #stamped-reviews-widget[data-widget-type=carousel] .stamped-carousel-scroll .block .stamped-ratings-wrapper{
    background-color:#f7f7f7;
    padding:2.188rem;
    /*width:calc(33% - 2.188rem) !important;*/
    position:relative;
    height:100%;
  }
  .stamped-reviews #stamped-reviews-widget[data-widget-type=carousel] .stamped-ratings-wrapper{
    display: flex;
    flex-direction:column;
    padding:0;
    position:relative;
  }
  .stamped-reviews #stamped-reviews-widget[data-widget-type=carousel] .stamped-carousel-scroll-wrapper{
    /*display:flex;
    gap: 2.188rem;*/
  }
  .stamped-reviews #stamped-reviews-widget[data-widget-type=carousel] .stamped-carousel-scroll:before{
    display:none;
  }
  .stamped-reviews #stamped-reviews-widget[data-widget-type=carousel] .stamped-carousel-scroll .stamped-reviews-title{
    width:480px;
    display:none;
    font-weight:normal;
    font-size:1rem;
    margin-top:0;
    margin-bottom:10px;
  }
  .stamped-reviews #stamped-reviews-widget[data-widget-type=carousel] .stamped-carousel-title{
    font-size:1.5rem;
    font-weight:normal;
  }
  @media (min-width: 769px) {
    .stamped-reviews #stamped-reviews-widget[data-widget-type=carousel] .stamped-carousel-title{
      font-size:2.5rem;
    }
  }
  .stamped-reviews #stamped-reviews-widget[data-widget-type=carousel] .stamped-carousel-title, 
  .stamped-reviews #stamped-reviews-widget[data-widget-type=carousel] .stamped-carousel-subtitle{
    float:none;
  }
  .stamped-reviews #stamped-reviews-widget[data-widget-type=carousel] .stamped-carousel-subtitle{
    margin-bottom:20px;
  }
  .stamped-reviews #stamped-reviews-widget[data-widget-type=carousel] .stamped-carousel-scroll .stamped-reviews-image{
    display:none;
  }
  .stamped-reviews #stamped-reviews-widget[data-widget-type=carousel] .stamped-carousel-scroll .stamped-reviews-message{
    padding:0;
    margin:0;
  }
  .stamped-reviews #stamped-reviews-widget[data-widget-type=carousel] .stamped-reviews-date{
    position:absolute;
    right:4rem;
    bottom:20px;
    padding:0;
    margin:0;
    z-index:2;
  }
  .stamped-reviews .stamped-fa:before {
    color: #8cd3d7 !important;
  }
  .stamped-reviews #stamped-reviews-widget[data-widget-type=carousel] .stamped-carousel-scroll .stamped-reviews-message-block{
    font-family:Helvetica Neue;
    font-style:normal;
    line-height:1.3;
    max-height:91px;
    overflow-y:auto;
  }
  .stamped-reviews #stamped-reviews-widget[data-widget-type=carousel] .stamped-carousel-scroll .stamped-reviews-author{
    margin-left:0;
    font-weight:normal;
    margin-top:0;
    font-size:1.5rem;
    padding-right:95px;
    margin-bottom:20px;
  }
  .stamped-reviews .stamped-reviews-author{
    order:1;
  }
  .stamped-reviews .stamped-reviews-rating{
    order:2;
    position:absolute;
    right: 2.188rem;
    top: 1.688rem;
  }
   @media screen and (max-width: 768px) {
    .stamped-reviews .stamped-reviews-rating{position:static;}
    .stamped-reviews #stamped-reviews-widget[data-widget-type=carousel] .stamped-carousel-scroll .stamped-reviews-author{margin-bottom:0;}
  }
  .stamped-reviews .stamped-reviews-title{
     order:3;
  }
  .stamped-reviews .stamped-reviews-message{
     order:4;
  }
  .shopapp-verified{
    padding-top:0 !important;
  }
  @media screen and (max-width: 690px) {
    .stamped-reviews #stamped-reviews-widget[data-widget-type=carousel] {
        width: 100%;
    }
    .stamped-reviews #stamped-reviews-widget[data-widget-type=carousel] .stamped-carousel-scroll .stamped-reviews-author{
      margin-left:0 !important;
    }
    .stamped-reviews #stamped-reviews-widget[data-widget-type=carousel] .stamped-carousel-scroll .stamped-reviews-message{
      margin-left:0 !important;
    }
  }
  .stamped-carousel-buttons .stamped-carousel-button-left{
    position:absolute;
    left:0;
    top:50%;
    z-index:3;
  }
  .stamped-carousel-buttons .stamped-carousel-button-right{
    position:absolute;
    right:0;
    top:50%;
    z-index:3;
  }
  .stamped-carousel-button-left:before,
  .stamped-carousel-button-left:after
  {
    content: "" !important;
    height: 2px;
    width: 20px;
    background-color: #001e37;
    position: absolute;
    left: 4px;
    top: 0;
  }
  .stamped-carousel-button-right:before,
  .stamped-carousel-button-right:after
  {
    content: "" !important;
    height: 2px;
    width: 20px;
    background-color: #001e37;
    position: absolute;
    right: 4px;
    top: 0;
  }
  .stamped-carousel-button-left:before {
    transform: rotate(45deg);
    top: 20px;
  }
  .stamped-carousel-button-left:after {
    transform: rotate(-45deg);
    top:7px;
  }
  .stamped-carousel-button-right:before {
    transform: rotate(-45deg);
    top: 20px;
  }
  .stamped-carousel-button-right:after {
    transform: rotate(45deg);
    top: 7px;
  }
</style>
<div id="stamped-reviews-widget"
  data-widget-type="carousel" 
  data-title="Customer Reviews" 
  data-auto-play="false" 
  data-take="15"  
  data-rating-all="4.91">
</div>
{% schema %}
  {
    "name": "Featured Stamped Reviews",
    "class": "stamped-reviews",
    "disabled_on": {
    "groups": ["header", "footer"]
    },
    "settings": [],
    "presets": [
      {
        "name": "Featured Stamped Reviews"
      }
    ]
  }
{% endschema %}