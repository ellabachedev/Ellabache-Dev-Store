{% schema %}
  {
    "name": "Collection Card Grid",
    "tag": "section",
    "class": "section",
    "settings": [
      {
        "type": "textarea",
        "id": "title",
        "label": "Title"
      }, {
        "type": "header",
        "content": "t:sections.all.padding.section_padding_heading"
      }, {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_top",
        "default": 56
      }, {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_bottom",
        "default": 56
      }
    ],
    "blocks": [
      {
        "type": "card",
        "name": "Card",
        "settings": [
          {
            "type": "image_picker",
            "id": "image",
            "label": "Image",
            "info": "800x800"
          }, {
            "type": "text",
            "id": "title",
            "label": "Card Title"
          }, {
            "type": "textarea",
            "id": "description",
            "label": "Description"
          }, {
            "type": "url",
            "id": "link",
            "label": "Link"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Collection Card Grid",
        "category": "Custom",
        "blocks": [
          {
            "type": "card"
          }, {
            "type": "card"
          }, {
            "type": "card"
          }
        ]
      }
    ]
  }
{% endschema %}
{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}
<style>
  .collection-card-grid__wrapper .page-width {
    max-width: 180rem;
  }
  .collection-card-grid__wrapper h2 {
    margin-top: 0;
  }
  .collection-card-grid__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }
  .collection-card-grid__item {
    background: #fff;
    transition: all 0.3s ease-in-out;
    cursor: pointer;
  }
  .collection-card-grid__item:hover img {
    transform: translateY(-5px);
    border-color: #ef476f;
  }
  .collection-card-grid__image-wrapper {
    overflow: hidden;
  }
  .collection-card-grid__image {
    width: 100%;
    max-height: 465px;
    object-fit: cover;
    height: auto;
    transition: transform 0.3s ease;
    display: block;
  }
  .collection-card-grid__item:hover .collection-card-grid__image {
    transform: scale(1.05);
  }
  .collection-card-grid__title {
    font-size: 2rem;
    margin-top: 1.6rem;
  }
  .collection-card-grid__item .collection-card-grid__description:last-child {
    margin-bottom: 0;
  }
  .collection-card-grid__cta {
    margin-top: 4rem;
    text-align: center;
  }
  .collection-card-grid__button {
    background-color: #0b1d3a;
    color: #fff;
    padding: 0.95rem 2rem;
    text-transform: uppercase;
    font-size: 0.875rem;
    display: inline-block;
    text-decoration: none;
    transition: background-color 0.3s ease;
  }
  @media only screen and (max-width: 768px) {
    .collection-card-grid__button {
      width: 100%;
    }
  }
  .collection-card-grid__placeholder {
    background-color: #ddd;
    height: 200px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-style: italic;
    color: #888;
  }
  @media (max-width: 768px) {
    .collection-card-grid__grid {
      display: flex;
      overflow-x: auto;
      gap: 16px;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      padding: 0 10px;
    }

    .collection-card-grid__item {
      flex: 0 0 80%;
      scroll-snap-align: start;
      border-radius: 12px;
      background: #fff;
    }
    .collection-card-grid__grid::-webkit-scrollbar {
      display: none;
    }
    .collection-card-grid__wrapper h2 {
    font-size;
    24px;
  }
}
</style>
<div class="collection-card-grid__wrapper section-{{ section.id }}-padding">
  <div class="page-width">
    {% if section.settings.title != blank %}
      <h2 class="h1 collection-card-grid__heading">{{ section.settings.title }}</h2>
    {% endif %}

    <div class="collection-card-grid__grid">
      {% for block in section.blocks %}
        <div class="collection-card-grid__item" {{ block.shopify_attributes }}>
          <div class="collection-card-grid__image-wrapper">
            {% if block.settings.image != blank %}
              <img
                class="collection-card-grid__image"
                src="{{ block.settings.image | image_url: width: 700 }}"
                loading="lazy"
                alt="{{ block.settings.title | escape }}">
            {% endif %}
          </div>
          <div class="collection-card-grid__content">
            {% if block.settings.title != blank %}
              <h3 class="collection-card-grid__title">
                {% if block.settings.link != blank %}
                  <a href="{{ block.settings.link }}">{{ block.settings.title }}</a>
                {% else %}
                  {{ block.settings.title }}
                {% endif %}
              </h3>
            {% endif %}

            {% if block.settings.description != blank %}
              <p class="collection-card-grid__description">{{ block.settings.description }}</p>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>