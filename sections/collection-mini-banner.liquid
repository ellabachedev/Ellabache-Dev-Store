<style>
  #MainContent{
  position:relative;
  }
  .collection_banner {
    position: relative;
    overflow: hidden;
    padding-top: 40px;
    padding-bottom: 40px;
    height:327px;
    background-color:#f8f8f8;
  }
  .collection_banner .banner_image {
    position: absolute;
    left: 0;
    top: 0;
    height: 100%;
    width: 100%;
  }
  .collection_banner.only-image {
    padding:0;
    height: auto;
    background-color:transparent;
  }
  .collection_banner.only-image  .banner_content h1{
    font-size:22px;
    margin-top:20px;
    text-transform:unset;
    font-weight:400;
    line-height:normal;
  }
  .collection_banner.only-image  .banner_content h1 span{
  font-size:14px;}
  .collection_banner.only-image .banner_image{
    position:static;
    height:auto;
  }
  .collection_banner .banner_image figure{
    display:block;
  }
  .collection_banner .banner_image img {
    width: 100%;
    object-fit: cover;
    display: block;
    height: 100%;
    object-position: right;
    /*
   height: 325px; 
   
*/
  }
  .collection_banner.only-image .banner_image img{
    height:auto;
  }
  .collection_banner .banner_content {
    position: relative;
    z-index:2;
    {% comment %} left: 0;
    top: 50%;
    transform: translateY(-50%); {% endcomment %}
    height:100%;
    width: 100%;
  }
  .collection_banner .banner_content.flex-container{
    height:100%; 
    flex-direction:row; 
    justify-content:flex-start;
    overflow-y:auto;
    align-items:center;
  }
  .collection_banner .text-wrapper .rte, .collection_banner .text-wrapper  .separator {
    max-width: 600px;
    width: 100%;
  }
  .collection_banner .text-wrapper h1 {
    font-size: 45px;
    font-weight: 600;
    line-height: 1.1;
    margin:0;
    text-transform:uppercase;
  }
  .collection_banner .text-wrapper p.sec-title {
    margin-bottom: 5px;
    font-size: 14px;
    max-width:600px;
  }
  @media only screen and (max-width: 768px) {
      .collection_banner .text-wrapper p.sec-title {
      font-size: 12px;}
  }
  .collection_banner .text-wrapper .separator {
    margin-bottom: 12px;
    height: 3px;
    width: 100%;
  }
  .collection_banner .text-wrapper .rte{
  margin-top:35px;}
  .collection_banner .text-wrapper .rte,   .collection_banner .text-wrapper .rte p{
    font-size: 16px;
    line-height:1.3;
    
  }
  .collection_banner .text-wrapper .button {
    margin-top: 15px;
  }
  .collection_banner.no-banner-img {
    height: 300px;
    background-color: #f7f7f7;
    transition: height 0.8s ease;
  }
  @media only screen and (max-width: 768px) {
    .collection_banner .text-wrapper h1 {
      font-size: 28px;
    }
    .collection_banner .text-wrapper .rte {
      font-size: 12px;
    }
    .collection_banner .banner_image img {
      height: 100%;
      object-fit: cover;
      object-position:left;
    }
  }
  {{ collection.metafields.accentuate.custom_css_code }}
  /* Offer under the banner image: quiet centred band in the theme's style (navy, thin rules, small caps) */
  .cmb-offer {
    padding: 28px 16px 30px;
    border-bottom: 1px solid #f0f0f0;
    text-align: center;
  }
  .cmb-offer__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    max-width: 760px;
    margin: 0 auto;
  }
  .cmb-offer__label {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin: 0 0 12px;
    color: #001e37;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 1.6px;
    line-height: 1.3;
    text-transform: uppercase;
  }
  .cmb-offer__label::before,
  .cmb-offer__label::after {
    content: "";
    width: 28px;
    height: 1px;
    background: #b9c0c9;
  }
  .cmb-offer__copy {
    margin: 0;
    color: #001e37;
    font-size: 15px;
    font-weight: 400;
    line-height: 1.6;
  }
  .cmb-offer__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 28px;
    border: 1px solid #001e37;
    background: transparent;
    color: #001e37;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 1px;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .cmb-offer__cta svg {
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .cmb-offer__cta:hover {
    background: #001e37;
    color: #ffffff;
  }
  .cmb-offer__cta:focus-visible {
    outline: 2px solid #001e37;
    outline-offset: 2px;
  }
  @media (min-width: 769px) {
    .cmb-offer {
      padding: 40px 20px 42px;
    }
    .cmb-offer__copy {
      font-size: 17px;
    }
  }
  .collection-banner-nav-wrapper{
    background-color:#fccebc;
    margin-top:0;
    padding:10px 0;
  }
  .collection-banner-nav-wrapper .collection-banner-buttons{
  margin:0;
  }
  .collection-banner-nav-wrapper .collection-banner-buttons .btn{
    font-size: 14px;
    letter-spacing: 0.23px;
    padding: 5px 10px;
    text-align: center;
    color:#001E37;
    background-color: #ffffff;
    border: 1px solid #ffffff;
  }
  .collection-banner-nav-wrapper .collection-banner-buttons .btn.active{
    background-color: #8B4063;
    border: 1px solid #8B4063;
    color: #ffffff;
  }
</style>
<section
  class="collection_banner 
  {% if collection.image == blank and collection.metafields.accentuate.collection_mini_banner_image_desktop == blank %} no-banner-img {% endif %}
  {% if collection.metafields.accentuate.collection_mini_banner_image_desktop != blank %} only-image {% endif %}"
  {% if collection.image == blank and collection.metafields.accentuate.collection_mini_banner_image_desktop == blank %}
  style="{% if collection.metafields.accentuate.banner_background_color != blank %}background-color:{{ collection.metafields.accentuate.banner_background_color }};
    {% else %}background-color: #ffefe5;
    {% endif %}"
  {% endif %}>
  {%- if collection.metafields.accentuate.collection_mini_banner_image_desktop != blank -%}
    {% assign desktop_image = collection.metafields.accentuate.collection_mini_banner_image_desktop %}
    {% assign mobile_image  = collection.metafields.accentuate.collection_mini_banner_image_mobile %}
    <div class="banner_image">
      <picture>
        <source media="(min-width: 768px)" srcset="{{ desktop_image }}">
        <img src="{{ mobile_image }}" alt="{{ collection.title | escape }}" loading="lazy" width="750" height="250" sizes="100vw">
      </picture>
    </div>
    {%- if collection.metafields.accentuate.collection_mini_banner_title != blank -%}
      {%- comment -%} Offer text under the banner image: readable body text + a button down to the products (not a heading) {%- endcomment -%}
      <div class="cmb-offer">
        <div class="cmb-offer__inner">
          <div class="cmb-offer__text">
            {%- if section.settings.offer_label != blank -%}
              <p class="cmb-offer__label">
                {{ section.settings.offer_label | escape }}
              </p>
            {%- endif -%}
            <p class="cmb-offer__copy">{{ collection.metafields.accentuate.collection_mini_banner_title }}</p>
          </div>
          {%- if section.settings.offer_button_label != blank -%}
            <a class="cmb-offer__cta" href="{{ section.settings.offer_button_link | default: '#main' }}" data-cmb-offer-cta>
              {{ section.settings.offer_button_label | escape }}
              <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false"><path d="M8 3v10M3.5 8.5 8 13l4.5-4.5"/></svg>
            </a>
            <script>
              /* "Shop now" to a spot on this page: a gentle eased scroll (~0.9s) instead of a jump.
                 Skipped for reduced motion, other pages' links and modified clicks. */
              (function () {
                var cta = document.querySelector('[data-cmb-offer-cta]');
                if (!cta) return;
                cta.addEventListener('click', function (event) {
                  var hash = cta.getAttribute('href') || '';
                  if (hash.charAt(0) !== '#' || event.metaKey || event.ctrlKey || event.shiftKey) return;
                  var target = document.getElementById(hash.slice(1));
                  if (!target || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
                  event.preventDefault();
                  var offset = parseFloat(getComputedStyle(target).scrollMarginTop) || 0;
                  var start = window.scrollY;
                  var distance = target.getBoundingClientRect().top - offset;
                  var duration = 900;
                  var began = null;
                  function ease(t) { return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2; }
                  function step(now) {
                    if (began === null) began = now;
                    var t = Math.min((now - began) / duration, 1);
                    window.scrollTo(0, start + distance * ease(t));
                    if (t < 1) requestAnimationFrame(step);
                    else history.replaceState(null, '', hash);
                  }
                  requestAnimationFrame(step);
                });
              })();
            </script>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
    {%- else -%}
      {%- if collection.image != blank -%}
      <div class="banner_image">
        <img
          src="{{ collection.image | img_url: '1280x' }}"
          srcset="{{ collection.image | img_url: '1900x' }} 1900w,
                {{ collection.image | img_url: '1400x' }} 1400w,
                {{ collection.image | img_url: '990x' }} 990w,
                {{ collection.image | img_url: '750x' }} 750w, 
                {{ collection.image | img_url: '480x' }} 480w"
          alt="{{ collection.image.alt | escape }}"
          sizes="100vw"
          width="1900"
          height="325" />
      </div>
      {%- endif -%}
  {%- endif -%}
  {%- if collection.image != blank -%}
    {%- if collection.handle == 'treatment' -%}
      <a style="position:absolute; left:0; top:0; width:100%; height:100%;" href="https://www.ellabache.com.au/pages/find-exclusive-salons"></a>
    {%- endif -%}
  {%- endif -%}
  {%- if collection.metafields.accentuate.hide_banner_content != 'true' -%}
  <div class="banner_content text-wrapper flex-container">
    <div class="page-width">
      {%- if collection.metafields.accentuate.banner_primary_title != blank -%}
        <h1 style="{%- if collection.metafields.accentuate.banner_font_color != blank -%} color:{{ collection.metafields.accentuate.banner_font_color }}; {%- endif -%}">{{ collection.metafields.accentuate.banner_primary_title }}</h1>
      {%- else -%}
        <h1 style="{%- if collection.metafields.accentuate.banner_font_color != blank -%} color:{{ collection.metafields.accentuate.banner_font_color }}; {%- endif -%}">{{ collection.title }}</h1>
      {%- endif -%}
      {%- if collection.metafields.accentuate.primary_title_separator_color != blank -%}
        <div class="separator" style="background-color:{{ collection.metafields.accentuate.primary_title_separator_color }};"></div>
      {%- endif -%}
      {%- if collection.metafields.accentuate.banner_secondary_title != blank -%}
        <p class="sec-title" style="{%- if collection.metafields.accentuate.banner_font_color != blank -%} color:{{ collection.metafields.accentuate.banner_font_color }}; {%- endif -%}">{{ collection.metafields.accentuate.banner_secondary_title }}</p>
      {%- endif -%}
      {%- if collection.metafields.accentuate.banner_text != blank -%}
        <div class="rte" style="color:{{ collection.metafields.accentuate.banner_font_color }};">{{ collection.metafields.accentuate.banner_text }}</div>
      {%- else -%}
        {%- if collection.description != blank -%}
          <div class="rte" style="{%- if collection.metafields.accentuate.banner_font_color != blank -%} color:{{ collection.metafields.accentuate.banner_font_color }}; {%- endif -%}">
            {{ collection.description }}
          </div>
        {%- endif -%}
      {%- endif -%}
    
      {%- if collection.metafields.accentuate.collection_banner_button_text != blank -%}
        <style>
          .collection-banner-buttons{
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            overflow: auto;
            margin-top:15px;
          }
          .collection-button-scroll {
            display: flex;
            flex-wrap: wrap;
            padding: 0 var(--page-padding);
            gap:5px;
          }
          .collection_banner .btn {
            color:#001E37;
            font-size:14px;
            letter-spacing:0.23px;
            padding:5px 10px;
            text-align:center;
          }
          .collection_banner .btn.btn--secondary{
            background-color:#ffffff;
            border:1px solid #ffffff;
          }
          .collection_banner .btn:hover, .collection_banner .btn.active{
            background-color:#8B4063;
            border:1px solid #8B4063;
            color:#ffffff;
          }
          @media (max-width: 1023px) {
              .collection-button-scroll {
                  flex-wrap: nowrap;
                  padding: 0 var(--page-padding);
              }
          }
        </style>
        <div class="collection-banner-buttons">
          <div class="collection-button-scroll">
          {% assign current_path = request.path %}
          {%- assign index = 0 -%}
          {%- for collectionBannerButton in collection.metafields.accentuate.collection_banner_button_text -%}
            <a href="{{ collection.metafields.accentuate.collection_banner_button_link[index] }}" class="banner-button btn btn--secondary {% if collection.metafields.accentuate.collection_banner_button_link[index] == current_path %}active{% endif %}">
              {{ collection.metafields.accentuate.collection_banner_button_text[index] }}
            </a>
            {%- assign index = index | plus: 1 -%}
          {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
  {%- endif -%}
</section>
{%- if section.settings.show_breadcrumb_nav -%}
  {% include 'breadcrumbs' %}
{%- endif -%}
{%- if collection.metafields.accentuate.collection_banner_button_text != blank -%}
<div class="collection-banner-nav-wrapper" style="display:none;">
  <div class="page-width">
    <div class="collection-banner-buttons">
      <div class="collection-button-scroll">
      {% assign current_path = request.path %}
      {%- assign index = 0 -%}
      {%- for collectionBannerButton in collection.metafields.accentuate.collection_banner_button_text -%}
        <a href="{{ collection.metafields.accentuate.collection_banner_button_link[index] }}" class="banner-button btn btn--secondary {% if collection.metafields.accentuate.collection_banner_button_link[index] == current_path %}active{% endif %}">
          {{ collection.metafields.accentuate.collection_banner_button_text[index] }}
        </a>
        {%- assign index = index | plus: 1 -%}
      {%- endfor -%}
      </div>
    </div>
  </div>
</div>
<script>
  $(document).ready(function () {
  $(window).on('scroll', function () {
    if ($(this).scrollTop() >= 300) {
      $("header.site-header .collection-banner-nav-wrapper").slideDown();
    } else {
      $("header.site-header .collection-banner-nav-wrapper").css('display', 'none');
    }
  });
  var collectionBannerNav = $('.collection-banner-nav-wrapper').clone();
  $('header.site-header').append(collectionBannerNav);
});
</script> 
{%- endif -%}
{% schema %}
  {
    "name": "Collection Mini Banner",
    "templates": ["collection"],
    "class": "collection-mini-banner",
    "settings": [
      {
        "type": "checkbox",
        "id": "show_breadcrumb_nav",
        "label": "Show breadcrumb navigation"
      },
      {
        "type": "header",
        "content": "Offer text under the banner image"
      },
      {
        "type": "paragraph",
        "content": "The offer text itself comes from the collection's \"Collection mini banner title\" field."
      },
      {
        "type": "text",
        "id": "offer_label",
        "label": "Small label above the offer",
        "default": "Gift with purchase"
      },
      {
        "type": "text",
        "id": "offer_button_label",
        "label": "Button text",
        "info": "Leave empty to hide the button.",
        "default": "Shop now"
      },
      {
        "type": "url",
        "id": "offer_button_link",
        "label": "Button link",
        "info": "Leave empty to scroll down to the products."
      }
    ],
    "presets": [
      {
        "name": "Collection Mini Banner"
      }
    ]
  }
{% endschema %}
