{%- if section.settings.enable_announcement_bar2 != blank -%}
<link rel="stylesheet" href="{{ 'component-announcement-bar2.css' | asset_url }}">
{%- capture announcementBar2 -%}
<div class="announcement-bar2" role="region" style="background-color: {{ section.settings.bg_color }}; ">
  {% if section.settings.link != blank %}
  <a href="{{ section.settings.link }}" style="color: {{ section.settings.font_color }};">
    {%- endif -%}
    <p style="color: {{ section.settings.font_color }};">
      <svg xmlns="http://www.w3.org/2000/svg" width="23.693" height="25.298" viewBox="0 0 23.693 25.298">
         <path id="Call-Phone-Icon-ei3jdf"
            d="M45.607,3.15,41.889,9.522a1.593,1.593,0,0,0,.682,2.08c1.37.811,3.732.161,3.126,2.307A13.368,13.368,0,0,1,42.842,18.8a13.3,13.3,0,0,1-4.556,3.36c-2.061.83-1.665-1.594-2.612-2.877a1.582,1.582,0,0,0-2.135-.461L27.61,23.2c-1.269,1.417,1.523,3.655,1.523,3.655,3.24,2.926,11.4.082,16.466-5.558s7.029-14.083,3.792-17.01c0,0-2.514-2.552-3.784-1.136"
            transform="translate(-27.279 -2.722)" />
      </svg>
      {{ section.settings.text}}</p>
    {%- if section.settings.link != blank -%}
  </a>
  {%- endif -%}
  <span class="close"></span>
</div>
{%- endcapture -%}
{{ announcementBar2 | strip_newlines }}
<script src="{{ 'announcement-bar2.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
{% schema %}
  {
   "name":"Announcement Bar 2",
   "settings":[
      {
         "type":"checkbox",
         "id":"enable_announcement_bar2",
         "label":"Enable Announcement Bar",
         "default":true
      },
      {
         "type":"text",
         "id":"text",
         "label":"Text"
      },
      {
         "type":"url",
         "id":"link",
         "label":"Link"
      },
      {
         "type":"color",
         "id":"bg_color",
         "label":"Background Color",
         "default":"#ddd"
      },
      {
         "type":"color",
         "id":"font_color",
         "label":"Font color",
         "default":"#000"
      }
   ]
  }
{% endschema %}