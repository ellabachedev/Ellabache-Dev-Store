{{ 'salon-promo.css' | asset_url | stylesheet_tag }}
<section class="banner banner--mini">
  <div class="banner__image">
    <picture>
      {%- if section.settings.desktop_image != blank -%}
        <source media="(min-width: 768px)" srcset="{{ section.settings.desktop_image | image_url }}">
      {%- endif -%}
      {%- if section.settings.mobile_image != blank -%}
        <img src="{{ section.settings.mobile_image | image_url }}" alt="{{ section.settings.banner_alt | escape }}">
      {%- endif -%}
    </picture>
  </div>
</section>
{%- if section.settings.show_breadcrumbs %}
  {% render 'breadcrumbs' -%}
{%- endif -%}
<div class="find-a-salon">
  <div class="page-width">
    <h1 class="find-a-salon__title">{{ section.settings.heading }}</h1>
    {%- if section.settings.subheading != blank -%}
      <p class="find-a-salon__subtitle">
        {{ section.settings.subheading }}
      </p>
    {%- endif -%}
    <ul class="find-a-salon__list">
      {% comment %} 
        {%- for block in section.blocks -%}
        <li> 
        <a href="{{ block.settings.link }}" data-salon="{{ block.settings.title | escape }}" class="salon-promo-link"> 
        {{ block.settings.title }} 
        </a>
        </li>
        {%- endfor -%} 
      {% endcomment %}
