{% schema %}
  {
    "name": "Salon Promotion Landing",
    "settings": [
      {
        "type": "image_picker",
        "id": "desktop_image",
        "label": "Banner desktop image"
      },
      {
        "type": "image_picker",
        "id": "mobile_image",
        "label": "Banner mobile image"
      },
      {
        "type": "text",
        "id": "banner_alt",
        "label": "Banner alt text",
        "default": "Salon Promotion"
      },
      {
        "type": "text",
        "id": "heading",
        "label": "Page heading",
        "default": "Find a Participating Salon Near You"
      }, {
        "type": "textarea",
        "id": "subheading",
        "label": "Promo description",
        "default": "Select a participating salon below to redeem this exclusive offer."
      }, {
        "type": "checkbox",
        "id": "show_breadcrumbs",
        "label": "Show breadcrumbs",
        "default": false
      }
    ],
    "blocks": [
      {
        "type": "salon",
        "name": "Salon",
        "settings": [
          {
            "type": "text",
            "id": "title",
            "label": "Salon name"
          }, {
            "type": "url",
            "id": "link",
            "label": "Salon page URL"
          }
        ]
      }
    ],
    "max_blocks": 50,
    "presets": [
      {
        "name": "Salon Promotion Landing"
      }
    ]
  }
{% endschema %}