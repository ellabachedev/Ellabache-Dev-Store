<script type="application/ld+json">
  {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "{{ blog.url | escape }}" 
  },
  "headline": "{{ article.title | escape }}",  
  "image": "{{ article.image | img_url: '1024x1024' | escape }}",
  "author": {
    "@type": "Organization",
    "name": "Ella Bache",
    "url": "https://www.ellabache.com.au/"
  }
}
</script>