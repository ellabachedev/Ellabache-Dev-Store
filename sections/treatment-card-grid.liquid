{% schema %}
{
  "name": "Treatment Card Grid",
  "tag": "section",
  "class": "treatment-card-grid",
  "settings": [
     {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
   {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bobttom",
      "default": 36
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Number of products to display",
      "default": 3,
      "min": 1,
      "max": 9,
      "step": 1
    }
  ],
  "presets": [
    {
      "name": "Treatment Card Grid",
      "category": "Custom"
    }
  ]
}
{% endschema %}
{%- style -%}
  .treatment-card-grid {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  
  @media screen and (min-width: 750px) {
    .treatment-card-grid  {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}
<style>
  .treatment-card-grid__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2.4rem;
  }
  .treatment-card-grid__item {
    background: #fff;
    border: 2px solid transparent;
    transition: all 0.3s ease-in-out;
    cursor: pointer;
  }
  .treatment-card-grid__item:hover img {
    transform: translateY(-5px);
    border-color: #ef476f;
  }
  .treatment-card-grid__image-wrapper {
    overflow: hidden;
  }
  .treatment-card-grid__image {
    width: 100%;
    height: auto;
    transition: transform 0.3s ease;
    display: block;
  }
  .treatment-card-grid__item:hover .treatment-card-grid__image {
    transform: scale(1.05);
  }
  .treatment-card-grid__title {
    font-size: 2rem;
    margin-top: 1.6rem;
  }
  .treatment-card-grid__item .treatment-card-grid__description:last-child{
    margin-bottom:0;
  }
  /* Whole card is clickable (the title link stretches over it). */
  .treatment-card-grid__item {
    position: relative;
  }
  .treatment-card-grid__link {
    color: #001e37;
    text-decoration: none;
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size 0.3s ease;
  }
  .treatment-card-grid__link::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .treatment-card-grid__item:hover .treatment-card-grid__link,
  .treatment-card-grid__link:focus-visible {
    background-size: 100% 1px;
  }
  .treatment-card-grid__link:focus-visible {
    outline: none;
  }
  .treatment-card-grid__item:has(.treatment-card-grid__link:focus-visible) {
    outline: 2px solid #001e37;
    outline-offset: 4px;
  }
  .treatment-card-grid__button:hover {
    background-color: #12385c;
    color: #fff;
  }
  /* Phones: a swipeable row instead of a long stack of full-width cards. */
  @media only screen and (max-width: 749px) {
    .treatment-card-grid__grid {
      display: flex;
      gap: 12px;
      margin: 0 -15px;
      padding: 0 15px 4px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding: 0 15px;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .treatment-card-grid__grid::-webkit-scrollbar {
      display: none;
    }
    .treatment-card-grid__item {
      flex: 0 0 78%;
      scroll-snap-align: start;
    }
    .treatment-card-grid__title {
      font-size: 1.7rem;
    }
    .treatment-card-grid__description {
      font-size: 1.3rem;
    }
  }
  .treatment-card-grid__cta {
    margin-top: 4rem;
    text-align:center;
  }
  .treatment-card-grid__button {
    background-color: #001e37;
    color: #fff;
    padding:1.52rem 3.2rem;
    text-transform: uppercase;
    font-size: 1.4rem;
    display: inline-block;
    text-decoration: none;
    transition: background-color 0.3s ease;
  }
  @media only screen and (max-width: 768px){
    .treatment-card-grid__button {
      width:100%;
    }
  }
  .treatment-card-grid__placeholder {
    background-color: #ddd;
    height: 200px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-style: italic;
    color: #888;
  }
</style>
<div class="treatment-card-grid__wrapper">
  <div class="page-width">
      {% if section.settings.title != blank %}
      <h2 class="treatment-card-grid__heading">{{ section.settings.title }}</h2>
      {% endif %}
     <div class="treatment-card-grid__grid">
      {% assign treatment_collection = collections['treatments'] %}
      {% assign treatment_products = treatment_collection.products %}
      {%- for product in treatment_products limit: section.settings.product_limit -%}
        <div class="treatment-card-grid__item">
            <div class="treatment-card-grid__image-wrapper">
              {%- if product.featured_image -%}
                <img class="treatment-card-grid__image" src="{{ product.featured_image | image_url: width: 700 }}" loading="lazy" alt="{{ product.title | escape }}" >
              {%- endif -%}
            </div>
            <div class="treatment-card-grid__content">
              <h3 class="treatment-card-grid__title">
                <a class="treatment-card-grid__link" href="{{ product.url }}">{{ product.title }}</a>
              </h3>
              {% if product.description != blank %}
                {%- comment -%} Space before each tag, so words from separate paragraphs don't run together. {%- endcomment -%}
                <p class="treatment-card-grid__description">{{ product.description | replace: '<', ' <' | strip_html | strip_newlines | truncatewords: 18 }}</p>
              {% endif %}
            </div>
          </div>
      {%- endfor -%}
     </div>
    {% if treatment_products.size > 0 %}
      <div class="treatment-card-grid__cta">
        <a href="/collections/treatments" class="button treatment-card-grid__button">View All Treatments</a>
      </div>
    {% endif %}
  </div>
</div>