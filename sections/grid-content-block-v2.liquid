<div class="grid-content-block-v2">
  <div class="page-width">
        <h3 class="text-center">Interested in Visiting our campus?</h3>   
        <p class="text-center" style="margin-bottom:0;">Choose one of our unique campus experiences:</p>  
    <div class="blocks">        
        <div class="lists flex-container">          
            <div class="item">            
                <a class="btn-secondary" href="https://www.eventbrite.com.au/e/ella-bache-college-open-day-january-2023-tickets-473729677217" target="_blank">Visit our Sydney Campus</a>          
            </div>          
            <div class="item">                           
                <button class="btn-secondary" data-tf-popup="uuCzDjYL" data-tf-iframe-props="title=Student Interest" data-tf-medium="snippet">Attend a class or treatment</button>
                <script src="//embed.typeform.com/next/embed.js"></script>            
            </div>          
            <div class="item">            
                <a class="btn-secondary" href="https://us02web.zoom.us/meeting/register/tZwkf-msqD8oHtOG0wlAUopUsyCMToQFv8hu" target="_blank">Book a Virtual Info Session</a>          
            </div>        
        </div>      
    </div>
  </div>
</div>
<style>
  .grid-content-block-v2{ margin-bottom:20px;}
  .grid-content-block-v2 .lists {
      margin: 0 -23px;
  }
  .grid-content-block-v2 .blocks .item{
    padding: 23px;
    width: 33.33%;
  }
  .grid-content-block-v2 .blocks .item .btn-secondary{  
    font-size:14px; 
    text-transform:uppercase;
    color:#001e37;
    background-color:#c4e4e3;
    border-radius:0;
    cursor:pointer;
    border:none;
    text-decoration:none;
    width:100%;
    padding:15.5px 10px;
    letter-spacing: 0.2px;
    display:block;
    width:100%;
    text-align:center;
    font-weight:500;
  }
  @media (max-width: 991px){
    .grid-content-block-v2 .lists {
      margin: -10px;
    }
    .grid-content-block-v2 .lists .item{
      padding:10px;
    }
  }
  
  @media (max-width: 768px){
    .grid-content-block-v2 .blocks{margin-top:10px;}
    .grid-content-block-v2 .page-width {
      max-width: 550px;
    }
    .grid-content-block-v2 .lists {
      margin: 0;
    }
    .grid-content-block-v2 .lists .item{
      width: 100%;
      margin-bottom: 10px;
      padding: 0;
    }
    .grid-content-block-v2 .lists .item:last-child{margin-bottom:0;}
  }

</style>
