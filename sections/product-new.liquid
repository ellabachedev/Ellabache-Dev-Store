<link rel="stylesheet" href="{{ 'component-pdp-image-gallery-new.css' | asset_url }}">
<div
  class="product-single"
  data-section-id="{{ section.id }}"
  data-section-type="product"
  data-enable-history-state="true"
  itemscope>
  {%- assign current_variant = product.selected_or_first_available_variant -%}
  {%- assign featured_image = current_variant.featured_image | default: product.featured_image -%}
  <div class="page-width">
    <div class="flex-container hero-content">
      <div class="image-carousel product-image-gallery">
        {%- if product.price > 0 -%}
          {%- if product.available -%}
            <span
              data-w-variant-quantity="{{ product.variants[0].inventory_quantity }}"
              data-w-variant-sku="{{ product.variants[0].sku }}"
              data-w-variant-title="{{ product.variants[0].title }}"
              data-w-product-handle="{{ product.handle }}"
              data-w-product-title="{{ product.title }}"
              data-w-quantity="1"
              data-w-product-image="{{ product.featured_image.src | img_url: 'grande' }}"
              data-w-product-price="{{ product.variants[0].price | money | remove: '.00' }}"
              data-w-variant-id="{{ product.variants[0].id }}"
              data-w-product-id="{{ product.id }}"
              class="add_to_wishlist">{%- render 'icon-heart' -%}<span class="text">Add to wishlist</span>
            </span>
          {%- endif -%}
        {%- endif -%}
        {% render 'pdp-image-gallery-new'
          , product: product
          , featured_image: featured_image %}
        <div class="mobile-hide">
          {% render 'product-video-block' %}
          <ul class="product-grid-images">
            {% for image in product.metafields.accentuate.product_grid_image_upload %}
              <li><img
                  src="{{ image.src | append: '&transform=resize=300'}}"
                  loading="lazy"
                  alt="{{ image.alt }}" /></li>
            {% endfor %}
          </ul>
        </div>
      </div>
      <div class="product-hero-content">
        {% comment %}<p class="collection-info"><span>Products | {{ product.type }}</span></p>{% endcomment %}
        <div class="title">
          <h1>{{ product.title }}</h1>
          <div style="margin-top:10px;" id="productReviewBadge-{{ collection.handle }}-{{ product.id }}">
            <span
              class="stamped-product-reviews-badge stamped-main-badge"
              data-id="{{ product.id }}"
              data-product-sku="{{ product.handle }}"
              style="display: inline-block;">{{ product.metafields.stamped.badge }}</span>
          </div>
        </div>
        {% if product.metafields.global.prod_size or product.metafields.global.shortdescription1 or product.metafields.global.shortdescription2 %}
          <div class="short-info">
            {% if product.metafields.global.shortdescription1 %}
              <h3 class="desc2">{{ product.metafields.global.shortdescription1 }}</h3>
            {% endif %}
            <h3 class="size" style="min-height:16px;">{{ product.metafields.global.prod_size }}</h3>
            {% if product.metafields.global.shortdescription2 %}
              <h3 class="desc1">{{ product.metafields.global.shortdescription2 }}</h3>
            {% endif %}
          </div>
          <div class="separator"></div>
        {% endif %}
        {%- if product.price > 0 -%}
          {% render 'product-info-new'
            , product: product
            , current_variant: current_variant %}
        {%- endif -%}
        {% render 'back-in-stock' %}
        <div class="accordion-block">
          {%- if product.metafields.accentuate.accordion_content_1_hide == blank -%}
            {%- if product.metafields.accentuate.accordion_content_1_title != blank -%}
              <div class="item">
                <div class="header is-open">
                  <h3>{{ product.metafields.accentuate.accordion_content_1_title }}</h3>
                  {%- if product.metafields.accentuate.accordion_content_1_sub_title != blank -%}
                    <h4>{{ product.metafields.accentuate.accordion_content_1_sub_title }}</h4>
                  {%- endif -%}
                </div>
                <div class="content">
                  {{ product.metafields.accentuate.accordion_content_1_text }}
                </div>
              </div>
            {%- endif -%}
          {%- endif -%}
          {%- if product.metafields.accentuate.accordion_content_2_hide == blank -%}
            {%- if product.metafields.accentuate.accordion_content_2_title != blank -%}
              <div class="item">
                <div class="header">
                  <h3>{{ product.metafields.accentuate.accordion_content_2_title }}</h3>
                  {%- if product.metafields.accentuate.accordion_content_2_sub_title != blank -%}
                    <h4>{{ product.metafields.accentuate.accordion_content_2_sub_title }}</h4>
                  {%- endif -%}
                </div>
                <div class="content">
                  {{ product.metafields.accentuate.accordion_content_2_text }}
                </div>
              </div>
            {%- endif -%}
          {%- endif -%}
          {%- if product.metafields.accentuate.accordion_content_3_hide == blank -%}
            {%- if product.metafields.accentuate.accordion_content_3_title != blank -%}
              <div class="item">
                <div class="header">
                  <h3>{{ product.metafields.accentuate.accordion_content_3_title }}</h3>
                  {%- if product.metafields.accentuate.accordion_content_3_sub_title != blank -%}
                    <h4>{{ product.metafields.accentuate.accordion_content_3_sub_title }}</h4>
                  {%- endif -%}
                </div>
                <div class="content">
                  {{ product.metafields.accentuate.accordion_content_3_text }}
                </div>
              </div>
            {%- endif -%}
          {%- endif -%}
          {%- if product.metafields.accentuate.accordion_content_4_hide == blank -%}
            {%- if product.metafields.accentuate.accordion_content_4_title != blank -%}
              <div class="item">
                <div class="header">
                  <h3>{{ product.metafields.accentuate.accordion_content_4_title }}</h3>
                  {%- if product.metafields.accentuate.accordion_content_4_sub_title != blank -%}
                    <h4>{{ product.metafields.accentuate.accordion_content_4_sub_title }}</h4>
                  {%- endif -%}
                </div>
                <div class="content">
                  {{ product.metafields.accentuate.accordion_content_4_text }}
                </div>
              </div>
            {%- endif -%}
          {%- endif -%}
          {%- if product.metafields.accentuate.accordion_content_5_hide == blank -%}
            {%- if product.metafields.accentuate.accordion_content_5_title != blank -%}
              <div class="item">
                <div class="header">
                  <h3>{{ product.metafields.accentuate.accordion_content_5_title }}</h3>
                  {%- if product.metafields.accentuate.accordion_content_5_sub_title != blank -%}
                    <h4>{{ product.metafields.accentuate.accordion_content_5_sub_title }}</h4>
                  {%- endif -%}
                </div>
                <div class="content">
                  {{ product.metafields.accentuate.accordion_content_5_text }}
                </div>
              </div>
            {%- endif -%}
          {%- endif -%}
        </div>
        <link rel="stylesheet" href="{{ 'stamped-widget.css' | asset_url }}">
        <div class="stamped-widget {% if product.metafields.accentuate.youtube_video == blank %} full-width {% endif %}">
          <div
            class="productReviewsBlock"
            id="stamped-main-widget"
            data-widget-style="standard"
            {% if product.metafields.accentuate.eb_product_ids != blank %}
            data-product-ids="{{ product.metafields.accentuate.eb_product_ids }}"
            {% else %}
            data-product-id="{{ product.id }}"
            {% endif %}
            data-name="{{ product.title | escape }}"
            data-url="{{ shop.url }}{{ product.url }}"
            data-image-url="{{ product.featured_image | product_img_url: "
                                        large" |replace: '?' , '%3F' | replace: '&' ,'%26'}}"
            data-description="{{ product.description | escape }}"
            data-product-sku="{{product.handle}}"></div>
        </div>
        <script
          async
          type="text/javascript"
          data-api-key=""
          id="stamped-script-widget"
          src="https://cdn-stamped-io.azureedge.net/files/widget.min.js"
          defer="defer"></script>
        <script src="{{ 'stampedio.js' | asset_url }}" defer="defer"></script>
        <div class="desktop-hide">
          {% render 'product-video-block-mobile' %}
          <ul class="product-grid-images">
            {% for image in product.metafields.accentuate.product_grid_image_upload %}
              <li><img
                  src="{{ image.src | append: '&transform=resize=300'}}"
                  loading="lazy"
                  alt="{{ image.alt }}" /></li>
            {% endfor %}
          </ul>
        </div>
      </div>
    </div>
  </div>
  {% comment %}
    {%- if section.settings.show_upsell_products == true -%}
    {%- include 'upsell-products', product: product -%}
    {%- endif -%}
  {% endcomment %}
  {% comment %}<div class="grid__item medium-up--one-half">
                      <div class="below-add-to-cart accordion">
                      {% assign results = product.metafields.global.results | strip_html | strip_newlines | strip %}
                      {% if results.size > 0 %}
                      <div class="accordionEntry">
                      <h2>{{ 'products.product.results' | t }}</h2>
                      <div class="accCont">
                      {{ product.metafields.global.results }}
                      </div>
                      </div>
                      {% endif %}
                      </div>
                      {% if settings.show_afterpay_on_pdp %}
                      <div class="afterpay-on-pdp">
                      {% case settings.icon %}
                      {% when 'colour' %}
                      <p>*insert after pay colored logo*</p>
                      {% when 'black' %}
                      <p>*insert after pay black logo*</p>
                      {% endcase %}
                      </div>
                      {% endif %}
                      </div>
                      {%- if section.settings.show_related_products == true -%}
                      {%- if product.metafields.global.relatedproducts -%}
                      <div class="page-width  has-carousel">
                      <div class="related-products-block" style="padding-bottom:0;">
                      {% include 'related-products-accentuate' %}
                      </div>
                      </div>
                      {%- endif -%}
                      {%- endif -%}
              {% endcomment %}
  {%- if product.metafields.accentuate.treatment_solution_hide == blank -%}
    {%- if product.metafields.accentuate.treatment_solution_title != blank -%}
      <div class="treatment-grid-content-block">
        <div class="page-width">
          <div class="heading text-center">
            {%- if product.metafields.accentuate.treatment_solution_title != blank -%}
              <h2>{{ product.metafields.accentuate.treatment_solution_title }}</h2>
            {%- endif -%}
            {%- if product.metafields.accentuate.treatment_solution_subtitle != blank -%}
              <h3>{{ product.metafields.accentuate.treatment_solution_subtitle }}</h3>
            {%- endif -%}
          </div>
          <div class="grid-content">
            <div class="flex-container">
              <div class="content">
                <div class="inner">
                  {%- if product.metafields.accentuate.treatment_solution_description != blank -%}
                    <p>{{ product.metafields.accentuate.treatment_solution_description }}</p>
                  {%- endif -%}
                  {%- if product.metafields.accentuate.treatment_solution_short_text != blank -%}
                    <span>{{ product.metafields.accentuate.treatment_solution_short_text }}</span>
                  {%- endif -%}
                </div>
              </div>
              {%- if product.metafields.accentuate.treatment_solution_video != blank -%}
                <div class="video">
                  <video
                    id="promoVideo1"
                    preload="none"
                    controls>
                    <source src="{{ product.metafields.accentuate.treatment_solution_video }}" type="video/mp4">
                  </video>
                  {%- if product.metafields.accentuate.treatment_solution_video_poste != blank -%}
                    <div class="poster">
                      <img
                        src="{{ product.metafields.accentuate.treatment_solution_video_poste }}"
                        alt="Your Treatment Solution Poster"
                        loading="lazy">
                    </div>
                    <div id="playPromoVideo1" class="play-button">
                      <span>Play</span>
                    </div>
                    <script>
                      window.addEventListener('load', (event) => {
                        $("#playPromoVideo1").on('click', function() {
                          $(this).parents('div.video').addClass('playing');
                          $("#promoVideo1").get(0).play();;
                        });
                        var vid = document.getElementById("promoVideo1");
                        vid.onpause = function() {
                          $("#promoVideo1").parents("div.video").removeClass('playing');
                        };
                      });
                    </script>
                  {%- endif -%}
                </div>
              {%- else -%}
                <div class="image">
                  {%- for image in product.metafields.accentuate.treatment_solution_image -%}
                    <img
                      src="{{ image.src }}"
                      alt="{{ image.alt }}"
                      loading="lazy"
                      alt="Your Treatment Solution" />
                  {%- endfor -%}
                </div>
              {%- endif -%}
            </div>
          </div>
        </div>
      </div>
    {%- endif -%}
  {%- else -%}
    {%- for c in product.collections -%}
      {%- if c.handle != 'frontpage' and c.handle != 'all' and c.handle != 'bestsellers' and c.handle != 'best-seller' and c.handle != 'best-sellers' and c.handle != 'best-sellers-mega-menu' %}
        {%- assign collectionforTreatment = c -%}
        {%- if collectionforTreatment.metafields.accentuate.treatment_solution_title != blank -%}
          <div class="treatment-grid-content-block">
            <div class="page-width">
              <div class="heading text-center">
                {%- if collectionforTreatment.metafields.accentuate.treatment_solution_title != blank -%}
                  <h2>{{ collectionforTreatment.metafields.accentuate.treatment_solution_title }}</h2>
                {%- endif -%}
                {%- if collectionforTreatment.metafields.accentuate.treatment_solution_subtitle != blank -%}
                  <h3>{{ collectionforTreatment.metafields.accentuate.treatment_solution_subtitle }}</h3>
                {%- endif -%}
              </div>
              <div class="grid-content">
                <div class="flex-container">
                  <div class="content">
                    <div class="inner">
                      {%- if collectionforTreatment.metafields.accentuate.treatment_solution_description != blank -%}
                        <p>{{ collectionforTreatment.metafields.accentuate.treatment_solution_description }}</p>
                      {%- endif -%}
                      {%- if product.metafields.accentuate.treatment_solution_short_text != blank -%}
                        <span>{{ product.metafields.accentuate.treatment_solution_short_text }}</span>
                      {%- endif -%}
                    </div>
                  </div>
                  {%- if collectionforTreatment.metafields.accentuate.treatment_solution_video != blank -%}
                    <div class="video">
                      <video id="promoVideo1" controls>
                        <source src="{{ collectionforTreatment.metafields.accentuate.treatment_solution_video }}" type="video/mp4">
                      </video>
                      {%- if collectionforTreatment.metafields.accentuate.treatment_solution_video_poste != blank -%}
                        <div class="poster">
                          <img
                            src="{{ collectionforTreatment.metafields.accentuate.treatment_solution_video_poste }}"
                            loading="lazy"
                            alt="Your Treatment Solution Poster">
                        </div>
                        <div id="playPromoVideo1" class="play-button">
                          <span>Play</span>
                        </div>
                        <script>
                          window.addEventListener('load', (event) => {
                            $("#playPromoVideo1").on('click', function() {
                              $(this).parents('div.video').addClass('playing');
                              $("#promoVideo1").get(0).play();;
                            });
                            var vid = document.getElementById("promoVideo1");
                            vid.onpause = function() {
                              $("#promoVideo1").parents("div.video").removeClass('playing');
                            };
                          });
                        </script>
                      {%- endif -%}
                    </div>
                  {%- else -%}
                    <div class="image">
                      {% for image in collectionforTreatment.metafields.accentuate.treatment_solution_image %}
                        <img
                          src="{{ image.src }}"
                          loading="lazy"
                          alt="{{ image.alt }}" />
                      {% endfor %}
                    </div>
                  {%- endif -%}
                </div>
              </div>
            </div>
          </div>
          {%- break -%}
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
  {% unless product == empty %}
    <script type="application/json" data-product-json>
      {{ product | json }}
    </script>
  {% endunless %}</div>
<!-- primaryDetails -->
{%- include 'variants' -%}
{%- if product.metafields.global.upsell_products or upsellCollectionStr != "" -%}
  {%- render 'quick-view-new' -%}
{%- endif -%}
<script src="{{ 'product-accordion.js' | asset_url }}" defer="defer"></script>
