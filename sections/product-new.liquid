<script type="application/ld+json">
  {
    "@context": "http://schema.org/",
    "@type": "Product",
    "name": {{ product.title | json }},
    "url": {{ shop.url | append: product.url | json }},
    {% if seo_media -%}
      {%- assign media_size = seo_media.preview_image.width | append: 'x' -%} "image" : [{{ seo_media | img_url: media_size | prepend: "https:" | json }}],
      {%- endif %}
      "description": {{ product.description | strip_html | json }},
      {% if product.selected_or_first_available_variant.sku != blank -%}
        "sku": {{ product.selected_or_first_available_variant.sku | json }},
        {%- endif %}
        "brand": {
          "@type": "Thing",
          "name": {{ product.vendor | json }}
        },
        "offers": [
            {%- for variant in product.variants -%}
            {
                "@type": "Offer",
                {%- if variant.sku != blank -%}
                "sku": {{ variant.sku | json }},
                {%- endif -%}
                "availability": "http://schema.org/{% if variant.available %} InStock{% else %}OutOfStock{% endif %}",
                "price": {{ variant.price | divided_by: 100.00 | json }},
                "priceCurrency": {{ cart.currency.iso_code | json }},
                "url": {{ shop.url | append: variant.url | json }}
              }{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          ]
        }
</script>
{%- assign promoVideo = product.metafields.accentuate.teaser_video | strip_html | strip_newlines | strip -%}
{%- if promoVideo.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "VideoObject",
      "@id": "{{ shop.url }} {{ product.url }} #video",
      "name": "How to use {{ product.title }}",
      "description": "Step-by-step product demonstration video showing how to correctly apply {{ product.title }} .",
      "thumbnailUrl": "{{ product.metafields.accentuate.video_poster_image }}",
      "uploadDate": "{{ product.published_at | date: '%Y-%m-%d' }}",
      "contentUrl": "{{ promoVideo }}",
      "embedUrl": "{{ shop.url }} {{ product.url }}",
      "about": {
        "@type": "Product",
        "@id": "{{ shop.url }} {{ product.url }} #product"
      }
    }
  </script>
{%- endif -%}
{% schema %}
  {
    "name": "Product",
    "settings": [
      {
        "type": "header",
        "content": "Payment Modes"
      },
      {
        "type": "checkbox",
        "id": "afterpay_enabled",
        "label": "Enable afterpay",
        "info": "Display afterpay payment details in product page?",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "klarna_enabled",
        "label": "Enable klarna",
        "default": true
      },
      {
        "type": "header",
        "content": "Related products settings"
      }, {
        "type": "checkbox",
        "id": "show_related_products",
        "label": "Enable related products",
        "default": false
      }, {
        "id": "related_title",
        "type": "text",
        "label": "Heading",
        "default": "Related products"
      }, {
        "type": "range",
        "id": "related_grid_num",
        "label": "Products per row",
        "min": 2,
        "max": 4,
        "step": 1,
        "default": 3
      }, {
        "type": "range",
        "id": "related_grid_row",
        "label": "Rows",
        "min": 1,
        "max": 3,
        "step": 1,
        "default": 1
      }, {
        "type": "header",
        "content": "Cross-sell Section Settings"
      }, {
        "type": "checkbox",
        "id": "show_upsell_products",
        "label": "Enable Cross-sell Products",
        "default": true
      }, {
        "id": "upsell_title",
        "type": "text",
        "label": "Cross-sell Section Title",
        "default": "You may also like"
      }, {
        "id": "upsell_sub_title",
        "type": "text",
        "label": "Sub Title",
        "default": "Try these recommended products for a complete skin solution."
      }, {
        "id": "upsell_count",
        "type": "text",
        "label": "Cross-sell Count",
        "default": "10"
      }
    ]
  }
{% endschema %}