<style>
  /* Video Custom */
  .video-with-text {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 100%;
    margin: 0 auto;
    flex-direction: column;
  }
  @media (min-width: 769px) {
    .video-with-text {
      gap: 6rem;
      flex-direction: row;
    }
  }
  .video-with-text__content {
    text-align: center;
    padding: 0 20px;
  }
  .video-with-text__content .inner {
    max-width: 530px;
  }
  /* Left Side - Text Content */
  @media (min-width: 769px) {
    .video-with-text__content {
      flex: 1;
      width: 50%;
      text-align: left;
      display: flex;
      justify-content: center;
    }
  }
  .video-with-text__subtitle {
    font-size: 0.875rem;
    color: #888;
    margin: 0;
  }
  @media (min-width: 769px) {
    .video-with-text__subtitle {
      font-size: 1.45rem;
    }
  }
  .video-with-text__title {
    margin-top: 0;
    margin-bottom: 0;
  }
  /* Right Side - Video Section */
  .video-with-text__video {
    position: relative;
    cursor: pointer;
  }
  .video-with-text__video-poster {
    display: block;
    position: absolute;
    width: 100%;
    height: 100%;
    z-index: 2;
    top: 0;
    left: 0;
    object-fit: cover;
  }
  /* Play Button (Overlay) */
  .video-with-text__video-play-button {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 10rem;
    height: 10rem;
    background: rgba(0, 30, 55, 0.8);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease-in-out;
    z-index: 2;
  }
  .video-with-text__video-play-button::after {
    content: "play";
    display: block;
    color: #ffffff;
    font-size: 1.6rem;
    text-transform: uppercase;
  }
  /* Hide the actual video initially */
  .video-with-text__video-element {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    aspect-ratio: 0.58;
  }
  @media (min-width: 769px) {
    .video-with-text__video-element {
      aspect-ratio: auto;
    }
  }
  /* Ripple Effect on Hover */
  .video-with-text__video-play-button:hover {
    transform: translate(-50%, -50%) scale(1.1);
  }
  .video-with-text__video-play-button:hover::before {
    content: "";
    position: absolute;
    width: 100%;
    height: 100%;
    background: rgba(255, 255, 255, 0.3);
    border-radius: 50%;
    opacity: 0;
    transform: scale(1);
    animation: ripple 1.5s ease-out;
  }
  /* Ripple Animation */
  @keyframes ripple {
    0% {
      transform: scale(1);
      opacity: 0.7;
    }
    100% {
      transform: scale(2.5);
      opacity: 0;
    }
  }
</style>
{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}
<div class="video section-{{ section.id }}-padding" style="background-color:{{ section.settings.bg_color }};">
  <div class="page-width video-with-text__video" onclick="playVideo()">
    <div id="playButton" class="video-with-text__video-play-button"></div>
    <video
      id="ftVideo"
      muted
      poster="{{ section.settings.video_poster | img_url:'884x' }}"
      class="video-with-text__video-element"
      controls>
      {% if section.settings.video_mobile != blank %}
        <source
          src="{{ section.settings.video.sources[0].url }}"
          media="(min-width: 769px)"
          type="video/mp4">
        <source src="{{ section.settings.video_mobile.sources[1].url }}" type="video/mp4">
      {% else %}
        <source src="{{ section.settings.video.sources[0].url }}" type="video/mp4">
      {% endif %}
    </video>
  </div>
</div>
<script>
  const video = document.getElementById("ftVideo");
  //const poster = document.getElementById("videoPoster");
  const playButton = document.getElementById("playButton");
  const videoContainer = document.querySelector(".video-with-text__video");
  const promoSection = document.getElementById("ftVideo");
  
  function playVideo() {
      //poster.style.display = "none";  // Hide the poster
      playButton.style.display = "none";  // Hide play button
      video.play();  // Start playback
      videoContainer.classList.add("playing"); // Add "playing" class
  }
  
  function restorePoster() {
      if (video.paused || video.ended) {
          //poster.style.display = "block";  // Show the poster
          playButton.style.display = "flex";  // Show play button
          videoContainer.classList.remove("playing"); // Remove "playing" class
      }
  }
  
  // Play video when clicking the poster or button
  videoContainer.addEventListener("click", playVideo);
  
  // Restore poster and play button when video is paused or ended
  video.addEventListener("pause", restorePoster);
  video.addEventListener("ended", restorePoster);
</script>
{% schema %}
  {
    "name": "Video Custom",
    "class": "section",
    "tag": "section",
    "disabled_on": {
      "groups": ["header", "footer"]
    },
    "settings": [
      {
        "type": "color",
        "id": "bg_color",
        "label": "Background Color",
        "default": "#F8F8F8"
      },
      {
        "type": "video",
        "id": "video",
        "label": "Video"
      },
      {
        "type": "video",
        "id": "video_mobile",
        "label": "Video Mobile"
      },
      {
        "type": "image_picker",
        "id": "video_poster",
        "label": "Video Poster"
      }, {
        "type": "header",
        "content": "t:sections.all.padding.section_padding_heading"
      }, {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_top",
        "default": 36
      }, {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_bottom",
        "default": 36
      }
    ],
    "presets": [
      {
        "name": "Video Custom"
      }
    ]
  }
{% endschema %}