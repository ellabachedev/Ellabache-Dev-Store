<style>
  #MainContent{
    position:relative;
  }
  .collection_banner {
    position: relative;
    overflow: hidden;
    {% comment %} padding-top: 40px;
    padding-bottom: 40px; {% endcomment %}
    height:327px;
  }
  {% comment %} .collection_banner .banner_image {
    position: absolute;
    left: 0;
    top: 0;
    height: 100%;
    width: 100%;
  } {% endcomment %}
  .collection_banner.only-image {
    padding:0;
    height: auto;
    background-color:transparent;
  }
  .collection_banner.only-image  .banner_content h1{
    font-size:22px;
    margin-top:20px;
    text-transform:unset;
    font-weight:400;
    line-height:normal;
  }
  .collection_banner.only-image  .banner_content h1 span{
  font-size:14px;}
  .collection_banner.only-image .banner_image{
    position:static;
    height:auto;
  }
  .collection_banner .banner_image figure{
    display:block;
  }
  .collection_banner .banner_image img {
    width: 100%;
    object-fit: cover;
    display: block;
    height: 100%;
    object-position: right;
    /*
   height: 325px; 
*/
  }
  .banner_content-text{
    display:none;
  }
  .banner_content .banner_content-text{
    display:block;
  }
  .collection_banner .banner_content {
    position: absolute;
    z-index:2;
    {% comment %} left: 0;
    top: 50%;
    transform: translateY(-50%); {% endcomment %}
    height:100%;
    width: 100%;
    left: 0;
    top: 0;
    padding-top:25px;
    padding-bottom:25px;
    overflow:auto;
  }
  .collection_banner .banner_content .flex-container{
    height:100%; 
    flex-direction:row; 
    justify-content:flex-start;
    align-items:center;
  }
  .collection_banner .text-wrapper .rte, .collection_banner .text-wrapper  .separator {
    max-width: 600px;
    width: 100%;
  }
  .collection_banner .text-wrapper h1 {
    font-size: 45px;
    font-weight: 500;
    line-height: 1.1;
    margin:0;
    text-transform:uppercase;
  }
  .collection_banner .text-wrapper p.sec-title {
    margin-bottom: 5px;
    font-size: 14px;
    max-width:600px;
  }
  @media (min-width: 768px) {
    .collection_banner .banner_image img{
      min-height:200px;
    }
  }
  @media (max-width: 1025px) {
    .collection_banner .banner_content{
      width:50%;
    }
    .collection_banner .text-wrapper p.sec-title {
      font-size: 12px;
    }
    .collection_banner .text-wrapper h1 {
      font-size: 28px;
    }
    .collection_banner .text-wrapper .rte {
      font-size: 12px;
    }
     .banner_content-text{
      display:block;
    }
    .banner_content .banner_content-text{
      display:none;
    }
  }
  @media (max-width: 800px) {
    .collection_banner .banner_content{
      width:60%;
    }
  }
  .collection_banner .text-wrapper .separator {
    margin-bottom: 12px;
    height: 3px;
    width: 100%;
  }
  .collection_banner .text-wrapper .rte{
  margin-top:50px;}
  .collection_banner .text-wrapper .rte,   .collection_banner .text-wrapper .rte p{
    font-size: 16px;
    line-height:1.3;
    
  }
  .collection_banner .text-wrapper .button {
    margin-top: 15px;
  }
  .collection_banner.no-banner-img {
    height: 300px;
    background-color: #f7f7f7;
    transition: height 0.8s ease;
  }

  {{ collection.metafields.accentuate.custom_css_code }}
  .collection-banner-nav-wrapper{
    background-color:#fccebc;
    margin-top:0;
    padding:10px 0;
  }
  .collection-banner-nav-wrapper .collection-banner-buttons{
  margin:0;
  }
  .collection-banner-nav-wrapper .collection-banner-buttons .btn{
    font-size: 14px;
    letter-spacing: 0.23px;
    padding: 5px 10px;
    text-align: center;
    color:#001E37;
    background-color: #ffffff;
    border: 1px solid #ffffff;
  }
  .collection-banner-nav-wrapper .collection-banner-buttons .btn.active{
    background-color: #8B4063;
    border: 1px solid #8B4063;
    color: #ffffff;
  }
</style>
<div
  class="collection_banner
  {% if collection.image == blank and collection.metafields.accentuate.collection_mini_banner_image_desktop == blank %} no-banner-img {% endif %}
  {% if collection.metafields.accentuate.mini_banner_hide_content != blank %} only-image {% endif %}"
  {% if collection.image == blank and collection.metafields.accentuate.collection_mini_banner_image_desktop == blank %}
  style="{% if collection.metafields.accentuate.banner_background_color != blank %}background-color:{{ collection.metafields.accentuate.banner_background_color }};
    {% else %}background-color: #ffefe5;
    {% endif %}"
  {% endif %}>
  {%- if collection.metafields.accentuate.collection_mini_banner_image_desktop != blank -%}
    {% assign desktop_image = collection.metafields.accentuate.collection_mini_banner_image_desktop %}
    {% assign mobile_image  = collection.metafields.accentuate.collection_mini_banner_image_mobile %}
    <div class="banner_image">
      <picture>
        <source media="(min-width: 800px)" srcset="{{ desktop_image }}">
        <img src="{{ mobile_image }}" alt="{{ collection.title | escape }}" loading="lazy" width="750" height="250" sizes="100vw">
      </picture>
    </div>
    {%- if collection.metafields.accentuate.collection_mini_banner_title != blank -%}
      <div class="banner_content text-wrapper">
        <div class="page-width" style="max-width:1440px;">
          <h1 class="h2">{{ collection.metafields.accentuate.collection_mini_banner_title }}</h1>
        </div>
      </div>
    {%- endif -%}
    {%- else -%}
      {%- if collection.image != blank -%}
      <div class="banner_image">
        <img
          src="{{ collection.image | img_url: '1280x' }}"
          srcset="{{ collection.image | img_url: '1900x' }} 1900w,
                {{ collection.image | img_url: '1400x' }} 1400w,
                {{ collection.image | img_url: '990x' }} 990w,
                {{ collection.image | img_url: '750x' }} 750w, 
                {{ collection.image | img_url: '480x' }} 480w"
          alt="{{ collection.image.alt | escape }}"
          sizes="100vw"
          width="1900"
          height="325" />
      </div>
      {%- endif -%}
  {%- endif -%}
  {%- if collection.image != blank -%}
    {%- if collection.handle == 'treatment' -%}
      <a style="position:absolute; left:0; top:0; width:100%; height:100%;" href="https://www.ellabache.com.au/pages/find-exclusive-salons"></a>
    {%- endif -%}
  {%- endif -%}
  {%- if collection.metafields.accentuate.hide_banner_content != 'true' -%}
  <div class="banner_content text-wrapper">
    <div class="flex-container">
      <div class="page-width">
        {%- if collection.metafields.accentuate.banner_primary_title != blank -%}
          <h1 style="{%- if collection.metafields.accentuate.banner_font_color != blank -%} color:{{ collection.metafields.accentuate.banner_font_color }}; {%- endif -%}">{{ collection.metafields.accentuate.banner_primary_title }}</h1>
        {%- else -%}
          <h1 style="{%- if collection.metafields.accentuate.banner_font_color != blank -%} color:{{ collection.metafields.accentuate.banner_font_color }}; {%- endif -%}">{{ collection.title }}</h1>
        {%- endif -%}
        {%- if collection.metafields.accentuate.primary_title_separator_color != blank -%}
          <div class="separator" style="background-color:{{ collection.metafields.accentuate.primary_title_separator_color }};"></div>
        {%- endif -%}
        {%- if collection.metafields.accentuate.banner_secondary_title != blank -%}
          <div>{{ collection.metafields.accentuate.banner_secondary_title }}</div>
        {%- endif -%}
        {%- if collection.metafields.accentuate.banner_text != blank -%}
          <div class="rte" style="color:{{ collection.metafields.accentuate.banner_font_color }};">{{ collection.metafields.accentuate.banner_text }}</div>
        {%- else -%}
          {%- if collection.description != blank -%}
            <div class="rte" style="{%- if collection.metafields.accentuate.banner_font_color != blank -%} color:{{ collection.metafields.accentuate.banner_font_color }}; {%- endif -%}">
              {{ collection.description }}
            </div>
          {%- endif -%}
        {%- endif -%}
      
        {%- if collection.metafields.accentuate.collection_banner_button_text != blank -%}
          <style>
            .collection-banner-buttons{
              display: flex;
              flex-wrap: wrap;
              align-items: center;
              overflow: auto;
              margin-top:15px;
            }
            .collection-button-scroll {
              display: flex;
              flex-wrap: wrap;
              padding: 0 var(--page-padding);
              gap:5px;
            }
            .collection_banner .btn {
              color:#001E37;
              font-size:14px;
              letter-spacing:0.23px;
              padding:5px 10px;
              text-align:center;
            }
            .collection_banner .btn.btn--secondary{
              background-color:#ffffff;
              border:1px solid #ffffff;
            }
            .collection_banner .btn:hover, .collection_banner .btn.active{
              background-color:#8B4063;
              border:1px solid #8B4063;
              color:#ffffff;
            }
            @media (max-width: 1023px) {
                .collection-button-scroll {
                    flex-wrap: nowrap;
                    padding: 0 var(--page-padding);
                }
            }
          </style>
          <div class="collection-banner-buttons">
            <div class="collection-button-scroll">
            {% assign current_path = request.path %}
            {%- assign index = 0 -%}
            {%- for collectionBannerButton in collection.metafields.accentuate.collection_banner_button_text -%}
              <a href="{{ collection.metafields.accentuate.collection_banner_button_link[index] }}" class="banner-button btn btn--secondary {% if collection.metafields.accentuate.collection_banner_button_link[index] == current_path %}active{% endif %}">
                {{ collection.metafields.accentuate.collection_banner_button_text[index] }}
              </a>
              {%- assign index = index | plus: 1 -%}
            {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
  {%- endif -%}
</div>
{%- if section.settings.show_breadcrumb_nav -%}
  {% include 'breadcrumbs' %}
{%- endif -%}
{%- if collection.metafields.accentuate.collection_banner_button_text != blank -%}
<div class="collection-banner-nav-wrapper" style="display:none;">
  <div class="page-width">
    <div class="collection-banner-buttons">
      <div class="collection-button-scroll">
      {% assign current_path = request.path %}
      {%- assign index = 0 -%}
      {%- for collectionBannerButton in collection.metafields.accentuate.collection_banner_button_text -%}
        <a href="{{ collection.metafields.accentuate.collection_banner_button_link[index] }}" class="banner-button btn btn--secondary {% if collection.metafields.accentuate.collection_banner_button_link[index] == current_path %}active{% endif %}">
          {{ collection.metafields.accentuate.collection_banner_button_text[index] }}
        </a>
        {%- assign index = index | plus: 1 -%}
      {%- endfor -%}
      </div>
    </div>
  </div>
</div>
<script>
  $(document).ready(function () {
  $(window).on('scroll', function () {
    if ($(this).scrollTop() >= 300) {
      $("header.site-header .collection-banner-nav-wrapper").slideDown();
    } else {
      $("header.site-header .collection-banner-nav-wrapper").css('display', 'none');
    }
  });
  var collectionBannerNav = $('.collection-banner-nav-wrapper').clone();
  $('header.site-header').append(collectionBannerNav);
});
</script> 
{%- endif -%}
{% schema %}
  {
    "name": "Collection Mini Banner",
    "templates": ["collection"],
    "tag": "section",
    "class": "collection-mini-banner",
    "settings": [
      {
        "type": "checkbox",
        "id": "show_breadcrumb_nav",
        "label": "Show breadcrumb navigation"
      }
    ],
    "presets": [
      {
        "name": "Collection Mini Banner"
      }
    ]
  }
{% endschema %}
