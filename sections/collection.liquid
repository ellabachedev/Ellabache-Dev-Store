        //     else {
        //         $("#filter-wrapper div.filter-block-title").stop().removeClass('is-open');
        //         $("#filter-wrapper div.filter-block-content").stop().slideUp(300);
        //         $(this).stop().addClass('is-open');
        //         $(this).next('div.filter-block-content').stop().slideDown(300);
        //     }
