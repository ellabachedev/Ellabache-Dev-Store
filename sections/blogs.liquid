{% schema %}
{
    "name": "Blogs",
    "settings": [
    {
      "type": "header",
      "content": {
      "en": "Mini Banner"
      }
    },
    {
      "id" : "mini_banner_switch",
      "type" : "checkbox",
      "label" : "Enable",
      "default" : true
    },
    {
      "id" : "toggle_font-color",
      "type" : "checkbox",
      "label" : "Toggle Banner Font Color",
      "default" : true
    },
    {
      "id" : "mini_banner_bg_color",
      "type" : "color",
      "label" : "Background Color",
      "default": "#062138"
    },
    {
      "id": "mini_banner_img",
      "type": "image_picker",
      "label": "Image"
    },
    {
      "id": "mini_banner_title",
      "type": "text",
      "label": "Title"
    },
    {
      "id": "mini_banner_desc",
      "type": "textarea",
      "label": "Description"
    },
    {
      "id": "mini_banner_btn_txt",
      "type": "text",
      "label": "Button Text"
    },
    {
      "id": "mini_banner_btn_url",
      "type": "url",
      "label": "Button URL"
    }
    ]
}
{% endschema %}

{% stylesheet %}


{% endstylesheet %}

