{{ 'accordion-block.css' | asset_url | stylesheet_tag }}
<style>
.college-event-calendar .mini-banner img{display:block; width:100%;}
.college-event-calendar .accordion-block{padding:50px 0;}
.college-event-calendar .accordion-block h2.title{margin-top:0;}
.college-event-calendar .accordion-block .flex-container {
  justify-content: space-between;
  -webkit-justify-content: space-between;
  -ms-justify-content: space-between;
  -moz-justify-content: space-between;
  align-items: flex-start;
  -webkit-align-items: flex-start;
  -ms-align-items: flex-start;
  -moz-align-items: flex-start;
}
.college-event-calendar .accordion-block .item {
    width: calc(50% - 19px);
}
.college-event-calendar .accordion-block .item h3 {
    margin: 0;
    font-size: 20px;
}

.college-event-calendar .accordion-block .content .column-2 {
    padding: 25px 10px 0 0;
}

.college-event-calendar .accordion-block .content h4 {
    margin-top: 0;
    margin-bottom: 10px;
    color: #001e37;
    font-size: 18px;
}
.college-event-calendar .accordion-block .content ul {
    margin-bottom: 20px;
}
.college-event-calendar .accordion-block .event-item{padding-left:45px; position:relative; margin-bottom:25px;background:url('{{ 'icon-calendar.png' | asset_url }}') left 3px no-repeat; min-height:33px;}
.college-event-calendar .accordion-block .event-item:last-child{margin-bottom:0px;}
.college-event-calendar .accordion-block .event-item h4{font-family: 'Helvetica Neue LT Std 47 Light Condensed'; color:#022038; font-size:20px; margin-bottom:0px;}
.college-event-calendar .accordion-block .event-item span{color:#474747; font-size:16px; font-family: 'Helvetica Neue LT Std 47 Light Condensed';}
.custom-scroll {
    height: 200px;
    overflow-y: auto;
}
.custom-scroll::-webkit-scrollbar {
    width: 10px;
    border-radius: 10px;
    position: relative;
    right: 10px;
}
.custom-scroll::-webkit-scrollbar-track {
    background: #ccc;
    border-radius: 10px;
}
.custom-scroll::-webkit-scrollbar-thumb {
    background: #aeaeae;
    border-radius: 10px;
}
.custom-scroll::-webkit-scrollbar-thumb:hover {
    background: #555;
}
.accordion-block .item:last-child{
  border-bottom:1px solid #b9c0c9;
}
@media (max-width: 768px) {
    .college-event-calendar .accordion-block .item h3 {
        font-size: 17px;
    }
     .college-event-calendar .accordion-block .item {
        padding: 15px 0;
        width:100%;
    }
  .college-event-calendar .accordion-block .event-item{background-size: 25px;     padding-left: 35px;}
  .college-event-calendar .accordion-block .event-item h4{font-size: 18px;}
  .college-event-calendar .accordion-block .event-item span{font-size:14px;}
  .college-event-calendar .accordion-block .event-item{margin-bottom:10px;}
  .college-event-calendar .custom-scroll{margin-top:10px;}
  .college-event-calendar .accordion-block .content .column-2 {
        padding-top: 5px;
    }
  .college-event-calendar .accordion-block .content ul {
        margin-bottom: 0;
    }
}
</style>
<div class="college-event-calendar">
  <div class="mini-banner">
      <div class="item">
        <picture>
          <source media="(min-width:769px)" srcset="https://cdn.shopify.com/s/files/1/2999/1646/files/college-event-calendar.jpg?v=1671018948">
          <img src="https://cdn.shopify.com/s/files/1/2999/1646/files/college-event-calendar.jpg?v=1671018948" alt="Event Banner">
