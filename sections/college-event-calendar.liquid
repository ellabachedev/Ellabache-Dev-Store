              <div class="header">
                  <h3>January</h3>
              </div>
              <div class="content">
                  <div class="column-2">
                      <div class="custom-scroll">
                        {% assign janEvents = section.settings.jan_events | split: '|||' %}
                        {%- for event in janEvents -%}
                          <div class="event-item">
                          {% if event contains "||" %}
                            {% assign eventSplit = event | split: '||' %}
                            {% assign eventSplit2 = eventSplit[0] | split: '|' %}
                              <h4><a href="{{ eventSplit[1] }}" target="_blank">{{ eventSplit2[0] }}</a></h4>
                            {% if eventSplit2[1] != blank %}
                              <span>{{ eventSplit2[1] }}</span>
                              {% endif %}
                          {% else %}
                              {% assign eventSplit = event | split: '|' %}
                              {% assign eventSplitSize = eventSplit | size  %}
                              {% if eventSplitSize == 1 %}
                                <h4>{{ eventSplit[0] }}</h4>
                              {% endif %}
                              {% if eventSplitSize == 2 %}
                                <h4>{{ eventSplit.first }}</h4>
                                {% if eventSplit[1] != blank %}
                                  <span>{{ eventSplit[1] }}</span>
                                {% endif %}
                              {% endif %}
                          {% endif %}
                          </div>
                        {% endfor %}
                      </div>
                  </div>
              </div>
          </div>
        {% endif %}
