{{ 'featured-logos.css' | asset_url | stylesheet_tag }}
{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}
<div class="featured-logos section-{{ section.id }}-padding" style="
    --text-color: {{ section.settings.text_color }};
    --logo-height: {{ section.settings.logo_height }}px;">
  {%- if section.settings.heading != blank -%}
    <h2 class="h1 text-center">{{ section.settings.heading }}</h2>
  {%- endif -%}
  <div class="featured-logos__grid marquee">
    <div class="marquee-inner">
      {%- for block in section.blocks -%}
        <a
          href="{{ block.settings.logo_link }}"
          class="featured-logos__item"
          {{ block.shopify_attributes }}>
          {%- if block.settings.logo_svg != blank -%}
            {{ block.settings.logo_svg }}
          {%- elsif block.settings.logo_image != blank -%}
            <img
              src="{{ block.settings.logo_image | image_url: height: 120 }}"
              alt="{{ block.settings.alt_text | escape }}"
              loading="lazy">
          {%- else -%}
            <span class="featured-logos__text">{{ block.settings.text_logo }}</span>
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>
<script>
  (function () {
  const isMobile = window.matchMedia('(max-width: 767px)').matches;
  
  if (isMobile) {
  //1 class selector for marquee
  //2 marquee speed 0.2
  window.addEventListener('load', Marquee('.marquee', 0.2))
  }
  
  function Marquee(selector, speed) {
  const parentSelector = document.querySelector(selector);
  const clone = parentSelector.innerHTML;
  const firstElement = parentSelector.children[0];
  let i = 0;
  console.log(firstElement);
  parentSelector.insertAdjacentHTML('beforeend', clone);
  parentSelector.insertAdjacentHTML('beforeend', clone);
  
  setInterval(function () {
    firstElement.style.marginLeft = `-${i}px`;
    if (i > firstElement.clientWidth) {
      i = 0;
    }
    i = i + speed;
  }, 0);
  }
  })();
</script>
{% schema %}
  {
    "name": "Featured logos",
    "tag": "section",
    "class": "section-featured-logos",
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "AS FEATURED IN"
      },
      {
        "type": "range",
        "id": "logo_height",
        "label": "Logo height",
        "min": 30,
        "max": 120,
        "step": 5,
        "default": 50
      },
      {
        "type": "color",
        "id": "text_color",
        "label": "Text / logo color",
        "default": "#1F2A44"
      },
      {
        "type": "header",
        "content": "t:sections.all.padding.section_padding_heading"
      }, {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_top",
        "default": 56
      }, {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_bottom",
        "default": 56
      }
    ],
    "blocks": [
      {
        "type": "logo",
        "name": "Logo",
        "settings": [
          {
            "type": "image_picker",
            "id": "logo_image",
            "label": "Logo image"
          },
          {
            "type": "textarea",
            "id": "logo_svg",
            "label": "SVG logo (optional)",
            "info": "Paste inline SVG for best quality"
          },
          {
            "type": "text",
            "id": "text_logo",
            "label": "Text logo fallback",
            "default": "VOGUE"
          },
          {
            "type": "url",
            "id": "logo_link",
            "label": "Link"
          }, {
            "type": "text",
            "id": "alt_text",
            "label": "Alt text",
            "default": "Featured publication"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Featured Logos",
        "blocks": [
          {
            "type": "logo"
          }, {
            "type": "logo"
          }, {
            "type": "logo"
          }, {
            "type": "logo"
          }
        ]
      }
    ]
  }
{% endschema %}