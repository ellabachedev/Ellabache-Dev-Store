  <div class="section how-to-book bg-gray-4">
      <div class="main-container">
        <div class="container-large align-center section-title">
          <h3 class="display-heading-3 section-heading" style="margin-top:0;">How to Book</h3>
        </div>
        <div class="flex-container">
          <div class="item">
            <div class="thumb">
            <img src="{{ 'MobileTherapist.png' | asset_url }}" alt="Step 1"></div>
            <h3>Step 1</h3>
            <p> Click on 'Book Your At Home Treatment’ button and select your location</p>
          </div>
          <div class="item">
            <div class="thumb">
              <img src="{{ 'BookingForm.png' | asset_url }}" alt="Step 2">
            </div>
            <h3>Step 2</h3>
            <p>Complete the booking form and pre-payment</p>
          </div>
          <div class="item">
            <div class="thumb">
            <img src="{{ 'EmailIcon.png' | asset_url }}" alt="Step 3">
            </div>
            <h3>Step 3</h3>
            <p>You will receive a booking confirmation that contains “what to expect” and a Treatment Consultation Form. Please complete this form at least 24 hours prior to your appointment</p>
          </div>
          <div class="item">
            <div class="thumb">
              <img src="{{ 'TreatmentIcon.png' | asset_url }}" alt="Step 4">
            </div>
            <h3>Step 4</h3>
            <p>Enjoy your Treatment at the time of your choice</p>
          </div>
        </div>
