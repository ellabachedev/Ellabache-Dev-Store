        <div class="container align-center">
          <h4 class="display-heading-2">Beauty</h4>
          <p class="text-large">Feel your best self with a brow and lash tint or brow shape</p>
          <a href="#homeBookingServices" data-service="cat3" class="popup-home-booking-services button-2 w-button">SEE AVAILABLE TREATMENTS</a>
        </div>
