      "product-landing-grid-content": {
        "type": "product-landing-grid-content",
        "blocks": {
          "c48ee034-fc50-4ae1-906a-e89546110587": {
            "type": "Article",
            "settings": {
              "item_title": "The Advanced <br>Formulation",
              "item_desc": "<p>An Intensive Treatment Booster with a unique formula reinforced with 5 different molecular weights of Hyaluronic Acid  that penetrates through multiple layers of the skin, effectively infusing the skin with concentrated super hydrating benefits and long-lasting intense hydration.\n<br>\n<br>\nNo Silicone. No Paraben. No Mineral Oil. Fragrance Free. \n</p>",
              "item_btn_text": "Discover the benefits for yourself",
              "item-btn-url": "shopify://products/hyaluronic-intensive-treatment-booster",
              "item-btn-color": "#7dabbd",
              "item_video": "https://cdn.shopify.com/videos/c/o/v/a0e36103ff154c90a047c8412532ce19.mp4"
            }
          },
          "13bfa887-459d-44b9-ab7b-b3a502e593f8": {
            "type": "Article",
            "settings": {
              "item_title": "Lifting",
              "item_desc": "<p>Essential for skin health, tone and vitality, the addition of Spirulina makes the booster a powerful skin re-charging, anti-ageing ingredient.\nA single drop and one swipe onto the skin to instantly hydrate and smooth at multiple levels.\n.</p>",
              "item_btn_text": "Get your boost  in a bottle",
              "item-btn-url": "https://www.ellabache.com.au/products/hyaluronic-intensive-treatment-booster",
              "item-btn-color": "#7dabbd",
              "item_image": "shopify://shop_images/HA-Booster---Revised-pics_03.png",
              "item_video": ""
            }
          },
          "914f67cd-79a5-44db-a326-92ce5522f06f": {
            "type": "Article",
            "settings": {
              "item_title": "Hydration <br> For Your Skin",
              "item_desc": "<p>Refresh a dull and lack lustre appearance with the ultimate hydration booster that penetrates and locks in moisture, delivering a smoother and plumper complexion.</p>\n<ul>\n             <li>\nTo boost hydration, apply morning and evening for 7 consecutive days.\n\n             </li>\n<li>\nAfter cleansing apply 1-2 drops over face and neck before applying moisture protective.\n</li>\n<li> \nTherapist Tip: After intense treatment to maintain moisture levels apply 2-3 times a week with recommended skin solution specific treatment serum to maintain optimal hydration.  </li>\n</ul>",
              "item_btn_text": "Start your intensive hydration treatment",
              "item-btn-url": "https://www.ellabache.com.au/products/hyaluronic-intensive-treatment-booster",
              "item-btn-color": "#7dabbd",
              "item_video": "https://cdn.shopify.com/videos/c/o/v/3f0f5e2064b94d27936bd8900fcd1e05.mp4"
            }
          },
          "cdeb7fc5-7e20-47a2-a9ea-880105e096e7": {
            "type": "Article",
            "settings": {
              "item_title": "All About <br> Hyaluronic Acid",
              "item_desc": "<p> Your body naturally produces hyaluronic acid and its main function is to retain water to keep your tissues lubricated and moist. By attracting water to the skin, Hyaluronic Acid will act as your ultimate hydrator. Strengthening your skin’s natural moisture barrier, it works to replenish your skin’s moisture reservoir to help maintain a plumper and smoother appearance.\n</p>",
              "item_btn_text": "Learn more",
              "item-btn-url": "https://www.ellabache.com.au/blogs/ella-bache/the-new-serum-that-is-more-than-just-instant-gratification",
              "item-btn-color": "#7dabbd",
              "item_image": "shopify://shop_images/HA-revised_01.png",
              "item_video": ""
            }
          },
          "3ef46b35-59f9-49d2-94a5-c662d23f7e2b": {
            "type": "Article",
            "settings": {
              "item_title": "Intensive Hydration",
              "item_desc": "<p>Daily protection can be achieved through the use of the Hyaluronic Intensive Treatment Booster with its ability to restore moisture while building reservoirs. Replenish moisture levels in dehydrated and extremely dry skin with our intensive results driven Help Me Hydrate facial, creating instantly smooth glowy skin. </p>",
              "item_btn_text": "Find your nearest salon",
              "item-btn-url": "https://www.ellabache.com.au/pages/find-a-salon",
              "item-btn-color": "#7dabbd",
              "item_image": "shopify://shop_images/mobile-ver-HA-booster_05.png",
              "item_video": ""
            }
          }
        },
