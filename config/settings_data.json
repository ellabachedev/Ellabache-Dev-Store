        "type": "product-launch-cta2",
        "blocks": {
          "84815277-286f-4b30-ad22-30672a74167e": {
            "type": "content",
            "settings": {
              "step-icon-image": "shopify://shop_images/instant.png",
              "step-text": "Gently tap and reawaken the eye area"
