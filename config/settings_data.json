      "reviews-block": {
        "type": "reviews-block",
        "blocks": {
          "32663a8d-c327-4255-979d-3515ac08caf2": {
            "type": "Reviews",
            "settings": {
              "review": "Just as no two skins are alike, no two students are alike either. Which is why we champion and support the individual to learn in a way that suits them.",
