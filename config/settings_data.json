      "marquee-product-reviews": {
        "type": "marquee-product-reviews",
        "blocks": {
          "635efaf1-24e6-4050-9bf2-0a55ac929ba1": {
            "type": "review_content",
            "settings": {
              "reviewer_name": "Rae K",
              "reviewer_content": "I've tried a lot of Hyaluronic products before but this is far superior. I've been using this product for two weeks and my skin really is super hydrated and I can tell the difference. I'm getting more benefits out of the serum and moisturiser. Cannot reccomend enough!",
              "reviewer_rating": "4"
            }
          },
          "ddf124a3-4784-4378-815f-5c6e5362b02f": {
            "type": "review_content",
            "settings": {
              "reviewer_name": "Sarah K",
              "reviewer_content": "Wow! I am so impressed by this product. My skin is instantly plump, fresh and radiant from the time I apply, to the time I wash my face at night. HG!",
              "reviewer_rating": "5"
            }
          },
          "cd222aac-7fdf-4597-b3a1-158f5e198c13": {
            "type": "review_content",
            "settings": {
              "reviewer_name": "Zara",
              "reviewer_content": "I have been pleasantly surprised by this treatment booster after just 7 days of use. My skin has never glowed like this before and it makes me feel more confident in my own skin. I get excited to do my skin routine now. Definitely recommend!",
              "reviewer_rating": "4"
            }
          },
          "6cc661c3-76e3-430f-a9ce-b5382d47da03": {
            "type": "review_content",
            "settings": {
              "reviewer_name": "Amanda",
              "reviewer_content": "First time using a Hyaluronic product before, love how hydrated my skin feels. Makes my make up go on easier, blending better and staying on longer. Game changer!",
              "reviewer_rating": "5"
            }
          },
          "001088d4-51be-49ad-864a-2f90268865db": {
            "type": "review_content",
            "settings": {
              "reviewer_name": "Andy",
              "reviewer_content": "I LOVE this NEW product! If you are looking for a high-quality hydration booster to add to your skin treatment ritual, this is THE product. It feels very lux to apply, i use day & night now to max my skin hydration. Great work Ella Baché.",
              "reviewer_rating": "5"
            }
          },
          "b3342135-09ac-46ae-bca8-f5e23cd7a1f8": {
            "type": "review_content",
            "settings": {
              "reviewer_name": "Pippa Hallas",
              "reviewer_content": "After trying lots of different products and getting no where, the Therapist at Bondi Junction salon recommended this after telling as my skin felt dry. After a week it’s now feeling much better, no more dryness and looks healthier",
              "reviewer_rating": "5"
            }
          },
          "08340226-c865-4567-9be7-7b672b34788f": {
            "type": "review_content",
            "settings": {
              "reviewer_name": "Rose E",
              "reviewer_content": "I’ve tried many Hyaluronic products and this one has been a clear stand out. Using it morning and night underneath my regular serum I have seen an improvement in skin brightness and smoothness.",
              "reviewer_rating": "5"
            }
          },
          "418052c7-d878-42a9-aea9-b1a8fff75cbf": {
            "type": "review_content",
            "settings": {
              "reviewer_name": "Jodi J",
              "reviewer_content": "I absolutely love this Ella Bache product. I did the 7 days introduction to my skincare routine day and night, and I cannot stop using it! I have noticed my skin is brighter and comments from friends that my skin is more plumped.",
              "reviewer_rating": "5"
            }
          },
          "2f41a8c5-7824-4205-8ced-00df87bb7702": {
            "type": "review_content",
            "settings": {
              "reviewer_name": "Alana K",
              "reviewer_content": "I didn't expect to see or feel the fast results of this product HOWEVER, after 1 week my skin was smoother and super hydrated! Didn't break me out and was so easy to add into my routine.",
              "reviewer_rating": "5"
            }
          }
        },
