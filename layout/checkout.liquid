{% include 'shogun-content-handler' %}
<!DOCTYPE html>
<html lang="{{ locale }}" dir="{{ direction }}" class="{{ checkout_html_classes }}">
  <script type="text/javascript">
    (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", "muo5pwdp14");
</script>
  <head>
  {% comment %}Loads Shogun Analytics. Removing this will disrupt analytics data collection.{% endcomment %}
  <script type="text/javascript" async src="https://na.shgcdn3.com/pixel-collector.js"></script>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, height=device-height, minimum-scale=1.0, user-scalable=0">
    <meta name="referrer" content="origin">
    <title>{{ page_title }}</title>
    {{ content_for_header }}
    {{ checkout_stylesheets }}
    {{ 'checkout.css' | asset_url | stylesheet_tag }}
    {{ checkout_scripts }}
    <script src="{{ 'jquery-library.js' | asset_url }}"></script>
    <script src="{{ 'vendor.js' | asset_url }}"></script>
    {{ 'api.jquery.js' | shopify_asset_url | script_tag }}
    {% include 'tag-manager-head' %}
    <!-- ADDRESS VALIDATOR -->
    <script async src="https://d3ox8tdk614ykk.cloudfront.net/pobox_checker.js"></script>
    {% render 'shogun-head' %}
  </head>
  <body>
    {% render 'variables' %}
    {% include 'tag-manager-body' %}
    {{ skip_to_content_link }}

    <div class="banner" data-header>
      <div class="wrap">
        {{ content_for_logo }}
      </div>
    </div>

    {{ order_summary_toggle }}

    <div class="content" data-content>
      <div class="wrap">
        <div class="main" role="main">
          <div class="main__header">
            {{ content_for_logo }}
            {{ breadcrumb }}
            {{ alternative_payment_methods }}
          </div>
          <div class="main__content">
            {{ content_for_layout }}
          </div>
          <div class="main__footer" style="display:flex; justify-content:space-between;">
            {{ content_for_footer }} <span> ABN No: 17 001 708 925</span>
          </div>
        </div>
        <div class="sidebar" role="complementary">
          <div class="sidebar__header">
            {{ content_for_logo }}
          </div>
          <div class="sidebar__content">
            {% render 'checkout_controller_loyalty_balance' %}
            {{ content_for_order_summary }}
          </div>
        </div>
      </div>
    </div>

    {{ tracking_code }}

    {% include 'checkout-customer-landingpage' %}
    {% include 'checkout-preferred-salons' %}
    {% include 'checkout-competition-qna' %}
    {% include 'updateorderlandingpage' %}
    
    <style type="text/css">
      .step__footer__continue-btn[disabled] {
       opacity: 0.5; 
      }
      .order-summary__section__content [data-product-type='Gift Cards'] .product__description__variant, .order-summary__section__content [data-product-type='Sample'] .product__description__variant{
        display:none;
      }
    </style>

    {% include 'checkout-shipping-message' %}

    {% if settings.enable_checkout_message2 %}
      <div class="isHidden" id="checkoutMessage2">
        {{ settings.checkout_message2_text }}
      </div>

      <script type="text/javascript" defer="defer">
        if ($('.section--shipping-method').length > 0 && Shopify.Checkout.step == 'shipping_method') {
          $('#checkoutMessage2').insertBefore('.section--shipping-method');
          $('#checkoutMessage2').removeClass('isHidden');
        }
          if ($('.section--payment-method').length > 0 && Shopify.Checkout.step == 'payment_method') {
          //$('#checkoutMessage2').insertBefore('.section--payment-method');
          var orderPlaceButtonSection = $('button#continue_button').parents('.step__footer');
          $('#checkoutMessage2').insertBefore(orderPlaceButtonSection);
          $('#checkoutMessage2').removeClass('isHidden');
        }
      </script>
    {% endif %}
    {% render 'checkout_controller_cards' %}
  </body>
</html>
