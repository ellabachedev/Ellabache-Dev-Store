<script>
    $(document).ready(function () {
        $('div.cart-mini-notification span.close').on('click', function () {
            $(this).parents('div.cart-mini-notification').addClass('hide');
        });
        $('div.cart-mini-notification-mini').on('click', function () {
            $('div.cart-mini-notification').removeClass('hide');
        });
    });
    const mutationObserver = new MutationObserver(entries => {
        console.log(entries);
        var childItems = $('div.cart-line-item-box div.cart-line-item').length;
        if(childItems > 0){
            $("div.cart-mini-notification-mini").addClass('show');
            $("div.cart-mini-notification").addClass('show');
        }
        else{
            $("div.cart-mini-notification-mini").removeClass('show');
            $("div.cart-mini-notification").removeClass('show');
        }
    });
    const parent = document.querySelector(".cart-line-item-box");
    mutationObserver.observe(parent, {childList: true});
</script>