{%- for line in cart.items -%}
{%- assign prodHandle = line.product.handle -%}
{%- unless freeproducts contains prodHandle -%}
{%- for coll in all_products[prodHandle].collections -%}
{%- if collection_selected == coll.handle -%}
{%- assign showbutton = true -%}
{% break %}
{%- endif -%}
{%- endfor -%}
{%- endunless -%}
{%- if showbutton == true -%}
{% break %}
{%- endif -%}
{%- endfor -%}
{%- assign showbutton = false -%}
