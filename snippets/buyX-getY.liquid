{%- assign selectedCollection = settings.X_collection -%}
{%- assign eligibleProds = '' -%}
{%- paginate collections[selectedCollection].products by 250 -%}
{%- for prods in collections[selectedCollection].products -%}
{%- if forloop.first == true -%}
{% assign eligibleProds = prods.handle %}
{% else %}
{% assign eligibleProds = eligibleProds | append:',' | append: prods.handle %}
{%- endif -%}
{%- endfor -%}
{%- endpaginate -%}
