{%- assign allFreeProductVariantIds = currentVariant1.id -%}
{%- else -%}
{%- assign allFreeProductVariantIds = allFreeProductVariantIds | append:',' | append: currentVariant1.id -%}
{%- endif -%}
{%- endif -%}
