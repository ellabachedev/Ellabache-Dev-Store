<div class="subscription__form-wrapper {%- if hide_popup %} hide {% endif -%}"
  data-popup-open-delay="{{ section.settings.subscription_popup_open_delay }}" data-subscription-popup>
  <h3>{{ section.settings.subscription-header }}</h3>
  {%- form 'customer', id: 'customer-subscription-form' -%}
  {{ form.errors | default_errors }}
  {%- if form.posted_successfully? -%}
  <div class="subscription__form-message">
    <h4 class="subscription__form-message__text">{{ section.settings.subscription-success-message }}</h4>
  </div>
  {%- else -%}
  <p>{{ section.settings.subscription-caption }}</p>
  <div class="newletter__form">
    <div class="input-wrapper">
      <input type="hidden" name="contact[tags]" value="subscription">
      <input type="hidden" name="customer[accepts_marketing]" value="true" />
      <input type="email" name="contact[email]" id="Email" class="subscription__input"
        value="{% if customer %}{{ customer.email }}{% endif %}"
        placeholder="{{ section.settings.subscription-placeholder }}" spellcheck="true" autocapitalize="off">
    </div>
    <div class="button-wrapper">
      <button type="submit" class="" name="commit" id="popUpSubscribe">{{ section.settings.subscription-submit-text
        }}</button>
    </div>
  </div>
  {%- endif -%}
  {%- if section.settings.subscription-policy-text != blank -%}
  <a href="{{ section.settings.subscription-policy-link }}"> {{ section.settings.subscription-policy-text }} </a>
  {%- endif -%}
  {%- endform -%}
  <a href="#" id="popup-close"><i class="fas fa-times"></i></a>
</div>