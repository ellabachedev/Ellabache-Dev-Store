{%- assign hide_popup = true -%}
{%- assign current_path_url_split = request.path| split: "/" -%}
{%- assign exclude_list = section.settings.subscription_popup_exclude | split: "," -%}
{%- for exclude_url in exclude_list -%}
{%- assign strippedUrl = exclude_url | strip -%}
{%- if request.path contains strippedUrl -%}
{%- assign hide_popup = true -%}
{%- break -%}
{%- endif -%}
{%- endfor -%}
{%- for link in linklists[section.settings.subscription_popup_linklist].links -%}
{%- if link.title == page.title -%}
{%- assign hide_popup = true -%}
{%- endif -%}
{%- endfor -%}
{%- if page.handle == 'sign-up-for-the-launch' -%}
{%- assign hide_popup = true -%}
{%- endif -%}
{%- if template == 'signup-landing-page1' -%}
{%- assign hide_popup = true -%}
{%- endif -%}
