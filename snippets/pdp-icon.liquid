{%- comment -%}
  Line icons used by the PDP sections. Inherit colour from `currentColor`.
  Usage: {% render 'pdp-icon', icon: 'bag' %}
{%- endcomment -%}
{%- capture pdp_icon_attrs -%}class="pdp-icon pdp-icon--{{ icon }}" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"{%- endcapture -%}
{%- case icon -%}
  {%- when 'bag' -%}
    <svg {{ pdp_icon_attrs }}><path d="M5 8h14l-1 12H6L5 8Z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
  {%- when 'play' -%}
    <svg {{ pdp_icon_attrs }}><path d="M8 5.5v13l10.5-6.5L8 5.5Z" fill="currentColor"/></svg>
  {%- when 'close' -%}
    <svg {{ pdp_icon_attrs }}><path d="M6 6l12 12M18 6 6 18"/></svg>
  {%- when 'arrow-left' -%}
    <svg {{ pdp_icon_attrs }}><path d="M15 5l-7 7 7 7"/></svg>
  {%- when 'arrow-right' -%}
    <svg {{ pdp_icon_attrs }}><path d="M9 5l7 7-7 7"/></svg>
  {%- when 'check' -%}
    <svg {{ pdp_icon_attrs }}><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
  {%- when 'drop' -%}
    <svg {{ pdp_icon_attrs }}><path d="M12 3.5s6 6.4 6 10.5a6 6 0 0 1-12 0c0-4.1 6-10.5 6-10.5Z"/></svg>
  {%- when 'waves' -%}
    <svg {{ pdp_icon_attrs }}><path d="M4 9c2-2 4-2 6 0s4 2 6 0 3-1.5 4-1"/><path d="M4 15c2-2 4-2 6 0s4 2 6 0 3-1.5 4-1"/></svg>
  {%- when 'leaf' -%}
    <svg {{ pdp_icon_attrs }}><path d="M5 19c0-8 5-13 14-14 0 9-5 14-13 14"/><path d="M5 19 13 11"/></svg>
  {%- when 'sparkle' -%}
    <svg {{ pdp_icon_attrs }}><path d="M12 3v4M12 17v4M3 12h4M17 12h4"/><path d="M12 8.5 13.2 10.8 15.5 12l-2.3 1.2L12 15.5l-1.2-2.3L8.5 12l2.3-1.2L12 8.5Z"/></svg>
  {%- when 'shield' -%}
    <svg {{ pdp_icon_attrs }}><path d="M12 3.5 19 6v5.5c0 4.4-3 7.7-7 9-4-1.3-7-4.6-7-9V6l7-2.5Z"/></svg>
  {%- when 'sun' -%}
    <svg {{ pdp_icon_attrs }}><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"/></svg>
  {%- when 'moon' -%}
    <svg {{ pdp_icon_attrs }}><path d="M19.5 14.5A8 8 0 0 1 9.5 4.5a8 8 0 1 0 10 10Z"/></svg>
  {%- when 'heart' -%}
    <svg {{ pdp_icon_attrs }}><path d="M12 19.5s-7.5-4.6-7.5-10A4.2 4.2 0 0 1 12 7a4.2 4.2 0 0 1 7.5 2.5c0 5.4-7.5 10-7.5 10Z"/></svg>
  {%- when 'face' -%}
    <svg {{ pdp_icon_attrs }}><circle cx="12" cy="12" r="8.5"/><path d="M9 10h.01M15 10h.01M9 14.5c1.7 1.5 4.3 1.5 6 0"/></svg>
{%- endcase -%}
