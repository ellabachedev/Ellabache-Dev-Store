{% assign number_of_related_products_per_row = section.settings.related_grid_num %}
{% assign number_of_rows = section.settings.related_grid_row %}

{% comment %}
    Set either or both to true, if you want to limit yourself to items with same vendor, and/or type.
{% endcomment %}
{% assign same_vendor = false %}
{% assign same_type = false %}

{% comment %}
    Collections to ignore. Never pick related items from those.
{% endcomment %}
{% assign exclusions = 'frontpage,all' | split: ',' %}

{% comment %}
    Looking for a relevant collection.
{% endcomment %}
{% if product.metafields.global.relatedproducts %}
    {% assign selected_handles = product.metafields.global.relatedproducts | split: '|' %}

    {% assign counter = 0 %}
    {% assign break_at = number_of_rows | times: number_of_related_products_per_row %}

    {% case number_of_related_products_per_row %}
        {% when 2 %}
            {%- assign image_size = '800x' -%}
        {% when 3 %}
            {%- assign image_size = '550x' -%}
        {% when 4 %}
            {%- assign image_size = '400x' -%}
    {% endcase %}

    {% capture related_items %}
        {% for selected_handle in selected_handles %}
            {% assign complimentaryProd = all_products[selected_handle] %}
            {% unless complimentaryProd == blank %}
                {% comment %}{% include 'related-product-grid-item', grid_image_width: image_size %}{% endcomment %}
                {%- include 'product-grid-item-collection', product: complimentaryProd, hidereviews: true -%}
            {% endunless %}
        {% endfor %}
    {% endcapture %}

    {% assign related_items = related_items | trim %}

    {% unless related_items == blank %}
        <section class="section section--related-products" id="relatedProducts">
            <div class="container container--medium">
                {% unless section.settings.related_title == blank %}
                    <div class="section__title section__title--center">
                        <h2 class="section__title-text">{{ section.settings.related_title | escape }}</h2>
                    </div>
                {% endunless %}
            </div>
            <div class="product-listing">
                <div class="slider flex-container">
                    {{ related_items }}
                </div>
            </div>
        </section>
    {% endunless %}
    <script>
        var bs_slick_config = {
          slidesToShow: 5,
          slidesToScroll: 5,
          arrows: true,
          dots: false,
          centerMode: false,
          responsive: [
            {
              breakpoint: 1100,
              settings: {
                slidesToShow: 4,
                slidesToScroll: 4
              }
            },
            {
              breakpoint: 991,
              settings: {
                slidesToShow: 3,
                slidesToScroll: 3
              }
            },
            {
              breakpoint: 767,
              settings: {
                slidesToShow: 2,
                slidesToScroll: 2
              }
            }
          ]
        }
        window.addEventListener('load', (event) => {
          $("#relatedProducts .slider").slick(bs_slick_config);
        });
      </script>
{% endif %}
