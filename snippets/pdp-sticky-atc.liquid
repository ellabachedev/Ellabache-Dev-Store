{%- comment -%}
  Sticky add to cart bar for the product page.
  Appears once the main add to cart button (#pdp-addtocart) has scrolled out of view and
  forwards clicks to it, so quantity, variant and buyX-getY claims stay in sync.
  Params: product, current_variant
{%- endcomment -%}
{%- liquid
  assign sticky_image = current_variant.featured_image | default: product.featured_image
  assign sticky_reviews = product.metafields.stamped.reviews_count | plus: 0
  assign sticky_rating = product.metafields.stamped.reviews_average | plus: 0 | round: 1
  comment
    Always one decimal, like the Stamped badge ("5.0", "4.9").
  endcomment
  assign sticky_rating_text = sticky_rating | append: ''
  unless sticky_rating_text contains '.'
    assign sticky_rating_text = sticky_rating_text | append: '.0'
  endunless
-%}
<div
  class="pdp-sticky-atc"
  data-pdp-sticky-atc
  aria-hidden="true"
  inert>
  <div class="page-width pdp-sticky-atc__inner">
    <div class="pdp-sticky-atc__product">
      {%- if sticky_image -%}
        <img
          class="pdp-sticky-atc__image"
          src="{{ sticky_image | image_url: width: 160 }}"
          alt="{{ sticky_image.alt | default: product.title | escape }}"
          width="56"
          height="56"
          loading="lazy">
      {%- endif -%}
      <div class="pdp-sticky-atc__info">
        <p class="pdp-sticky-atc__name">{{ product.title }}</p>
        <p class="pdp-sticky-atc__meta">
          <span class="pdp-sticky-atc__price-mobile" data-pdp-sticky-price>{{ current_variant.price | money }}</span>
          {%- if product.metafields.global.prod_size != blank -%}
            <span class="pdp-sticky-atc__size">{{ product.metafields.global.prod_size }}</span>
          {%- endif -%}
          {%- if sticky_reviews > 0 -%}
            <a
              class="pdp-sticky-atc__rating"
              href="#stamped-main-widget"
              data-pdp-sticky-reviews
              tabindex="-1"
              aria-label="Rated {{ sticky_rating_text }} out of 5 from {{ sticky_reviews }} reviews. Go to reviews">
              <span class="pdp-sticky-atc__stars" style="--rating: {{ sticky_rating }};" aria-hidden="true"></span>
              <span class="pdp-sticky-atc__rating-value" aria-hidden="true">{{ sticky_rating_text }}</span>
              <span class="pdp-sticky-atc__count" aria-hidden="true">
                {{- sticky_reviews }} {% if sticky_reviews == 1 %}review{% else %}reviews{% endif -%}
              </span>
            </a>
          {%- endif -%}
        </p>
      </div>
    </div>
    <div class="pdp-sticky-atc__buy">
      <p class="pdp-sticky-atc__price">
        <span data-pdp-sticky-price>{{ current_variant.price | money }}</span>
        {%- if current_variant.compare_at_price > current_variant.price -%}
          <span class="visually-hidden">{{ 'products.product.regular_price' | t }}</span>
          <s>{{ current_variant.compare_at_price | money }}</s>
        {%- endif -%}
      </p>
      {%- if current_variant.available -%}
        <div class="pdp-sticky-atc__qty" data-pdp-sticky-qty>
          <button type="button" class="pdp-sticky-atc__qty-btn" data-pdp-sticky-qty-step="-1" aria-label="Decrease quantity" tabindex="-1">&minus;</button>
          <input
            class="pdp-sticky-atc__qty-input"
            type="number"
            min="1"
            value="1"
            inputmode="numeric"
            aria-label="Quantity"
            data-pdp-sticky-qty-input
            tabindex="-1">
          <button type="button" class="pdp-sticky-atc__qty-btn" data-pdp-sticky-qty-step="1" aria-label="Increase quantity" tabindex="-1">+</button>
        </div>
      {%- endif -%}
      <button
        type="button"
        class="pdp-sticky-atc__button"
        data-pdp-sticky-button
        tabindex="-1"
        {% unless current_variant.available %}disabled{% endunless %}>
        <span class="pdp-sticky-atc__label" data-pdp-sticky-label>
          {%- if current_variant.available -%}
            {{ 'products.product.add_to_cart' | t }}
          {%- else -%}
            {{ 'products.product.sold_out' | t }}
          {%- endif -%}
        </span>
        <span class="pdp-sticky-atc__added" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
          Added
        </span>
      </button>
      <span class="visually-hidden" role="status" data-pdp-sticky-status></span>
    </div>
  </div>
</div>
