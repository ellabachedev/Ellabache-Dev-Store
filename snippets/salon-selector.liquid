<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/magnific-popup.js/1.1.0/magnific-popup.min.css">
<style>
  :root{
    --ink:        #001e37;
    --navy:       #001e37;
    --lightgray:  #efefef;
    --plum-deep:  #001e37;
    --blush:      #F3D9DE;
    --ivory:      #FBF6F1;
    --white:      #ffffff;
    --gold:       #001e37;
    --gold-soft:  #E7C892;
    --line:       #E7DCDF;
    --shadow:     0 24px 60px -20px rgba(52, 24, 42, 0.35);
  }
  /* ---------- Magnific overrides ---------- */
  .mfp-bg.salon-mfp-bg{
    background: rgba(36, 27, 34, 0.55);
    opacity: 1;
    backdrop-filter: blur(2px);
  }
  body .salon-selector-mfp-wrap .mfp-container{text-align:right;}
  .salon-selector-mfp-wrap .mfp-container{ padding: 0; }
  .salon-selector-mfp-wrap .mfp-container{
  padding:0;
  }
  body .salon-selector-mfp-wrap .mfp-container .mfp-content{
    max-width:500px;
  }

  /* ---------- Popup shell ---------- */
  .salon-popup{
    background: var(--white);
    width: 100%;
    max-width: 500px;
    margin: 0;
    box-shadow: var(--shadow);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 100vh;
  }

  .salon-popup__header{
    position: sticky;
    top: 0;
    z-index: 3;
    background: var(--navy);
    color: var(--ivory);
    padding: 22px 22px 20px;
    display:flex;
    align-items:flex-start;
    justify-content:space-between;
    gap: 12px;
  }
  .salon-popup__title{
    font-weight: 600;
    margin: 0 0 2px;
  }
  .salon-popup__subtitle{
    margin:0;
    color: rgba(251,246,241,0.72);
  }
  .salon-popup__close{
    background: rgba(251,246,241,0.12);
    border: none;
    color: var(--ivory);
    width: 34px;
    height: 34px;
    display:flex;
    align-items:center;
    justify-content:center;
    cursor:pointer;
    flex-shrink:0;
    transition: background .15s ease, transform .15s ease;
  }
  .salon-popup__close:hover{ background: rgba(251,246,241,0.22); }
  .salon-popup__close:focus-visible{ outline: 2px solid var(--gold-soft); outline-offset: 2px; }
  .salon-popup__close svg{ width:16px; height:16px; }

  /* ---------- Search ---------- */
  .salon-search{
    padding: 18px 22px 6px;
    background: var(--lightgray);
  }
  .salon-search__field{
    position: relative;
    display:flex;
    align-items:center;
    background: #fff;
    border: 1.5px solid var(--line);
    padding: 4px 6px 4px 18px;
    transition: border-color .15s ease, box-shadow .15s ease;
  }
  .salon-search__field:focus-within{
    border-color: var(--navy);
    box-shadow: 0 0 0 4px rgba(0,30,55,0.14);
  }
  .salon-search__field input{
    flex:1;
    border:none;
    outline:none;
    padding: 10px 6px;
    background: transparent;
    color: var(--ink);
  }
  .salon-search__field input::placeholder{ color: #9C8E93; }

  .salon-search__wrap{ position: relative; }

  .salon-suggestions{
    list-style:none;
    margin: 6px 0 0;
    padding: 6px;
    position:absolute;
    top: 100%;
    left:0;
    right:0;
    z-index: 5;
    background: #fff;
    border: 1px solid var(--line);
    box-shadow: 0 18px 34px -18px rgba(52,24,42,0.35);
    max-height: 260px;
    overflow-y: auto;
    display:none;
  }
  .salon-suggestions.is-open{ display:block; }

  .salon-suggestions__item{
    width:100%;
    display:block;
    text-align:left;
    background:none;
    border:none;
    padding: 9px 10px;
    cursor:pointer;
  }
  .salon-suggestions__item:hover,
  .salon-suggestions__item.is-active{
    background: var(--lightgray);
  }
  .salon-suggestions__item:focus-visible{
    outline: 2px solid var(--gold);
    outline-offset: -2px;
  }
  .salon-suggestions__name{
    font-weight: 600;
    color: var(--ink);
    margin: 0 0 2px;
  }
  .salon-suggestions__address{
    color: #85777C;
    margin: 0;
  }
  .salon-suggestions__empty{
    padding: 10px 10px;
    color: #85777C;
  }

  .salon-search__locate{
    border:none;
    background: var(--navy);
    color: var(--white);
    width: 38px;
    height: 38px;
    display:flex;
    align-items:center;
    justify-content:center;
    cursor:pointer;
    flex-shrink:0;
    transition: background .15s ease, transform .15s ease;
  }
  .salon-search__locate:hover{ transform: scale(1.04); }
  .salon-search__locate svg{ width:17px; height:17px; }
  .salon-search__locate.is-loading svg{ animation: spin 0.9s linear infinite; }
  @keyframes spin{ to{ transform: rotate(360deg); } }

  .salon-search__clear{
    border:none;
    background:none;
    color: var(--navy);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor:pointer;
    padding: 6px 4px;
    display:none;
  }
  .salon-search__clear.is-visible{ display:inline-block; }

  .salon-search__status{
    margin: 10px 2px 4px;
    color: var(--navy);
    display:flex;
    align-items:center;
    gap: 6px;
    min-height: 18px;
  }
  .salon-search__status svg{ width:13px; height:13px; flex-shrink:0; }
  .salon-search__status.is-muted{ color: #8B7A80; }

  .salon-permission{
    margin: 4px 2px 8px;
    padding: 14px 16px;
    background: var(--blush);
    display:none;
    gap: 10px;
    align-items:flex-start;
  }
  .salon-permission.is-visible{ display:flex; }
  .salon-permission p{
    margin: 0 0 8px;
    line-height: 1.45;
    color: var(--plum-deep);
  }
  .salon-permission strong{ display:block; font-size:.9rem; margin-bottom: 2px; }
  .salon-permission button{
    border:none;
    background: var(--navy);
    color: var(--ivory);
    font-weight: 600;
    padding: 8px 16px;
    cursor:pointer;
  }
  .salon-permission button:hover{ background: var(--plum-deep); }

  /* ---------- List ---------- */
  .salon-list-wrap{
    flex: 1;
    overflow-y: auto;
    padding: 4px 14px 22px 22px;
  }
  .salon-list-heading{
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--navy);
    font-weight: 700;
    margin: 12px 2px 10px;
  }

  .salon-empty{
    display:none;
    flex-direction: column;
    align-items:center;
    text-align:center;
    padding: 46px 20px;
    color: #766A6F;
  }
  .salon-empty.is-visible{ display:flex; }
  .salon-empty svg{ width:38px; height:38px; margin-bottom: 12px; color: var(--navy); }
  .salon-empty p{ margin: 4px 0 14px; font-size:12px; max-width: 320px; }

  .salon-item{
    border: 1px solid var(--line);
    margin-bottom: 10px;
    overflow: hidden;
    background: #fff;
    transition: border-color .15s ease, box-shadow .15s ease;
  }
  .salon-item.is-open{
    border-color: var(--navy);
    box-shadow: 0 10px 26px -16px rgba(75,35,56,0.4);
  }

  .salon-item__summary{
    width: 100%;
    background:none;
    border:none;
    text-align:left;
    padding: 14px 16px;
    display:flex;
    align-items:center;
    gap: 12px;
    cursor:pointer;
  }
  .salon-item__summary:focus-visible{
    outline: 2px solid var(--gold);
    outline-offset: -2px;
  }
  .salon-item__body{ flex:1; min-width:0; }
  .salon-item__name{
    font-weight: 400;
    margin: 0 0 3px;
    color: var(--ink);
    font-size:16px;
  }
  .salon-item__meta{
    margin:0;
    color: #7E7176;
    display:flex;
    align-items:center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .salon-item__distance{
    display:inline-flex;
    align-items:center;
    gap: 4px;
    font-weight: 600;
    color: var(--plum);
    background: var(--blush);
    padding: 2px 9px;
  }
  .salon-item__chevron{
    width: 22px;
    height: 22px;
    flex-shrink:0;
    color: var(--gold);
    transition: transform .2s ease;
  }
  .salon-item.is-open .salon-item__chevron{ transform: rotate(180deg); }

  .salon-item__details{
    max-height: 0;
    overflow: hidden;
    transition: max-height .28s ease;
  }
  .salon-item.is-open .salon-item__details{ max-height: 640px; }

  .salon-item__details-inner{
    padding: 2px 16px 18px;
    border-top: 1px solid var(--line);
    margin-top: 2px;
    padding-top: 14px;
  }
  .salon-item__desc{
    line-height: 1.55;
    color: #564C50;
    margin: 0 0 14px;
  }
  .salon-item__row{
    display:flex;
    align-items:flex-start;
    gap: 10px;
    color: var(--ink);
    margin-bottom: 10px;
  }
  .salon-item__row svg{ width:16px; height:16px; margin-top:1px; color: var(--gold); flex-shrink:0; }
  .salon-item__row a{ color: var(--ink); text-decoration: none; }
  .salon-item__row a:hover{ text-decoration: underline; }

  .salon-book-now{
    display:inline-flex !important;
    align-items:center;
    justify-content:center;
    gap:8px;
    width:100%;
    margin-top: 6px;
    padding: 13px 18px;
    background: var(--gold);
    color: #ffffff;
    font-weight: 700;
    text-decoration:none;
    transition: background .15s ease, transform .15s ease;
  }
  body a[href*="#scs-ols"]{
    display:inline-flex !important;
  }

  .salon-list-wrap::-webkit-scrollbar{ width: 8px; }
  .salon-list-wrap::-webkit-scrollbar-thumb{ background: var(--line); }

  /* ---------- Mobile ---------- */
  @media (max-width: 640px){
    .salon-popup{
      max-width: 100%;
      margin: 0;
      border-radius: 0;
      max-height: 100vh;
      height: 100vh;
    }
    .salon-book-now{ padding: 15px 18px; }
  }

  @media (prefers-reduced-motion: reduce){
    *{ animation-duration: 0.001ms !important; transition-duration: 0.001ms !important; }
  }
  body .mfp-content{
  background:none !important;}
  
  .salon-item__distance{display:none;}
  .salon-popup a[href*="#scs-ols"].scs-show-widget-button{display:inline-flex !important;}
  body .salon-selector-mfp-wrap .mfp-close{font-family:sans-serif; font-weight:300; font-size:36px; margin-top:5px;}
</style>
<button type="button" class="button" id="selectSalonBtn">Book Now</button>
<!-- Stable proxy link for the Shortcuts (ols-widget.min.js) booking widget.
     That script binds its click handler once, at page load, to whatever
     a[href*="#scs-ols-widget"] elements exist at that moment. The real
     "Book Now" buttons live inside the popup and get re-rendered every
     time the salon list updates (search, geolocation, popup reopen), so
     they never end up with that handler attached — clicking them just
     silently updates the URL hash and nothing opens. This anchor stays
     in the DOM permanently so the widget script binds to it once; our
     own click handler (see "SHORTCUTS WIDGET FORWARDING" in the script
     below) copies the clicked salon's href onto this element and clicks
     it, which fires the widget's real handler correctly. Do not remove
     this or move it inside dynamically-rendered markup. -->
<a id="scsWidgetProxy" href="#scs-ols-widget" aria-hidden="true" tabindex="-1"
   style="position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0,0,0,0);"></a>

<!-- ================= POPUP ================= -->
<div id="select-salon-popup" class="salon-popup mfp-hide" role="dialog" aria-modal="true" aria-labelledby="salonPopupTitle">

  <div class="salon-popup__header">
    <div>
      <p class="salon-popup__title" id="salonPopupTitle">Select Your Salon</p>
      {% comment %} <p class="salon-popup__subtitle">Find the nearest location and book in seconds</p> {% endcomment %}
    </div>
    {% comment %} <button type="button" class="salon-popup__close" id="salonPopupClose" aria-label="Close salon selector">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
    </button> {% endcomment %}
  </div>

  <div class="salon-search">
    <label for="salonSearchInput" class="sr-only" style="position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0 0 0 0);">Search by city, postcode or location</label>
    <div class="salon-search__wrap">
      <div class="salon-search__field">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#9C8E93" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
        <input type="text" id="salonSearchInput" placeholder="Search by city, postcode or location" autocomplete="off"
               role="combobox" aria-expanded="false" aria-controls="salonSuggestions" aria-autocomplete="list" />
        <button type="button" class="salon-search__clear" id="salonSearchClear">Clear</button>
        <button type="button" class="salon-search__locate" id="salonLocateBtn" aria-label="Use my location">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3"/></svg>
        </button>
      </div>

      <ul class="salon-suggestions" id="salonSuggestions" role="listbox" aria-label="Matching store addresses"></ul>
    </div>

    <p class="salon-search__status" id="salonSearchStatus"></p>

    <div class="salon-permission" id="salonPermissionBox" style="display:none !important;">
      <div>
        <strong>Find salons near you</strong>
        <p>Allow location access to find salons near your current location, or search for a city or postcode above.</p>
        <button type="button" id="salonUseLocationBtn">Use My Location</button>
      </div>
    </div>
  </div>

  <div class="salon-list-wrap">
    <p class="salon-list-heading" id="salonListHeading">Nearby Salons</p>

    <div id="salonList"></div>

    <div class="salon-empty" id="salonEmptyState">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
      <h3>No salons found</h3>
      <p>Try searching for another city, area or postcode.</p>
      <button type="button" class="salon-search__clear is-visible" id="salonEmptyClear">Clear Search</button>
    </div>
  </div>

</div>

