  function geocodeQuery(query){
    var q = query.trim().toLowerCase();
    if(!q || q.length < 3) return null;
    for(var i = 0; i < GEOCODE_INDEX.length; i++){
      var entry = GEOCODE_INDEX[i];
      for(var j = 0; j < entry.match.length; j++){
        if(q.indexOf(entry.match[j]) !== -1 || entry.match[j].indexOf(q) === 0){
          return { lat: entry.lat, lng: entry.lng, label: entry.label };
        }
      }
    }
    return null;
  }

