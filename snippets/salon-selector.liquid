    }
    var url = "https://nominatim.openstreetmap.org/search?format=jsonv2&limit=1&countrycodes=au&q=" + encodeURIComponent(query);
    return fetch(url, { headers: { "Accept": "application/json" } })
      .then(function(res){
        if(!res.ok) throw new Error("geocode failed");
        return res.json();
      })
      .then(function(data){
        var result = null;
        if(data && data.length){
          var hit = data[0];
          result = {
            lat: parseFloat(hit.lat),
            lng: parseFloat(hit.lon),
            label: hit.display_name ? hit.display_name.split(",").slice(0, 2).join(",").trim() : query
          };
        }
        geocodeCache[cacheKey] = result;
        return result;
      });
  }

  // Reverse-geocodes lat/lng into a short place label (e.g. "Fitzroy, VIC")
  // via Nominatim, so the UI can show the user's actual suburb instead of
  // a generic "your current location" string. Same rate-limit caveat as
  // geocodeViaApi above applies.
  function reverseGeocodeViaApi(lat, lng){
    var url = "https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat=" + lat + "&lon=" + lng + "&zoom=14";
    return fetch(url, { headers: { "Accept": "application/json" } })
      .then(function(res){
        if(!res.ok) throw new Error("reverse geocode failed");
        return res.json();
      })
      .then(function(data){
        if(!data || !data.address) return null;
        var addr = data.address;
        var locality = addr.suburb || addr.neighbourhood || addr.village || addr.town || addr.city_district || addr.city;
        var region = addr.state_district || addr.state || addr.city;
        var parts = [locality, region].filter(Boolean);
        // avoid "Melbourne, Melbourne" style dupes
        if(parts.length === 2 && parts[0] === parts[1]) parts = [parts[0]];
        return parts.length ? parts.join(", ") : null;
      })
      .catch(function(){ return null; });
  }

  function textMatches(salon, query){
    if(!query) return true;
    var haystack = [salon.title, salon.address, salon.city, salon.country, salon.state, salon.country, salon.postcode]
      .filter(Boolean).join(" ").toLowerCase();
    return haystack.indexOf(query.toLowerCase()) !== -1;
  }

  function recalc(){
    var origin = state.selectedLocation || state.detectedLocation;
    var geoMatch = state.searchQuery ? geocodeQuery(state.searchQuery) : null;
    // apiActive: an external (Nominatim) geocode is currently backing the *current* search text
    var apiActive = state.externalGeoActive && state.externalGeoQuery === state.searchQuery;
    var skipTextFilter = !!geoMatch || apiActive;

    var effectiveOrigin = geoMatch || (apiActive ? state.selectedLocation : null) || origin;

    var list = state.salons.map(function(s){
      var withDistance = Object.assign({}, s);
      if(effectiveOrigin){
        withDistance.distance = haversineKm(effectiveOrigin.lat, effectiveOrigin.lng, s.latitude, s.longitude);
      }
      return withDistance;
    });

    if(state.searchQuery && !skipTextFilter){
      list = list.filter(function(s){ return textMatches(s, state.searchQuery); });
    }

    list.sort(function(a, b){
      if(a.distance != null && b.distance != null) return a.distance - b.distance;
      return a.title.localeCompare(b.title);
    });

    state.filteredSalons = list;
    render();
  }

  function escapeHtml(str){
    return String(str || "").replace(/[&<>"']/g, function(c){
      return { "&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#39;" }[c];
    });
  }

  function buildBookingUrl(salon){
    if(!salon.bookingUrl) return "";

    var hash = "";
    if(salon.bookingWidgetSiteId){
      hash = "scs-ols-widget=sites/" + salon.bookingWidgetSiteId + "/services";
    } else if(salon.bookingHash){
      hash = salon.bookingHash.replace(/^#/, "");
    }

    if(!hash) return salon.bookingUrl;

    var base = salon.bookingUrl.split("#")[0];
    return base + "#" + hash;
  }

  function salonRowTemplate(salon, index){
    var isOpen = state.expandedSalon === salon.id;
    var distanceHtml = salon.distance != null
      ? '<span class="salon-item__distance">' +
          '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="m3 11 18-7-7 18-2-7-9-4Z"/></svg>' +
          formatDistance(salon.distance) +
        '</span>'
      : "";

    var phoneHtml = salon.phone
      ? '<div class="salon-item__row"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.11 4.18 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.68 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.32 1.85.55 2.81.68A2 2 0 0 1 22 16.92Z"/></svg>' +
          '<a href="tel:' + escapeHtml(salon.phone.replace(/\s+/g,'')) + '">' + escapeHtml(salon.phone) + '</a></div>'
      : "";

    var bookingUrl = buildBookingUrl(salon);
    var isEnquiry = /^https?:\/\//i.test(salon.bookingUrl || "");
    var bookHtml = bookingUrl
      ? '<a class="button button--full-width ' + (isEnquiry ? 'scs-enquiry-button' : 'scs-show-widget-button select-salon-shortcutsbooking') + '" href="' + escapeHtml(bookingUrl) + '"' +
          (isEnquiry ? ' target="_blank" rel="noopener"' : '') +
          '>' + (isEnquiry ? 'Enquire Now' : 'Book Now') + '</a>'
      : "";

    var cityLine = [salon.city, salon.state].filter(Boolean).join(" ");
    var descHtml = salon.description
      ? '<p class="salon-item__desc">' + escapeHtml(salon.description) + '</p>'
      : "";

    return (
      '<div class="salon-item' + (isOpen ? ' is-open' : '') + '" data-salon-id="' + salon.id + '">' +
        '<button type="button" class="salon-item__summary" aria-expanded="' + isOpen + '" aria-controls="salon-details-' + index + '">' +
          '<div class="salon-item__body">' +
            '<p class="salon-item__name">' + escapeHtml(salon.title) + '</p>' +
            '<p class="salon-item__meta">' + escapeHtml(cityLine) + distanceHtml + '</p>' +
          '</div>' +
          '<svg class="salon-item__chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>' +
        '</button>' +
        '<div class="salon-item__details" id="salon-details-' + index + '">' +
          '<div class="salon-item__details-inner">' +
            descHtml +
            '<div class="salon-item__row"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>' +
              '<span>' + escapeHtml(salon.address) + '</span></div>' +
            phoneHtml +
            bookHtml +
          '</div>' +
        '</div>' +
      '</div>'
    );
  }

  function render(){
    var hasResults = state.filteredSalons.length > 0;
    $emptyState.classList.toggle("is-visible", !hasResults);
    $list.style.display = hasResults ? "" : "none";

    $listHeading.textContent = state.selectedLocation
      ? "Nearest to " + state.selectedLocation.label
      : (state.searchQuery ? "Search Results" : "Nearby Salons");

    if(hasResults){
      $list.innerHTML = state.filteredSalons.map(salonRowTemplate).join("");
    } else {
      $list.innerHTML = "";
    }

    $clear.classList.toggle("is-visible", !!state.searchQuery);
  }

  var debounceTimer = null;
  function debounce(fn, wait){
    return function(){
      var args = arguments;
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(function(){ fn.apply(null, args); }, wait);
    };
  }

  function applySearchQuery(value){
    state.searchQuery = value;
    state.externalGeoActive = false;

    var geoMatch = geocodeQuery(value);
    if(geoMatch){
      state.selectedLocation = geoMatch;
      setStatus('📍 Showing salons near ' + geoMatch.label, false);
      recalc();
      return;
    }

    if(!value.trim()){
      state.selectedLocation = state.detectedLocation || null;
      setStatus(state.detectedLocation ? "📍 Using your current location" : "", true);
      recalc();
      return;
    }

    setStatus('Filtering by "' + value.trim() + '"', true);
    recalc();

    // Only fall back to the geocoding API when the local index AND the text
    // filter both come up empty (e.g. a postcode or suburb not in our list).
    if(value.trim().length < 3 || state.filteredSalons.length > 0) return;

    var seq = ++searchSeq;
    setStatus('Searching for "' + value.trim() + '"…', true);

    geocodeViaApi(value.trim()).then(function(result){
      if(seq !== searchSeq) return; // user kept typing — ignore this stale response
      if(!result){
        setStatus('No salons found near "' + value.trim() + '". Try another postcode, suburb or city.', true);
        return;
      }
      state.selectedLocation = result;
      state.externalGeoActive = true;
      state.externalGeoQuery = value;
      setStatus('📍 No exact match for "' + value.trim() + '" — showing all salons sorted by distance from ' + result.label, false);
      recalc();
    }).catch(function(){
      if(seq !== searchSeq) return;
      setStatus("Couldn't look up that location — check your connection and try again.", true);
    });
  }

  var handleSearchInput = debounce(applySearchQuery, 220);

  $search.addEventListener("input", function(e){
    var value = e.target.value;
    handleSearchInput(value);
    updateSuggestions(value);
  });

  $search.addEventListener("focus", function(e){
    updateSuggestions(e.target.value);
  });

  function clearSearch(){
    $search.value = "";
    state.searchQuery = "";
    state.selectedLocation = state.detectedLocation;
    state.externalGeoActive = false;
    state.externalGeoQuery = null;
    setStatus(state.detectedLocation ? "📍 Using your current location" : "", true);
    recalc();
    closeSuggestions();
    $search.focus();
  }
  $clear.addEventListener("click", clearSearch);
  $emptyClear.addEventListener("click", clearSearch);

  function setStatus(text, muted){
    $status.textContent = text || "";
    $status.classList.toggle("is-muted", !!muted);
  }

  var suggestionItems = [];
  var suggestionActiveIndex = -1;

  function matchesSuggestion(salon, q){
    var haystack = [salon.title, salon.address, salon.city, salon.state, salon.postcode]
      .filter(Boolean).join(" ").toLowerCase();
    return haystack.indexOf(q) !== -1;
  }

  function updateSuggestions(rawValue){
    var q = (rawValue || "").trim().toLowerCase();

    if(!q){
      closeSuggestions();
      return;
    }

    suggestionItems = state.salons.filter(function(s){ return matchesSuggestion(s, q); }).slice(0, 8);
    suggestionActiveIndex = -1;
    renderSuggestions(q);
  }

  function renderSuggestions(q){
    if(!suggestionItems.length){
      $suggestions.innerHTML = '<li class="salon-suggestions__empty">No matching store addresses</li>';
      $suggestions.classList.add("is-open");
      $search.setAttribute("aria-expanded", "true");
      return;
    }

    $suggestions.innerHTML = suggestionItems.map(function(s, i){
      return (
        '<li role="option" id="salon-suggestion-' + i + '">' +
          '<button type="button" class="salon-suggestions__item' + (i === suggestionActiveIndex ? ' is-active' : '') + '" data-suggestion-index="' + i + '">' +
            '<p class="salon-suggestions__name">' + escapeHtml(s.title) + '</p>' +
            '<p class="salon-suggestions__address">' + escapeHtml(s.address) + '</p>' +
          '</button>' +
        '</li>'
      );
    }).join("");

    $suggestions.classList.add("is-open");
    $search.setAttribute("aria-expanded", "true");
  }

  function closeSuggestions(){
    suggestionItems = [];
    suggestionActiveIndex = -1;
    $suggestions.classList.remove("is-open");
    $suggestions.innerHTML = "";
    $search.setAttribute("aria-expanded", "false");
  }

  function selectSuggestion(index){
    var salon = suggestionItems[index];
    if(!salon) return;

    $search.value = salon.address;
    state.searchQuery = "";
    state.externalGeoActive = false;
    state.externalGeoQuery = null;
    state.selectedLocation = {
      lat: salon.latitude,
      lng: salon.longitude,
      label: [salon.city, salon.state].filter(Boolean).join(", ") || salon.title
    };
    setStatus('📍 Showing salons near ' + salon.address, false);
    closeSuggestions();
    recalc();

    state.expandedSalon = salon.id;
    state.selectedSalon = salon.id;
    render();
    syncWithMapbox(salon.id);
    var openedEl = $list.querySelector('[data-salon-id="' + salon.id + '"]');
    if(openedEl) openedEl.scrollIntoView({ block: "nearest", behavior: "smooth" });
  }

  $suggestions.addEventListener("click", function(e){
    var btn = e.target.closest(".salon-suggestions__item");
    if(!btn) return;
    selectSuggestion(parseInt(btn.getAttribute("data-suggestion-index"), 10));
  });

  $search.addEventListener("keydown", function(e){
    if(!$suggestions.classList.contains("is-open") || !suggestionItems.length) return;

    if(e.key === "ArrowDown"){
      e.preventDefault();
      suggestionActiveIndex = Math.min(suggestionActiveIndex + 1, suggestionItems.length - 1);
      renderSuggestions();
    } else if(e.key === "ArrowUp"){
      e.preventDefault();
      suggestionActiveIndex = Math.max(suggestionActiveIndex - 1, 0);
      renderSuggestions();
    } else if(e.key === "Enter"){
      if(suggestionActiveIndex >= 0){
        e.preventDefault();
        selectSuggestion(suggestionActiveIndex);
      }
    } else if(e.key === "Escape"){
      closeSuggestions();
    }
  });

  document.addEventListener("click", function(e){
    if(!e.target.closest(".salon-search__wrap")){
      closeSuggestions();
    }
  });

  function requestLocation(){
    if(!("geolocation" in navigator)){
      state.locationPermission = "unavailable";
      $permBox.classList.add("is-visible");
      setStatus("Location isn't available on this device — search manually instead.", true);
      return;
    }

    state.isLoadingLocation = true;
    $locateBtn.classList.add("is-loading");
    setStatus("Finding salons near you…", true);

    navigator.geolocation.getCurrentPosition(
      function(position){
        state.isLoadingLocation = false;
        $locateBtn.classList.remove("is-loading");
        state.locationPermission = "granted";
        $permBox.classList.remove("is-visible");

        var coords = { lat: position.coords.latitude, lng: position.coords.longitude, label: "your current location" };
        state.userLocation = coords;
        state.detectedLocation = coords;

        if(!state.searchQuery){
          state.selectedLocation = coords;
          $search.value = "";
          setStatus("📍 Finding your location…", true);
        }
        recalc();

        reverseGeocodeViaApi(coords.lat, coords.lng).then(function(label){
          if(!label) return;
          coords.label = label; // updates in place — selectedLocation/detectedLocation both reference this object

          if(state.selectedLocation === coords){
            setStatus("📍 Near " + label, false);
          }
          render(); // refresh the "Nearest to …" heading with the real label
        });
      },
      function(error){
        state.isLoadingLocation = false;
        $locateBtn.classList.remove("is-loading");
        state.locationPermission = "denied";
        $permBox.classList.add("is-visible");
        setStatus("Couldn't detect your location — search by city or postcode instead.", true);
        recalc();
      },
      { enableHighAccuracy: false, timeout: 8000, maximumAge: 5 * 60 * 1000 }
    );
  }

  $locateBtn.addEventListener("click", requestLocation);
  $useLocBtn.addEventListener("click", requestLocation);

  $list.addEventListener("click", function(e){
    var summary = e.target.closest(".salon-item__summary");
    if(summary){
      var item = summary.closest(".salon-item");
      var id = item.getAttribute("data-salon-id");

      state.expandedSalon = (state.expandedSalon === id) ? null : id;
      state.selectedSalon = state.expandedSalon;

      render();

      if(state.expandedSalon === id){
        syncWithMapbox(id);
      }
      return;
    }

    forwardShortcutsWidgetClick(e);
  });

  /* SHORTCUTS WIDGET FORWARDING
     Book Now links whose href points at the Shortcuts booking widget
     (contains "scs-ols-widget") get re-rendered every time the salon
     list updates, so ols-widget.min.js's own one-time, page-load click
     binding never reaches them. We intercept the click ourselves, copy
     the real href onto the always-present #scsWidgetProxy anchor (which
     the widget script DID bind to at page load), and click that instead
     — its handler reads the href off the clicked element, so this opens
     the widget for the correct site/service. Any other Book Now link
     (https, tel:, plain "#anchor", etc.) is left completely alone. */
  function forwardShortcutsWidgetClick(e){
    var bookLink = e.target.closest('a[href*="scs-ols-widget"]');
    if(!bookLink) return;

    e.preventDefault();

    var proxy = document.getElementById("scsWidgetProxy");
    if(!proxy) return;

    proxy.setAttribute("href", bookLink.getAttribute("href"));
    proxy.click();
  }

  function syncWithMapbox(salonId){
    var salon = state.salons.find(function(s){ return s.id === salonId; });
    if(!salon) return;
    document.dispatchEvent(new CustomEvent("salon:selected", { detail: salon }));
  }

  jQuery(function($){
    $("#selectSalonBtn").magnificPopup({
      items: {
        src: "#select-salon-popup",
        type: "inline"
      },
      mainClass: "salon-selector-mfp-fade",
      removalDelay: 200,
      closeBtnInside: false,
      focus: "#salonSearchInput",
      midClick: true,
      callbacks: {
        beforeOpen: function(){
          this.st.mainClass = "salon-selector-mfp-fade";
          this.wrap.addClass("salon-selector-mfp-wrap");
          this.bgOverlay.addClass("salon-selector-mfp-bg");
        },
        open: function(){
          state.popupOpen = true;
          recalc();
          if(state.locationPermission === "unknown"){
            requestLocation();
          }
        },
        close: function(){
          state.popupOpen = false;
        }
      }
    });

    {% comment %} $("#salonPopupClose").on("click", function(){
      $.magnificPopup.close();
    }); {% endcomment %}
  });

  recalc();

})();
</script>
