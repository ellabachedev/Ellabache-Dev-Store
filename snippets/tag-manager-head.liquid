<!-- Google Tag Manager -->
{% comment %}
<script>
window.dataLayer = window.dataLayer || [];

  dataLayer.push({
    event: "all_standard_events",
    data: event?.data,
    fired_from: "custom_pixel"
  });
  
if(Shopify.Checkout != null && Shopify.Checkout != undefined){
  if(Shopify.Checkout.step != null && Shopify.Checkout.step != undefined){
    if(Shopify.Checkout.step == 'thank_you'){
      console.log("Shopify.Checkout.step == 'thank_you'");

      var customer_type = "";
      {% if checkout.customer.orders_count %}
        if({{ checkout.customer.orders_count }} > 1) customer_type = "repeat_customer";
        else customer_type = "new_customer";
      {% endif %}  
      
      dataLayer.push({ ecommerce: null });
      dataLayer.push({
        event: "purchase_customer_type",
        ecommerce: {
            transaction_id: "{{ order.order_number }}",
            value: {{ order.total_price | times: 0.01 }},
            tax: {{ order.tax_price | times: 0.01 }},
            shipping: {{ order.shipping_price | times: 0.01 }},
            currency: "{{ order.currency }}",
            customer_type: customer_type,
            items: [
             {% for line_item in order.line_items %}{
              item_id: "{{ line_item.product_id }}",
              item_name: "{{ line_item.title | remove: "'" | remove: '"' }}",
              currency: "{{ order.currency }}",
              price: {{ line_item.final_price | times: 0.01 }},
              quantity: {{ line_item.quantity }}
            },{% endfor %}
       ]
        }
      });
      console.log('dataLayer push for {{ order.order_number }}');
    }
  }
}
</script>
{% endcomment %}
<script>
