{%- if settings.free_gwp_warning_enabled -%}
    <style>
    /* Styles for the popup */
    .free_gwp-warning-wrap {
      position: fixed;
      top: 50%;
      left: 50%;
      max-width:500px;
      width: 100%;
      background: rgb(237, 237, 237);
      padding:0;
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
      display: none;
      z-index: 99999;
      transform:translate(-50%, -50%);
    }
    .free_gwp-warning-content-wrap {
      width: 100%;
      text-align: center;
      align-content: center;
      position:relative;
      z-index:2;
      padding-top:28px;
      padding-bottom:23px;
      padding-left:20px;
      padding-right:20px;
    }

    #closePopup {
      width: 19px;
      top: 15px;
      right:15px;
      position: absolute;
      z-index:2;
    }
      #closePopup a{
        display:block;
      }
      #closePopup svg{
        display:block;
      }
      #closePopup svg line{
        stroke:#ffffff;
      }

    .free_gwp_threshold--indicator {
      display: none;
      position: relative;
      max-width: 400px;
      margin-left: auto;
      margin-right: auto;
      margin-bottom:10px;
    }

    .free_gwp_threshold--indicator .indicator-track {
      background-color: #ffffff;
      border-radius: 30px;
      -webkit-border-radius: 30px;
      -ms-border-radius: 30px;
      -moz-border-radius: 30px;
      width: 100%;
      height: 12px;
      position: relative;
      overflow: hidden;
    }

    .free_gwp_threshold--indicator .indicator-track .indicator-level {
      position: absolute;
      left: 0;
      top: 0;
      width: 10%;
      height: 12px;
      z-index: 1;
      background-color: #a5a5a8;
      border-radius: 30px;
      -webkit-border-radius: 30px;
      -ms-border-radius: 30px;
      -moz-border-radius: 30px;
      -webkit-transition: 0.5s ease-in;
      transition: 0.5s ease-in;
      -o-transition: 0.5s ease-in;
      transition: 0.5s ease-in;
    }
      .free_gwp-warning{
        margin-bottom:10px;
        font-size:18px;
        letter-spacing:0.5px;
        max-width:400px;
        margin-left:auto;
        margin-right:auto;
      }
      .free_gwp-warning strong{
        color: #001e37;
        font-size:23px;
        margin-top: 5px;
        display: block;
        margin-bottom: 10px;
        margin-top:0;
      }
      .free_gwp-warning-wrap .popup_content{
        width:100%;
      }
      .free_gwp-warning-wrap .popup_content h3{
        margin: 0;
        padding: 12px 10px;
        text-transform: uppercase;
        color: #ffffff;
        font-size: 20px;
        text-align: center;
        background-color: #001e37;
        letter-spacing: 1px;
      }
      .free_gwp-warning-wrap .popup_content .cta.flex-container {
        gap:10px;
      }
      .free_gwp-warning-wrap .popup_content .cta .btn{
        padding:7px 10px;
        font-size:16px;
        min-width:164px;
        text-align:center;
      }
      .free_gwp-warning-wrap .popup_content .cta .btn_primary{
        border:2px solid #001e37;
        background-color:#001e37;
        color:#ffffff; 
      }
      .free_gwp-warning-wrap .popup_content .cta .btn_primary-outline{
        border:2px solid #001e37;
        color:#001e37;
      }
      .free_gwp-warning-wrap .popup_content .cta .btn_primary-outline:hover{
         border:2px solid #001e37;
        background-color:#001e37;
        color:#ffffff; 
      }
      .gwp_product{
        margin-bottom:20px;
        max-width:338px;
        margin-left:auto;
        margin-right:auto;
        padding:0 30px;
      }
      .gwp_product .item .flex-container{
        gap:18px;
        align-items:center;
        justify-content: flex-start;
        padding: 5px 0;
      }
      .gwp_product .item img{
        width:70px;
        height:70px;
        border:1px solid rgba(165, 165, 168, 0.2);
        object-fit:cover;
        background-color:#ffffff;
      }
      .gwp_product .item h4{
        font-size:16px;
        margin:0;
        width: calc(100% - 88px);
        text-align:left;
        line-height:1.4;
      }
      .gwp_product.slick-slider .slick-arrow {
          width: 26px;
          height: 100%;
      }
      .gwp_product.slick-slider button.slick-prev{left:0;}
      .gwp_product.slick-slider button.slick-next{right:0;}
      .gwp_product button.slick-arrow:before, .gwp_product button.slick-arrow:after{
        width:14px;
      }
      .gwp_product.slick-slider .slick-arrow.slick-prev:before, .gwp_product.slick-slider .slick-arrow.slick-prev:after {
          left: 5px;
      }
      .gwp_product.slick-slider .slick-arrow.slick-next:before, .gwp_product.slick-slider .slick-arrow.slick-next:after {
          left: 8px;
      }
      .gwp_product.slick-slider .slick-arrow:after {
          top: calc(50% + 4.5px);
      }
      .gwp_product.slick-slider .slick-arrow:before {
          top: calc(50% - 6px);
      }
      .gwp_product.slick-slider .slick-arrow.slick-prev:before {
          transform: rotate(-52deg);
      }
      .gwp_product.slick-slider .slick-arrow.slick-prev:after {
          transform: rotate(52deg);
      }
      .gwp_product.slick-slider .slick-arrow.slick-next:before {
          transform: rotate(52deg);
      }
      .gwp_product.slick-slider .slick-arrow.slick-next:after {
          transform: rotate(-52deg);
      }
      .gpw_popup-overlay{
        display:none;
          width: 100%;
          height: 100%;
          background-color: transparent;
          position: fixed;
          left: 0;
          top: 0;
          z-index: 9999;
      }
      .overlay-blur .gpw_popup-overlay{
        display:block;
      }
      @media only screen and (max-width: 480px) {
        #closePopup{
          top:11px;
        }
        .free_gwp-warning-wrap {
            max-width: 360px;
        }
        .free_gwp-warning-wrap .popup_content h3{
          font-size:18px;
        }
        .free_gwp-warning{
          font-size:16px;
        }
        .free_gwp-warning strong{
          font-size:20px;
        }
        .free_gwp-warning-wrap .popup_content .cta .btn {
            font-size: 14px;
            min-width: 150px;
        }
        .overlay-blur #cart-mini{
          filter: blur(2px);
        }
      }
    </style>
  <div class="gpw_popup-overlay"></div>
    <div id="free_gwp-warning-popup" class="free_gwp-warning-wrap">
      <div id="closePopup">
        <a href="#" aria-label="close"><svg data-name="Layer 1" viewBox="0 0 64 64"><line x1="9.37" x2="54.63" y1="9.37" y2="54.63" fill="none" stroke="#010101" stroke-miterlimit="10" stroke-width="4"></line><line x1="9.37" x2="54.63" y1="54.63" y2="9.37" fill="none" stroke="#010101" stroke-miterlimit="10" stroke-width="4"></line></svg></a>
      </div>
      <div class="popup_content">
        <h3>You're almost there!</h3>
        <div class="free_gwp-warning-content-wrap">
          <div class="free_gwp_threshold--indicator">
              <div class="indicator-track">
                  <span class="indicator-level"></span>
              </div>
          </div>
          <div class="free_gwp-warning" data-free_gwp_message="{{ settings.free_gwp_message }}" data-free_gwp_message_amount_case="{{ settings.free_gwp_message_amount_case }}" data-delay="{{ settings.free_gwp_popup_load_delay }}" style="display:none;">-</div>
          <div class="gwp_product">-</div>
          <div class="cta flex-container">
            <a class="btn btn_primary" id="continueShoppingForGWP" href="{{ shop.secure_url }}{{ settings.continue_to_collection.url }}">Continue Shopping</a>
            <a class="btn btn_primary-outline" id="checkoutFromGwp" href="javascript:void(0)">Checkout</a>
          </div>
        </div>
      </div>
    </div>
{%- endif -%}