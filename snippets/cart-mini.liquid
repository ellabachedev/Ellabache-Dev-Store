<link
rel="stylesheet"
  media="print"
  onload="this.onload=null;this.removeAttribute('media');"
  href="{{ 'cart-mini.css' | asset_url }}">
<!-- no-JS fallback -->
<noscript>
  <link rel="stylesheet" href="{{ 'cart-mini.css' | asset_url }}">
</noscript>
<link
rel="stylesheet"
  media="print"
  onload="this.onload=null;this.removeAttribute('media');"
  href="{{ 'magnific-popup.css' | asset_url }}">
<!-- no-JS fallback -->
<noscript>
  <link rel="stylesheet" href="{{ 'magnific-popup.css' | asset_url }}">
</noscript>
<script src="{{ 'cart-mini.js' | asset_url }}" defer="defer"></script>
<div
  id="cart-mini"
  style="display:none;"
  class="cart"
  data-cart-view>
  <div id="order-cart" class="content">
    <div class="cart-header">
      <div class="close-cart">
        <a href="#" aria-label="close">{%- render 'icon-cross' -%}</a>
      </div>
      <div class="tab-menu">
        <div class="flex-container">
          <div class="tab-menu-item">
            <a href="#" data-tab="tabCart">Cart</a>
          </div>
          <div class="tab-menu-item">
            <a href="#" data-tab="tabWishlist">Wish List</a>
          </div>
        </div>
      </div>
      {% comment %}
      <h3>{{ 'cart.general.title' | t }}</h3>
      {% endcomment %}
    </div>
    <div class="tab-content">
      <div id="tabCart" class="tab-content-item">
        <div data-rv-show="cart.item_count | gt 0">
          {% comment %}<div class="loader"></div>{% endcomment %}
          {%- if settings.free_shipping_threshold_warning_enabled or settings.enable_buyX_getY -%}
            <div class="mini-cart-header bg__grey--light">
              {%- include 'shipping-threshold-warning' -%}
              {%- comment -%} Hidden until the Free Gifts app reports an offer with a choice of gifts (cart-mini.js shows it). {%- endcomment -%}
              <a id="btnClaimSamplesMain" style="display: none;" href="javascript:void(0)" class="button btn-claim-samples full-width">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3.5" y="8.5" width="17" height="4" rx="0.5"/><path d="M5 12.5v8h14v-8M12 8.5v12M12 8.5c-1.5-3.5-5.5-4-5.5-1.5 0 1.5 2.5 1.5 5.5 1.5Zm0 0c1.5-3.5 5.5-4 5.5-1.5 0 1.5-2.5 1.5-5.5 1.5Z"/></svg>
                <span>choose your bonus gift</span>
              </a>
              {% comment %}{%- include 'buyX-getY' -%}{% endcomment %}
            </div>
          {%- endif -%}
          {%- assign itemIndex = cart.item_count | minus: 1 -%}
            <form
            class="mini-cart-form"
            action="/cart"
            method="post"
            novalidate>
            <div class="cart-info">
              <div class="cart-line-item-box" id="minicart-items-wrap">
                <div class="cart-line-item" data-rv-class-sample-item="item.title | includes '% off'" data-rv-each-item="cart.items">
                  <div class="prod-info-container" data-rv-class-sample="item.title | includes '% off'">
                    <div class="minicart-image">
                      <span class="gift-badge" data-rv-show="item.title | includes '% off'" aria-hidden="true">&#127873;</span>
                      <a data-rv-href="item.url">
                        <img
                          data-rv-src="item.image | productImageSize '120x'"
                          draggable="false"
                          src="https://cdn.shopify.com/s/files/1/2999/1646/files/no-image.png?v=1613283316"
                          loading="lazy"
                          alt="">
                      </a>
                    </div>
                    <div class="product-info">
                      <p class="prod-title">
                        <span class="gift-label" data-rv-show="item.title | includes '% off'">Free gift</span>
                        <a data-rv-href="item.url">
                          <span data-rv-text="item.product_title | cleanGiftTitle"></span>
                        </a>
                        <span style="font-weight:400;color: #001e37; font-size:12px;" data-rv-show="item.product_type | eq 'GWP'" class="valued-at" data-rv-html="'Valued at $68'"></span>
                          <span data-rv-if="item.variant_title" class="variant" data-rv-hide="item.title | includes '% off'" data-rv-text="item.variant_title"></span>
                      </p>
                      <div class="minicart-actions">
                        <div data-rv-hide="item.title | includes '% off'" class="minicart-qty-container">
                          {%- comment -%} Quantity buttons use the line's key (stable even when gift lines are added
                              or removed) and are handled, debounced, in cart-mini.js. {%- endcomment -%}
                          <a
                            class="minicart-qty-minus"
                            href="#"
                            role="button"
                            aria-label="Decrease quantity"
                            data-mc-step="-1"
                            data-rv-data-mc-key="item.key">&ndash;</a>
                          <span class="minicart-item-qty-text">
                            <input
                              type="text"
                              name="updates[]"
                              data-mc-qty
                              aria-label="Quantity"
                              data-rv-value="item.quantity"
                              readonly />
                          </span>
                          <a
                            class="minicart-qty-plus"
                            href="#"
                            role="button"
                            aria-label="Increase quantity"
                            data-mc-step="1"
                            data-rv-data-mc-key="item.key">+</a>
                        </div>
                        <!-- <div data-rv-show="item.title | includes '% off'" class="minicart-qty-container">
                        <span class="minicart-item-qty-text" data-rv-html="item.quantity"></span>
                        </div> -->
                        <div data-rv-show="item.title | match 'Hyaluronic Intensive Treatment Booster'" class="free-express-shipping">
                          <script>
                            $(window).on('load', function() {
                              var freeExpressItem = $("#cart-mini .cart-line-item .free-express-shipping").is(':visible');
                              if (freeExpressItem == true) {
                                $("#cart-mini .shipping-warning").html("<strong>Enjoy Free Express Shipping on us</strong>");
                              }
                            });
                          </script>
                        </div>
                        {% comment %}
                        <div data-rv-show="item.product_type | match 'Sample'">
                        {% endcomment %}
                         {% comment %}
                        <div data-rv-show="item.title | includes '% off'">
                          <div class="gift-tag">
                            {%- render 'free_sample_badge' -%}
                          </div>
                        </div>
                        {% endcomment %}
                        {% comment %}
                        <div data-rv-show="item.product_type | match 'GWP'">
                          <div class="gift-tag">
                            <div class="icon">
                              <svg
                                version="1.1"
                                id="Layer_1"
                                xmlns="http://www.w3.org/2000/svg"
                                xmlns:xlink="http://www.w3.org/1999/xlink"
                                x="0px"
                                y="0px"
                                width="30px"
                                height="30px"
                                viewBox="0 0 170.531 195.919"
                                enable-background="new 0 0 170.531 195.919"
                                xml:space="preserve">
                                <path fill="#131428" d="M52.511,195.63c0,0-8.5,1.666-10.833-3l-21-69.161c0,0-3.666,1.667-9.833-1.667l-1.833-1.34l-9-30.66
                                                                                                                            	c0,0-0.5-4.5,5.167-7.833l32-9.333c0,0-38-14.835-18.5-39.168c0,0,16.5-19.506,50.167,19.828c0,0-5.667-31,10.667-47.167
                                                                                                                            	c0,0,26.833-17.833,39.333,7.333c0,0,8.417,19.083-10.083,39.333l34.5-10c0,0,7.25-0.5,10,4.5l8,28c0,0,2.5,8.25-9.75,11.5
                                                                                                                            	l18.75,67.5c0,0,2.25,5.75-6.25,8.75L52.511,195.63z" />
                                <polygon fill="#FFFFFF" points="9.511,90.13 61.678,75.296 69.678,100.63 17.011,115.296 " />
                                <polygon fill="#FFFFFF" points="92.345,66.796 145.011,51.796 152.678,76.63 99.678,92.63 " />
                                <polygon fill="#FFFFFF" points="101.845,100.63 142.678,88.963 162.345,154.63 120.845,167.796 " />
                                <polygon fill="#FFFFFF" points="30.178,120.63 71.011,108.963 90.511,174.463 49.011,187.627 " />
                                <path fill="#FFFFFF" d="M66.011,64.213c0,0-21.667-27-34.167-25.833s-7.667,11.667-7.667,11.667S34.511,68.796,66.011,64.213z" />
                                <path fill="#FFFFFF" d="M79.845,59.88c0,0,34.167-13.417,30.833-38.75c0,0-1.5-15.5-21-9.333
                                                                                                                        	C89.678,11.796,74.928,14.213,79.845,59.88z" />
                              </svg>
                            </div>
                            <span>Free Gift</span>
                          </div>
                        </div>
                        {% endcomment %}
                        <p data-rv-show="item.original_line_price | gt 0" class="gift-value" data-rv-class-gift-value--show="item.title | includes '% off'">
                          Valued at <span data-rv-html="item.original_line_price | money"></span>
                        </p>
                        <p data-rv-hide="item.title | includes '% off'" style="margin:0;" class="prod-price">
                          <span class="price-wrap">
                            <span class="sale-price"
                                  data-rv-show="item.compare_at_line_price | gt item.final_line_price"
                                  data-rv-html="item.final_line_price | money"></span>

                            <s class="original-price" style="color:#e53935; font-size:13px; text-decoration: line-through;text-decoration-color: #e53935;"
                              data-rv-show="item.compare_at_line_price | gt item.final_line_price"
                              data-rv-html="item.compare_at_line_price | money"></s>

                            <span class="regular-price"
                                  data-rv-hide="item.compare_at_line_price | gt item.final_line_price"
                                  data-rv-html="item.final_line_price | money"></span>
                          </span>
                        </p>
                        <div class="cart-remove" data-rv-index="index | plus 1">
                          <a href="#" data-rv-data-cart-remove-id="item.key">
                            {% comment %}<i class="fas fa-trash-alt"></i>{% endcomment %}
                            <img
                              style="max-width:12px;"
                              src="{{ 'icon-cross-light-grey-small.png' | asset_url }}"
                              loading="lazy"
                              alt="close">
                          </a>
                        </div>
                      </div>
                    </div>
                  </div>
                  <!-- end of prod-info-container -->
                </div>
                <!-- end of cart.items -->
              </div>
            </div>
            {%- render 'upsell-products-widget' -%}
            <!-- end of cart-info -->
            <div class="mini-cart-footer">
              <div class="sub-total">
                <p class="subtotal-label">{{ 'cart.general.subtotal' | t }}</p>
                <p class="subtotal-price" data-rv-html="cart.total_price | divide4 | money"></p>
              </div>
              <div class="afterpay-widget-cartdrawer"></div>
              {%- if cart.total_discounts > 0 -%}
                <p>{{ 'cart.general.savings' | t }} {{ cart.total_discounts | money }}</p>
              {%- endif -%}
              <div class="shipping_at_checkout">
                <p>{{ 'cart.general.shipping_at_checkout' | t }}</p>
              </div>
              <div class="checkout-view">
                <input
                  type="submit"
                  name="checkout"
                  id="btnCheckout"
                  class="button primary medium"
                  value="{{ 'cart.general.checkout' | t }}"
                  style="display: block;">
                <input
                type="button"
                  name="checkout"
                  id="btnPopupCheckout"
                  class="button primary medium"
                  value="{{ 'cart.general.checkout' | t }}"
                  style="display: none;">
              {% comment %}<a href="/cart" class="button primary medium">{{ 'cart.general.checkout' | t }}</a>{% endcomment %}
              </div>
              <div class="payment-gateways">
                <span>We Accept:</span>
