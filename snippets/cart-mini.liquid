{% comment %}   Opens  mini cart after   when query parameter is  ?opencart=1 {% endcomment %}

<script>
  // 1. Expose Shopify customer data to JS
  window.shopifyCustomer = {
    {% if customer %}
      loggedIn: true,
      first_name: {{ customer.first_name | json }},
      last_name: {{ customer.last_name | json }},
      email: {{ customer.email | json }},
      phone: {{ customer.phone | json }}
    {% else %}
      loggedIn: false
    {% endif %}
  };

  jQuery(document).ready(function ($) {

    const WEBHOOK_URL = 'https://hook.us1.make.com/ifqidj8dl4wda2ag9pbkjrv39n1i7ym8';
    let lastKnownCartState = null;

    async function sendCartStatus() {
      try {
        if (!window.shopifyCustomer || !window.shopifyCustomer.loggedIn) {
          console.log('Webhook aborted: Customer not logged in');
          return;
        }

        const cart = await fetch('/cart.js').then(res => res.json());

        // ✅ FORCE STRICT BOOLEAN (true/false only)
        const hasItems = Boolean(cart && typeof cart.item_count === 'number' && cart.item_count > 0);

        // safety: ignore invalid cart responses
        if (typeof cart.item_count !== 'number') {
          console.log('Invalid cart response, skipping webhook');
          return;
        }

        // prevent duplicate sends unless state changes
        if (lastKnownCartState === hasItems) return;
        lastKnownCartState = hasItems;

        const payload = {
          first_name: window.shopifyCustomer.first_name,
          last_name: window.shopifyCustomer.last_name,
          email: window.shopifyCustomer.email,
          phone: window.shopifyCustomer.phone,
          has_cart_items: hasItems // ALWAYS true or false
        };

        await fetch(WEBHOOK_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        console.log('Cart state changed. Webhook sent:', payload);

      } catch (error) {
        console.error('Cart tracking error:', error);
      }
    }

    // -----------------------------
    // INTERCEPT FETCH CART CHANGES
    // -----------------------------
    const originalFetch = window.fetch;
    window.fetch = async function (...args) {
      const response = await originalFetch.apply(this, args);
      const url = args[0];

      if (typeof url === 'string' &&
        (
          url.includes('/cart/change.js') ||
          url.includes('/cart/add.js') ||
          url.includes('/cart/update.js') ||
          url.includes('/cart/clear.js')
        )
      ) {
        setTimeout(sendCartStatus, 600);
      }

      return response;
    };

    // -----------------------------
    // INTERCEPT XHR CART CHANGES
    // -----------------------------
    const originalXHRSend = XMLHttpRequest.prototype.send;

    XMLHttpRequest.prototype.send = function (...args) {
      this.addEventListener('load', function () {
        const url = this.responseURL;

        if (
          url &&
          (
            url.includes('/cart/change.js') ||
            url.includes('/cart/add.js') ||
            url.includes('/cart/update.js') ||
            url.includes('/cart/clear.js')
          )
        ) {
          setTimeout(sendCartStatus, 600);
        }
      });

      return originalXHRSend.apply(this, args);
    };

    // -----------------------------
    // OPTIONAL: OPEN CART ONLY
    // -----------------------------
    const urlParams = new URLSearchParams(window.location.search);

    if (urlParams.get('opencart') === '1') {
      setTimeout(function () {
        const cartBtn = document.querySelector('.cart-opener');
        if (cartBtn) {
          console.log("Cart opened via URL param");
          cartBtn.click();
        }
      }, 500);
    }

  });
</script>



