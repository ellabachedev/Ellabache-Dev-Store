{%- capture pdp_image_gallery -%}
<div class="pdp-image-gallery">
  {%- if product.images.size > 0 -%}
    {%- if product.available -%}
      <span
        data-w-variant-quantity="{{ product.variants[0].inventory_quantity }}"
        data-w-variant-sku="{{ product.variants[0].sku }}"
        data-w-variant-title="{{ product.variants[0].title }}"
        data-w-product-handle="{{ product.handle }}"
        data-w-product-title="{{ product.title }}"
        data-w-quantity="1"
        data-w-product-image="{{ product.featured_image.src | img_url: 'grande' }}"
        data-w-product-price="{{ product.variants[0].price | money | remove: '.00' }}"
        data-w-variant-id="{{ product.variants[0].id }}"
        data-w-product-id="{{ product.id }}"
        id="addToWishlist"
        class="add_to_wishlist"
        role="button"
        tabindex="0"
        aria-label="Add to wishlist">{%- render 'icon-heart' -%}<svg class="icon-heart-filled" width="26" height="26" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 21.2 3.7 12.9a5.4 5.4 0 0 1 0-7.6 5.3 5.3 0 0 1 7.6 0l.7.7.7-.7a5.3 5.3 0 0 1 7.6 0 5.4 5.4 0 0 1 0 7.6Z"/></svg><span class="text"><span class="text-add">Add to wishlist</span><span class="text-saved">Saved to wishlist</span></span>
      </span>
    {%- endif -%}
  {%- comment -%} Build variant→image map {%- endcomment -%}
  {%- assign variantImgMap = '' -%}
  {%- for variant in product.variants -%}
    {%- assign img = variant.image.src | default: 'no-image' -%}
    {%- assign variantImgMap = variantImgMap | append: variant.id | append: '|' | append: img -%}
    {%- unless forloop.last %}{% assign variantImgMap = variantImgMap | append: '||' %}{% endunless -%}
  {%- endfor -%}
  {% assign variantImgMapArray = variantImgMap | split: '||' %}
  {%- liquid
    assign slide_count = product.images.size | plus: product.metafields.accentuate.product_grid_image_upload.size
    assign promo_check = product.metafields.accentuate.teaser_video | strip_html | strip
    if promo_check != blank
      assign slide_count = slide_count | plus: 1
    endif
    assign promo_check = product.metafields.accentuate.teaser_video_2 | strip_html | strip
    if promo_check != blank
      assign slide_count = slide_count | plus: 1
    endif
  -%}
  <div class="swiper productHeroSlider{% if slide_count > 1 %} has-multiple-slides{% endif %}">
    <div class="product-card__badges">
      {%- if product.tags contains 'badge new' -%}
        <span class="badge new" style="font-size:16px; padding:4px 8px;font-weight:500;">New</span>
      {%- endif -%}
    </div>
    <div class="swiper-wrapper">
      {%- assign index = 0 -%}
      {%- for image in product.images -%}
        {%- assign dataVariantId = '' -%}
        {%- for variantImg in variantImgMapArray -%}
          {%- assign parts = variantImg | split: '|' -%}
          {%- if parts[1] == image.src -%}
            {%- assign dataVariantId = parts[0] -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}
        <div class="swiper-slide" data-variant-id="{{ dataVariantId }}" data-swiper-index="{{ index }}">
          {%- comment -%} srcset: phones download a small file, retina screens a sharp one (up to 2000px when the original is that big). {%- endcomment -%}
          {%- assign img_alt = image.alt | default: product.title -%}
          {%- if index == 0 -%}
            {{ image | image_url: width: 1500 | image_tag: widths: '480, 768, 1024, 1300, 1600, 2000', sizes: '(min-width: 1300px) 640px, (min-width: 769px) 45vw, calc(100vw - 30px)', alt: img_alt, width: 738, height: 738, loading: 'eager', fetchpriority: 'high' }}
          {%- else -%}
            {{ image | image_url: width: 1500 | image_tag: widths: '480, 768, 1024, 1300, 1600, 2000', sizes: '(min-width: 1300px) 640px, (min-width: 769px) 45vw, calc(100vw - 30px)', alt: img_alt, width: 738, height: 738, loading: 'lazy' }}
          {%- endif -%}
        </div>
        {%- assign index = index | plus: 1 -%}
      {%- endfor -%}
      {%- assign promoVideo = product.metafields.accentuate.teaser_video | strip_html | strip_newlines | strip -%}
      {%- if promoVideo.size > 0 -%}
      <div class="swiper-slide">
        <video style="width:100%; height:100%; display:block; object-fit:cover;"
          controls poster="{{ product.metafields.accentuate.video_poster_image }}" title="Promo video for {{ product.title }}">
          <source src="{{ promoVideo }}" type="video/mp4">
          Your browser does not support the video tag.
        </video>
      </div>
      {%- endif -%}
      {%- assign promoVideo2 = product.metafields.accentuate.teaser_video_2 | strip_html | strip_newlines | strip -%}
      {%- if promoVideo2.size > 0 -%}
      <div class="swiper-slide">
        <video style="width:100%; height:100%; display:block; object-fit:cover;"
          controls poster="{{ product.metafields.accentuate.video_poster_image_2 }}" title="Promo video for {{ product.title }}">
          <source src="{{ promoVideo2 }}" type="video/mp4">
          Your browser does not support the video tag.
        </video>
      </div>
      {%- endif -%}
      {%- for image in product.metafields.accentuate.product_grid_image_upload -%}
        <div class="swiper-slide">
          <img src="{{ image.src | append: '&transform=resize=800'}}"  width="738" height="738" loading="lazy" alt="{{ image.alt }}" />
        </div>
      {%- endfor -%}
    </div>
    <!-- MAIN arrows -->
    <div class="productHero-main-prev swiper-button-prev"></div>
    <div class="productHero-main-next swiper-button-next"></div>
    {%- if show_dots -%}
      <!-- Swipe dots: shown on mobile instead of the thumbnail column -->
      <div class="swiper-pagination productHero-pagination"></div>
    {%- endif -%}
  </div>
  <div class="swiper productHeroSliderThumb">
    <div class="swiper-wrapper">
      {%- for image in product.images -%}
        {%- assign dataVariantId = '' -%}
        {%- for variantImg in variantImgMapArray -%}
          {%- assign parts = variantImg | split: '|' -%}
          {%- if parts[1] == image.src -%}
            {%- assign dataVariantId = parts[0] -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}
        <div class="swiper-slide" data-variant-id="{{ dataVariantId }}">
          <img src="{{ image | img_url: '150x150' }}" width="80" height="80" alt="{{ image.alt | escape }}" >
        </div>
      {%- endfor -%}
      {%- if product.metafields.accentuate.video_poster_image != blank -%}
      <div class="swiper-slide">
         <img src="{{ product.metafields.accentuate.video_poster_image }}" width="80" height="80" alt="Promo Video">
         <span class="video-button">play</span>
      </div>
      {%- endif -%}
      {%- if product.metafields.accentuate.video_poster_image_2 != blank -%}
      <div class="swiper-slide">
         <img src="{{ product.metafields.accentuate.video_poster_image_2 }}" width="80" height="80" alt="Promo Video">
         <span class="video-button">play</span>
      </div>
      {%- endif -%}
      {%- for image in product.metafields.accentuate.product_grid_image_upload -%}
        <div class="swiper-slide">
          <img src="{{ image.src | append: '&transform=resize=150'}}" width="80" height="80" alt="{{ image.alt }}" />
        </div>
      {%- endfor -%}
    </div>
    <!-- THUMB arrows -->
    <div class="productHero-thumb-prev swiper-button-prev"></div>
    <div class="productHero-thumb-next swiper-button-next"></div>
  </div>
{%- else -%}
  <img src="{{ 'no-image.jpg' |  asset_img_url: '400x' }}" alt="No Image">
{%- endif -%}
</div>
{%- endcapture -%}
{{ pdp_image_gallery | strip_newlines }}
{%- if slide_count > 1 or product.metafields.accentuate.video_poster_image != blank or product.metafields.accentuate.video_poster_image_2 != blank -%}
  <script>
    (function () {
      /* Start the gallery as soon as the page is parsed (Swiper is a deferred script), so it can be
         swiped straight away instead of after every app script has loaded. */
      function initProductHeroSlider() {
        if (window.productHeroSlider) return;
        if (typeof Swiper === 'undefined') {
          window.addEventListener('load', initProductHeroSlider);
          return;
        }
        window.productHeroSliderThumb = new Swiper(".productHeroSliderThumb", {
          spaceBetween: 10,
          slidesPerView: 'auto',
          watchSlidesProgress: true,
          direction: 'vertical',
          mousewheel: true,
          navigation: {
            nextEl: ".productHero-thumb-next",
            prevEl: ".productHero-thumb-prev",
          }
        });
        window.productHeroSlider = new Swiper(".productHeroSlider", {
          spaceBetween: 10,
          navigation: {
            nextEl: ".productHero-main-next",
            prevEl: ".productHero-main-prev",
          },
          pagination: {
            el: ".productHero-pagination",
            clickable: true,
          },
          thumbs: {
            swiper: window.productHeroSliderThumb,
          },
        });
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initProductHeroSlider);
      } else {
        initProductHeroSlider();
      }
    })();
  </script>
{%- endif -%}
